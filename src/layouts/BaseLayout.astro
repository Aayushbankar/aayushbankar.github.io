---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import DossierRail from '../components/DossierRail.astro';
import CommandPalette from '../components/CommandPalette.astro';
import VaultAirlock from '../components/VaultAirlock.astro';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'Aayush Bankar — Systems Security & Low-Level Engineering',
  description = 'Systems security research, Linux kernel & Android vulnerabilities, and high-performance verifiable architectures.',
  image = '/assets/hero.svg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Aayush Bankar" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site)} />

    <!-- Alternate RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="Aayush Bankar Research Feed" href="/rss.xml" />
    <ClientRouter />

    <!-- Design system type: Fraunces (display) + Inter (body) + JetBrains Mono (micro) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body id="top" class="min-h-screen flex flex-col bg-ink-950 text-bone-50 font-sans selection:bg-ember-500 selection:text-ink-950">
    <!-- Ambient warm glow (design system: body carries the gradient; this stays subtle) -->
    <div class="fixed inset-0 pointer-events-none z-[-1] opacity-40">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[700px] h-[320px] bg-ember-500/[0.05] blur-[130px] rounded-full"></div>
    </div>

    <Navbar />

    <DossierRail />

    <CommandPalette />

    <VaultAirlock />

    <main class="flex-1 w-full lg:pl-36 xl:pl-40 2xl:pl-32 pb-24 lg:pb-12 pt-16 sm:pt-20">
      <slot />
    </main>

    <Footer />

    <script src="../scripts/dossier.js"></script>

    <!-- Live IST clock (progressive enhancement for [data-ist-clock] nodes) -->
    <script is:inline>
      (function () {
        function tick() {
          try {
            var t = new Intl.DateTimeFormat('en-IN', {
              hour: '2-digit',
              minute: '2-digit',
              hour12: true,
              timeZone: 'Asia/Kolkata',
            }).format(new Date());
            document.querySelectorAll('[data-ist-clock]').forEach(function (el) {
              el.textContent = t + ' IST';
            });
          } catch (e) {}
        }
        tick();
        setInterval(tick, 30000);
        document.addEventListener('astro:after-swap', tick);
      })();
    </script>
  </body>
</html>
