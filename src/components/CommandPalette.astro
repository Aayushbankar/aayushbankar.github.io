---
/* Awwwards-caliber Command Palette (Cmd+K / Ctrl+K)
   Instant keyboard search across all dossier documents, systems, research CVEs, and quick actions.
   Progressive enhancement: 100% accessible with focus trap and ARIA combobox pattern. */
---

<div
  id="cmdk-backdrop"
  class="cmdk-backdrop hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Dossier Command Palette"
>
  <div class="cmdk-modal" id="cmdk-container">
    <!-- Search Input Header -->
    <div class="cmdk-header">
      <span class="cmdk-prompt-symbol">&gt;</span>
      <input
        type="text"
        id="cmdk-input"
        class="cmdk-input"
        placeholder="Type a command or search dossier, systems, CVEs..."
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="cmdk-esc-badge" id="cmdk-close-btn" title="Press Esc to close">ESC</kbd>
    </div>

    <!-- Live Filterable Results List -->
    <div class="cmdk-list" id="cmdk-results" role="listbox">
      <!-- Section: Dossier Documents -->
      <div class="cmdk-group-title">Dossier Documents</div>
      <a href="/" class="cmdk-item" role="option" data-keywords="home index ds01 bugs systems notes connect">
        <span class="cmdk-item-badge">DS:01</span>
