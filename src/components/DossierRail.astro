---
interface RailSection {
  id: string;
  num: string;
  label: string;
}

interface PageConfig {
  code: string;
  pageNum: string;
  pageName: string;
  href: string;
  sections: RailSection[];
}

const allPages: PageConfig[] = [
  {
    code: 'DS:01',
    pageNum: '01',
    pageName: 'Home',
    href: '/',
    sections: [
      { id: 'breakthroughs', num: '01', label: 'Bugs' },
      { id: 'systems', num: '02', label: 'Systems' },
      { id: 'notes', num: '03', label: 'Notes' },
      { id: 'connect', num: '04', label: 'Connect' },
    ],
  },
  {
    code: 'DS:02',
    pageNum: '02',
    pageName: 'Systems',
    href: '/systems',
    sections: [
      { id: 'telemetry', num: '01', label: 'Console' },
      { id: 'domains', num: '02', label: 'Domains' },
      { id: 'catalog', num: '03', label: 'Catalog' },
      { id: 'benchmarks', num: '04', label: 'Metrics' },
    ],
  },
  {
    code: 'DS:03',
    pageNum: '03',
    pageName: 'Research',
    href: '/research',
    sections: [
      { id: 'testbench', num: '01', label: 'Harness' },
      { id: 'disclosures', num: '02', label: 'CVEs' },
      { id: 'engine', num: '03', label: 'Engine' },
      { id: 'methodology', num: '04', label: 'Methods' },
    ],
  },
  {
    code: 'DS:04',
    pageNum: '04',
    pageName: 'About',
    href: '/about',
    sections: [
      { id: 'profile', num: '01', label: 'Profile' },
      { id: 'hardware', num: '02', label: 'Hardware' },
      { id: 'creds', num: '03', label: 'Creds' },
      { id: 'ethos', num: '04', label: 'Ethos' },
    ],
  },
  {
    code: 'DS:05',
    pageNum: '05',
    pageName: 'Trajectory',
    href: '/trajectory',
    sections: [
      { id: 'milestones', num: '01', label: 'Timeline' },
      { id: 'tech-evolution', num: '02', label: 'Stack' },
      { id: 'decisions', num: '03', label: 'Decisions' },
    ],
  },
  {
    code: 'DS:06',
    pageNum: '06',
    pageName: 'Contact',
    href: '/contact',
    sections: [
      { id: 'channels', num: '01', label: 'Channels' },
      { id: 'pgp', num: '02', label: 'PGP Key' },
      { id: 'scope', num: '03', label: 'Scope' },
    ],
  },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

let currentPage: PageConfig;

if (pathname === '/') {
  currentPage = allPages[0];
} else if (pathname === '/systems') {
  currentPage = allPages[1];
} else if (pathname.startsWith('/systems/')) {
  currentPage = {
    code: 'DS:SYS',
    pageNum: '02',
    pageName: 'Spec',
    href: pathname,
    sections: [
      { id: 'specs', num: '01', label: 'Specs' },
      { id: 'architecture', num: '02', label: 'Arch' },
      { id: 'benchmarks', num: '03', label: 'Verify' },
    ],
  };
} else if (pathname === '/research') {
  currentPage = allPages[2];
} else if (pathname.startsWith('/research/')) {
  currentPage = {
    code: 'DS:RES',
    pageNum: '03',
    pageName: 'Paper',
    href: pathname,
    sections: [
      { id: 'overview', num: '01', label: 'Overview' },
      { id: 'analysis', num: '02', label: 'Analysis' },
      { id: 'defense', num: '03', label: 'Defense' },
    ],
  };
} else if (pathname === '/about') {
  currentPage = allPages[3];
} else if (pathname === '/trajectory') {
  currentPage = allPages[4];
} else if (pathname === '/contact') {
  currentPage = allPages[5];
} else {
  currentPage = allPages[0];
}
---

<!-- Desktop Sticky Dossier Rail Dock (Fixed Left Bar) -->
<aside class="dossier-rail-dock" aria-label="Dossier Document and Section Navigation">
  <!-- Active Page Pill & Switcher: Always shows current page + dynamic active section -->
  <div
    class="dossier-page-pill"
    id="dossier-page-trigger"
    tabindex="0"
    role="button"
    aria-haspopup="true"
    aria-expanded="false"
    aria-label={`Current document: ${currentPage.pageName}. Click to open document index.`}
    title="Click to open Document Index"
  >
    <div class="dossier-pill-header">
      <span class="dossier-led"></span>
      <span class="dossier-page-code">{currentPage.code}</span>
      <span class="dossier-page-title">{currentPage.pageName}</span>
      <svg class="dossier-page-chevron" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
      </svg>
    </div>

    <!-- Dynamic Section Readout: updates as visitor scrolls through different sections -->
    <div class="dossier-pill-sub" id="dossier-active-sec-readout">
      <span class="dossier-sub-dot"></span>
      <span id="dossier-active-sec-name">{currentPage.sections[0].num} {currentPage.sections[0].label}</span>
    </div>

    <!-- Page Switcher Flyout Directory -->
    <div class="dossier-page-flyout" id="dossier-page-menu" role="menu">
      <div class="dossier-flyout-header">
        <span>Dossier Directory ({allPages.length} Documents)</span>
      </div>
      {allPages.map((p) => {
        const isCurrent = p.code === currentPage.code;
        return (
          <a
            href={p.href}
            class={`dossier-flyout-item ${isCurrent ? 'active' : ''}`}
            role="menuitem"
          >
            <span class="flyout-num">{p.pageNum}</span>
            <span class="flyout-name">{p.pageName}</span>
            {isCurrent && <span class="flyout-curr-dot"></span>}
          </a>
        );
      })}
    </div>
  </div>

  <div class="dossier-rail-divider"></div>

  <!-- Pinned Section Anchors Navigation Rail -->
  <nav class="dossier-rail" aria-label="Dossier section navigation">
    <div class="dossier-rail-spine" aria-hidden="true">
      <div class="dossier-rail-progress" id="dossier-progress-line"></div>
    </div>
    {currentPage.sections.map((sec, idx) => (
      <a
        href={`#${sec.id}`}
        aria-label={`Jump to section ${sec.num} ${sec.label}`}
        class={idx === 0 ? 'active' : ''}
        data-section-id={sec.id}
        data-section-label={`${sec.num} ${sec.label}`}
      >
        <span class="dot"></span>
        <span>{sec.num}</span>
        <span class="rail-label">{sec.label}</span>
      </a>
    ))}
  </nav>

  <div class="dossier-rail-divider"></div>

  <!-- Utility Controls: Command Palette (⌘K) + Navigation Guide (?) + Audio SFX Toggle + Back to Top -->
  <div class="dossier-rail-actions">
    <button
      type="button"
      class="dossier-action-btn"
      id="dossier-cmdk-trigger"
      aria-label="Open Command Palette (Cmd+K)"
      title="Search dossier (⌘K)"
    >
      <span class="font-micro text-[10px] font-bold text-bone-300">⌘K</span>
      <span class="rail-action-tooltip">Search (⌘K)</span>
    </button>

    <button
      type="button"
      class="dossier-action-btn"
      id="dossier-guide-btn"
      aria-label="How to Navigate the Dossier (?)"
      title="Site Navigation Guide (?)"
    >
      <span class="font-micro text-[10px] font-bold text-brass-400">?</span>
      <span class="rail-action-tooltip">Guide (?)</span>
    </button>

    <button
      type="button"
      class="dossier-action-btn"
      id="dossier-sound-toggle"
      aria-label="Toggle Cybernetic Audio Synthesizer"
      title="Audio FX: Off"
      aria-pressed="false"
    >
      <span class="font-micro text-[9px] font-bold text-bone-400" id="sound-label">SFX</span>
      <span class="rail-action-tooltip">Audio FX</span>
    </button>

    <button
      type="button"
      class="dossier-top-btn"
      id="dossier-scroll-top"
      aria-label="Scroll back to top of document"
      title="Back to top"
    >
      <svg class="dossier-top-icon" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M14.77 12.79a.75.75 0 01-1.06-.02L10 8.832 6.29 12.77a.75.75 0 11-1.08-1.04l4.25-4.5a.75.75 0 011.08 0l4.25 4.5a.75.75 0 01-.02 1.06z" clip-rule="evenodd" />
      </svg>
      <span class="dossier-depth-readout" id="dossier-depth-val">0%</span>
      <span class="rail-action-tooltip">Top ↑</span>
    </button>
  </div>
</aside>

<!-- Mobile Docked Cyber-Deck Command Bar (Responsive Ergonomic Bottom Dock) -->
<nav class="dossier-rail-mobile" aria-label="Mobile dossier navigation command deck">
  <!-- Document Drawer Trigger -->
  <button
    type="button"
    id="dossier-mobile-page-trigger"
    class="dossier-mobile-page cursor-pointer bg-transparent border-0 p-0 text-left flex items-center gap-1.5 shrink-0"
    title="Tap to open full document index"
    aria-label={`Current document: ${currentPage.pageName}. Tap to open document index.`}
  >
    <span class="dossier-mobile-led"></span>
    <span class="font-bold">{currentPage.code}</span>
    <span class="hidden xs:inline text-[9px] text-bone-400 uppercase tracking-wider">{currentPage.pageName}</span>
  </button>

  <span class="dossier-mobile-sep">|</span>

  <!-- Dynamic Section Scrubber with ◀ and ▶ Thumb Buttons -->
  <div class="dossier-mobile-sections flex items-center gap-1 overflow-hidden">
    <button
      type="button"
      id="dossier-mobile-prev-sec"
      class="dossier-mobile-nav-arrow p-1 text-bone-400 hover:text-ember-400 font-bold cursor-pointer bg-transparent border-0 font-micro text-[11px]"
      title="Previous section"
      aria-label="Previous section"
    >
      ◀
    </button>
    
    <div class="dossier-mobile-sec-badge px-2 py-0.5 rounded-full bg-bone-50/10 border border-bone-50/15 text-[10px] text-bone-200 font-micro font-semibold whitespace-nowrap truncate max-w-[120px] sm:max-w-none">
      <span id="dossier-mobile-active-sec-text">{currentPage.sections[0].num} {currentPage.sections[0].label}</span>
    </div>

    <button
      type="button"
      id="dossier-mobile-next-sec"
      class="dossier-mobile-nav-arrow p-1 text-bone-400 hover:text-ember-400 font-bold cursor-pointer bg-transparent border-0 font-micro text-[11px]"
      title="Next section"
      aria-label="Next section"
    >
      ▶
    </button>
  </div>

  <span class="dossier-mobile-sep">|</span>

  <!-- Quick Command Palette ⌘K -->
  <button
    type="button"
    id="dossier-mobile-cmdk-btn"
    class="dossier-mobile-link !px-1.5 text-bone-300 hover:text-ember-400 font-bold cursor-pointer bg-transparent border-0 font-micro text-[10px]"
    title="Search dossier (⌘K)"
    aria-label="Search dossier"
  >
    ⌘K
  </button>

  <!-- Navigation Guide (?) -->
  <button
    type="button"
    id="dossier-mobile-guide-btn"
    class="dossier-mobile-link !px-1.5 text-brass-400 font-bold cursor-pointer bg-transparent border-0 font-micro text-xs"
    title="Navigation Guide"
    aria-label="Open Navigation Guide"
  >
    ?
  </button>

  <!-- Back to Top (↑) -->
  <button
    type="button"
    id="dossier-mobile-top-btn"
    class="dossier-mobile-link !px-1.5 text-bone-400 hover:text-bone-100 font-bold cursor-pointer bg-transparent border-0 font-micro text-xs"
    title="Back to Top"
    aria-label="Scroll to top"
  >
    ↑
  </button>
</nav>

<!-- Navigation Guidance Modal Dialog (PC & Mobile) -->
<div
  id="dossier-guide-modal"
  class="fixed inset-0 z-50 bg-ink-950/85 backdrop-blur-xl flex items-center justify-center p-4 hidden opacity-0 transition-opacity duration-200 pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="guide-modal-title"
>
  <div class="w-full max-w-xl rounded-2xl bg-ink-900 border border-bone-50/20 p-6 sm:p-7 shadow-2xl relative pointer-events-auto max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between pb-3 border-b border-bone-50/10 mb-4">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-brass-400"></span>
        <h3 id="guide-modal-title" class="font-display font-semibold text-lg text-bone-50">
          Dossier Navigation &amp; Telemetry Guide
        </h3>
      </div>
      <button
        type="button"
        id="guide-modal-close"
        class="p-1.5 rounded-full bg-ink-950 text-bone-400 hover:text-bone-50 cursor-pointer"
        aria-label="Close navigation guide"
      >
        ✕
      </button>
    </div>

    <p class="text-xs sm:text-sm text-bone-300 mb-4 leading-relaxed">
      This site is formatted as an archival engineering dossier. Here is how to navigate all research notes, systems, and telemetry across PC and mobile:
    </p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
      <div class="p-3.5 rounded-xl bg-ink-950 border border-bone-50/10">
        <span class="font-micro text-[10px] text-ember-400 font-bold uppercase tracking-wider block mb-1">01 / Persistent Top Dock</span>
        <p class="text-bone-400 leading-relaxed">
          The floating pill navbar stays visible across all pages at any scroll depth. Use it to navigate between all 6 core documents (01 Dossier to 06 Contact).
        </p>
      </div>

      <div class="p-3.5 rounded-xl bg-ink-950 border border-bone-50/10">
        <span class="font-micro text-[10px] text-brass-400 font-bold uppercase tracking-wider block mb-1">02 / Left Dossier Rail &amp; HUD</span>
        <p class="text-bone-400 leading-relaxed">
          On desktop, the left rail tracks your active section and scroll depth. Click any numbered dot to jump directly; on mobile, use the bottom dock to hop sections.
        </p>
      </div>

      <div class="p-3.5 rounded-xl bg-ink-950 border border-bone-50/10">
        <span class="font-micro text-[10px] text-moss-400 font-bold uppercase tracking-wider block mb-1">03 / Command Palette (⌘K)</span>
        <p class="text-bone-400 leading-relaxed">
          Press <kbd class="font-micro px-1 py-0.5 rounded bg-ink-900 border border-bone-50/20 text-bone-200">⌘K</kbd> or <kbd class="font-micro px-1 py-0.5 rounded bg-ink-900 border border-bone-50/20 text-bone-200">/</kbd> anywhere to search all 10 systems, CVE disclosures, whitepapers, and PGP keys.
        </p>
      </div>

      <div class="p-3.5 rounded-xl bg-ink-950 border border-bone-50/10">
        <span class="font-micro text-[10px] text-bone-300 font-bold uppercase tracking-wider block mb-1">04 / Tactical Audio (SFX)</span>
        <p class="text-bone-400 leading-relaxed">
          Click the SFX toggle on the left rail or Command Palette to enable generative Web Audio telemetry sounds while navigating.
        </p>
      </div>
    </div>

    <!-- Keyboard Shortcuts Matrix -->
    <div class="mt-4 p-3.5 rounded-xl bg-ink-950/80 border border-bone-50/10">
      <span class="font-micro text-[10px] text-bone-400 font-bold uppercase tracking-wider block mb-2">Keyboard Shortcuts:</span>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-[11px] font-micro">
        <div class="flex items-center gap-1.5 text-bone-300">
          <kbd class="px-1.5 py-0.5 rounded bg-ink-900 border border-bone-50/15 text-bone-200 font-semibold">⌘K</kbd>
          <span class="text-bone-400">Search</span>
        </div>
        <div class="flex items-center gap-1.5 text-bone-300">
          <kbd class="px-1.5 py-0.5 rounded bg-ink-900 border border-bone-50/15 text-bone-200 font-semibold">?</kbd>
          <span class="text-bone-400">Guide</span>
        </div>
        <div class="flex items-center gap-1.5 text-bone-300">
          <kbd class="px-1.5 py-0.5 rounded bg-ink-900 border border-bone-50/15 text-bone-200 font-semibold">Esc</kbd>
          <span class="text-bone-400">Close</span>
        </div>
        <div class="flex items-center gap-1.5 text-bone-300">
          <kbd class="px-1.5 py-0.5 rounded bg-ink-900 border border-bone-50/15 text-bone-200 font-semibold">↑/↓</kbd>
          <span class="text-bone-400">Select</span>
        </div>
      </div>
    </div>

    <div class="mt-4 pt-3.5 border-t border-bone-50/10 flex flex-wrap items-center justify-between gap-2 font-micro text-[11px] text-bone-500">
      <span>Tip: Press <kbd class="text-bone-300 font-bold">?</kbd> anytime to open this guide</span>
      <button
        type="button"
        id="guide-modal-ack"
        class="btn btn-primary !text-xs !py-1.5 !px-3.5 cursor-pointer"
      >
        Understood ↵
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    function setupGuide() {
      var guideBtn = document.getElementById('dossier-guide-btn');
      var mobileGuideBtn = document.getElementById('dossier-mobile-guide-btn');
      var mobilePageTrigger = document.getElementById('dossier-mobile-page-trigger');
      var modal = document.getElementById('dossier-guide-modal');
      var closeBtn = document.getElementById('guide-modal-close');
      var ackBtn = document.getElementById('guide-modal-ack');

      if (!modal) return;

      function openGuide() {
        modal.classList.remove('hidden', 'pointer-events-none');
        requestAnimationFrame(function () {
          modal.classList.add('opacity-100');
        });
      }

      function closeGuide() {
        modal.classList.remove('opacity-100');
        setTimeout(function () {
          modal.classList.add('hidden', 'pointer-events-none');
        }, 200);
      }

      if (guideBtn) guideBtn.onclick = openGuide;
      if (mobileGuideBtn) mobileGuideBtn.onclick = openGuide;
      if (closeBtn) closeBtn.onclick = closeGuide;
      if (ackBtn) ackBtn.onclick = closeGuide;

      modal.onclick = function (e) {
        if (e.target === modal) closeGuide();
      };

      // Tapping mobile page trigger opens mobile nav drawer
      if (mobilePageTrigger) {
        mobilePageTrigger.onclick = function () {
          if (typeof window.__openMobileNavDrawer === 'function') {
            window.__openMobileNavDrawer();
          }
        };
      }

      // Keyboard shortcut: '?' (Shift + /) - ensure single listener
      if (!window.__guideKeyboardBound) {
        window.__guideKeyboardBound = true;
        window.addEventListener('keydown', function (e) {
          var isInput = ['INPUT', 'TEXTAREA'].includes(document.activeElement && document.activeElement.tagName);
          var activeModal = document.getElementById('dossier-guide-modal');
          if (!activeModal) return;

          if (e.key === '?' && !isInput) {
            e.preventDefault();
            if (activeModal.classList.contains('hidden')) {
              activeModal.classList.remove('hidden', 'pointer-events-none');
              requestAnimationFrame(function () {
                activeModal.classList.add('opacity-100');
              });
            } else {
              activeModal.classList.remove('opacity-100');
              setTimeout(function () {
                activeModal.classList.add('hidden', 'pointer-events-none');
              }, 200);
            }
          } else if (e.key === 'Escape' && !activeModal.classList.contains('hidden')) {
            activeModal.classList.remove('opacity-100');
            setTimeout(function () {
              activeModal.classList.add('hidden', 'pointer-events-none');
            }, 200);
          }
        });
      }
    }

    setupGuide();
    document.addEventListener('astro:page-load', setupGuide);
  })();
</script>
