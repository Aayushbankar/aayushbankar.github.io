---
import { careerTimeline } from '../../data/timeline';
import ObsidianTechGraph from '../ObsidianTechGraph.astro';

const tracks = [
  { id: 'all', label: 'All Dimensions', count: careerTimeline.length },
  { id: 'production', label: 'Campus & Production Web', count: careerTimeline.filter(m => m.track === 'production').length },
  { id: 'security', label: 'Security & Vulnerability Research', count: careerTimeline.filter(m => m.track === 'security').length },
  { id: 'systems', label: 'High-Throughput & Autonomous Systems', count: careerTimeline.filter(m => m.track === 'systems').length },
];

// Era grouping for concurrent multi-track matrix
const eras = [
  {
    era: '2024',
    title: 'Foundations & Web Protocol Basics',
    desc: 'Hands-on frontend modules, client-server data flows, and DOM rendering edge cases.',
    milestones: careerTimeline.filter(m => m.year === '2024'),
  },
  {
    era: '2025',
    title: 'Campus Scale & Kernel Instrumentation',
    desc: 'Architecting IT department portal for 500+ daily peers while instrumenting eBPF syscall telemetry.',
    milestones: careerTimeline.filter(m => m.year === '2025'),
  },
  {
    era: '2026',
    title: 'Kernel Root Research & Ongoing Collaboration',
    desc: 'Reproducing local root under retpoline on Linux 6.12.67; porting race conditions to Android GKI 6.1.',
    milestones: careerTimeline.filter(m => m.year === '2026'),
  },
  {
    era: '2026+',
    title: 'National Screening & Lateral B.E. Entry',
    desc: 'SIH 2026 screening candidate with 13,247 EPS/core SPECTRE-PRISM engine while preparing for B.E.',
    milestones: careerTimeline.filter(m => m.year === '2026+'),
  },
];
---

<section id="trajectory" class="w-full mt-20 sm:mt-32 mb-20 sm:mb-28">
  <div class="wrap-wide">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12" data-reveal>
      <div>
        <p class="eyebrow mb-2">
          <span class="tick">TRJ–01</span>
          <span>Multi-Dimensional Progression &amp; Knowledge Graph</span>
        </p>
        <h2 class="display text-3xl sm:text-4xl lg:text-5xl text-bone-50 leading-[1.08]">
          The Engineering <em class="text-ember-400">Trajectory.</em>
        </h2>
        <p class="lede mt-3 max-w-2xl text-sm sm:text-base text-bone-400">
          From first-principles web protocols to kernel vulnerability research, high-throughput systems, and an interactive Obsidian knowledge graph.
        </p>
      </div>

      <!-- Mode switch tabs + Subpage link -->
      <div class="flex flex-wrap items-center gap-3">
        <div class="flex items-center gap-1.5 p-1 rounded-full bg-ink-950 border border-bone-50/10 font-micro text-[11px] shrink-0" role="tablist">
          <button
            type="button"
            class="px-4 py-2 rounded-full font-semibold transition-all bg-bone-50/10 text-ember-400 cursor-pointer flex items-center gap-1.5"
            id="tab-btn-career"
            role="tab"
            aria-selected="true"
          >
            <span>01 / Career Trajectory</span>
          </button>
          <button
            type="button"
            class="px-4 py-2 rounded-full font-semibold transition-all text-bone-400 hover:text-bone-50 cursor-pointer flex items-center gap-1.5"
            id="tab-btn-tech"
            role="tab"
            aria-selected="false"
          >
            <span>02 / Obsidian Tech Graph</span>
          </button>
        </div>

        <a href="/trajectory" class="chip chip-brass !text-[11px] !py-1.5 !px-3 font-semibold hover:border-ember-400 transition-colors">
          Dedicated Roadmap Page ↗
        </a>
      </div>
    </div>

    <!-- PANEL 1: MULTI-DIMENSIONAL CAREER TRAJECTORY -->
    <div id="panel-career" class="space-y-8 transition-opacity duration-300">
      <!-- Trajectory Controls: Track Filters & Matrix vs Radar Toggle -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-2xl bg-ink-900/60 border border-bone-50/10">
        <!-- Track Filter Buttons -->
        <div class="flex flex-wrap items-center gap-1.5" id="timeline-track-filters">
          {tracks.map((t) => (
            <button
              type="button"
              class:list={[
                'timeline-track-btn font-micro text-[11px] px-3 py-1.5 rounded-full transition-all cursor-pointer font-medium',
                t.id === 'all'
                  ? 'bg-bone-50/10 text-bone-50 border border-bone-50/20 active'
                  : 'bg-ink-950/70 text-bone-400 border border-bone-50/5 hover:text-bone-100 hover:border-bone-50/15',
              ]}
              data-track={t.id}
            >
              <span>{t.label}</span>
              <span class="text-bone-500 text-[10px]">({t.count})</span>
            </button>
          ))}
        </div>

        <!-- Mode Toggle: Concurrent Matrix vs Detailed Radar -->
        <div class="flex items-center p-1 rounded-full bg-ink-950 border border-bone-50/10 font-micro text-xs shrink-0">
          <button
            type="button"
            id="btn-timeline-matrix"
            class="px-3 py-1 rounded-full font-semibold transition-all bg-bone-50/10 text-ember-400 cursor-pointer"
          >
            Concurrent Matrix
          </button>
          <button
            type="button"
            id="btn-timeline-radar"
            class="px-3 py-1 rounded-full font-semibold transition-all text-bone-400 hover:text-bone-50 cursor-pointer"
          >
            Chronological Radar
          </button>
        </div>
      </div>

      <!-- VIEW A: CONCURRENT MULTI-TRACK MATRIX (Shows parallel tracks across eras) -->
      <div id="timeline-matrix-view" class="space-y-8">
        {eras.map((era) => (
          <div class="timeline-era-container p-6 sm:p-8 rounded-3xl bg-ink-900/40 border border-bone-50/10 relative overflow-hidden transition-all" data-era={era.era}>
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pb-4 mb-6 border-b border-bone-50/10">
              <div class="flex items-center gap-3">
                <span class="font-display text-2xl sm:text-3xl font-bold text-ember-400">{era.era}</span>
                <div>
                  <h3 class="font-display text-base sm:text-lg text-bone-50 font-semibold">{era.title}</h3>
                  <p class="text-xs text-bone-400">{era.desc}</p>
                </div>
              </div>
              <span class="chip chip-brass !text-[10px] self-start md:self-auto">{era.milestones.length} Concurrent Milestones</span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
              {era.milestones.map((item) => (
                <div
                  class:list={[
                    'timeline-matrix-card card card-glare p-5 sm:p-6 flex flex-col justify-between border-t-2 bg-ink-950/80 transition-all',
                    item.track === 'security' ? 'border-t-ember-500' : item.track === 'systems' ? 'border-t-brass-500' : 'border-t-moss-500',
                  ]}
                  data-card-track={item.track}
                >
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-3">
                      <span class:list={[
                        'chip !text-[9px] !py-0.5 !px-2',
                        item.track === 'security' ? 'chip-ember' : item.track === 'systems' ? 'chip-brass' : 'chip-moss',
                      ]}>
                        {item.trackLabel}
                      </span>
                      <span class="font-micro text-[10px] text-bone-400 font-semibold">{item.period}</span>
                    </div>

                    <h4 class="display text-base sm:text-lg text-bone-50 font-semibold mb-1">{item.title}</h4>
                    <p class="font-micro text-[11px] text-brass-400 font-medium mb-2.5">
                      {item.organization} · <span class="text-bone-400">{item.role}</span>
                    </p>

                    <p class="text-xs text-bone-300 leading-relaxed mb-4">{item.summary}</p>

                    <!-- Quantifiable Metric Badge -->
                    <div class="p-2.5 rounded-xl bg-ink-900 border border-bone-50/10 mb-3 flex items-center justify-between">
                      <span class="font-micro text-[10px] text-bone-500 uppercase tracking-wider">{item.metric.label}</span>
                      <span class="font-display text-sm text-ember-400 font-bold">{item.metric.value}</span>
                    </div>

                    <!-- Retrospective Engineering Note -->
                    <div class="p-3 rounded-xl bg-ink-900/60 border border-bone-50/5 mb-3 text-[11px] text-bone-400 italic leading-relaxed">
                      <span class="text-bone-500 font-micro not-italic text-[10px] uppercase tracking-wider block mb-0.5">Lesson / Takeaway:</span>
                      "{item.retrospective}"
                    </div>
                  </div>

                  <div class="mt-3 pt-3 border-t border-bone-50/10 flex flex-wrap gap-1">
                    {item.tags.map((t) => (
                      <span class="chip !text-[9px] !py-0.5 !px-1.5 bg-ink-950 border-bone-50/10 text-bone-400">{t}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

      <!-- VIEW B: CHRONOLOGICAL RADAR (Filterable Detailed Timeline Cards) -->
      <div id="timeline-radar-view" class="hidden relative pl-6 sm:pl-10 before:absolute before:inset-0 before:left-3 sm:before:left-4 before:w-px before:bg-gradient-to-b before:from-ember-500 before:via-brass-500/50 before:to-bone-50/10 space-y-8">
        {careerTimeline.map((item, idx) => (
          <div class="relative group timeline-radar-card" data-card-track={item.track}>
            <!-- Timeline node pin -->
            <span class="absolute -left-6 sm:-left-10 top-2 w-7 h-7 rounded-full bg-ink-950 border-2 border-ember-500/80 group-hover:border-ember-400 group-hover:scale-110 transition-all flex items-center justify-center font-micro text-[10px] text-ember-400 font-bold z-10 shadow-[0_0_12px_rgba(255,77,28,0.4)]">
              0{idx + 1}
            </span>

            <div class="card card-glare p-6 sm:p-8 hover:border-bone-50/20 transition-all">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
                <div class="flex flex-wrap items-center gap-2.5">
                  <span class="chip chip-ember !text-[10px] !py-0.5 !px-2.5">{item.year}</span>
                  <span class="font-micro text-xs text-bone-400">{item.period}</span>
                  <span class="text-bone-600">·</span>
                  <span class="font-micro text-xs font-semibold text-brass-400">{item.organization}</span>
                  <span class="chip !text-[9px] !py-0.2 !px-2 bg-ink-950 text-bone-400">{item.trackLabel}</span>
                </div>
                <span class="chip !text-[10px] !py-0.5 !px-2 text-bone-400">{item.role}</span>
              </div>

              <h3 class="display text-xl sm:text-2xl text-bone-50 group-hover:text-ember-300 transition-colors">
                {item.title}
              </h3>

              <p class="text-sm sm:text-[15px] text-bone-300 leading-relaxed mt-2.5 max-w-3xl">
                {item.summary}
              </p>

              <!-- Empirical Metric & Retrospective Strip -->
              <div class="grid grid-cols-1 md:grid-cols-12 gap-3 mt-4 pt-4 border-t border-bone-50/10">
                <div class="md:col-span-4 p-3 rounded-xl bg-ink-950 border border-bone-50/10 flex flex-col justify-center">
                  <span class="font-micro text-[10px] text-bone-500 uppercase tracking-wider">{item.metric.label}</span>
                  <span class="font-display text-lg text-ember-400 font-bold mt-0.5">{item.metric.value}</span>
                </div>
                <div class="md:col-span-8 p-3 rounded-xl bg-ink-950/70 border border-bone-50/10 flex flex-col justify-center">
                  <span class="font-micro text-[10px] text-brass-400 uppercase tracking-wider font-semibold">Engineering Retrospective:</span>
                  <p class="text-xs text-bone-300 mt-1 italic leading-relaxed">"{item.retrospective}"</p>
                </div>
              </div>

              <div class="mt-4 pt-4 border-t border-bone-50/10 grid grid-cols-1 md:grid-cols-2 gap-2 text-xs text-bone-400 font-sans">
                {item.highlights.map((h) => (
                  <div class="flex items-start gap-2">
                    <span class="text-ember-400 font-bold">›</span>
                    <span class="leading-relaxed">{h}</span>
                  </div>
                ))}
              </div>

              <div class="flex flex-wrap gap-1.5 mt-4">
                {item.tags.map((t) => (
                  <span class="chip !text-[9px] !py-0.5 !px-2 bg-ink-950/80 border-bone-50/10 text-bone-400">{t}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- PANEL 2: OBSIDIAN TECH GRAPH (Directly replaces the 4 static cards) -->
    <div id="panel-tech" class="hidden transition-opacity duration-300">
      <ObsidianTechGraph />
    </div>

    <!-- Gateway to dedicated /trajectory page -->
    <div class="mt-12 p-6 sm:p-8 rounded-2xl bg-ink-900/60 border border-bone-50/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <p class="font-display text-lg text-bone-50">Dedicated Trajectory &amp; Architectural Decision Records</p>
        <p class="text-xs text-bone-400 mt-1">Want to review full ADRs (Rust vs C++, Pratt parsers, 8GB floor) and technical evolution?</p>
      </div>
      <a href="/trajectory" class="btn btn-primary shrink-0 !text-xs !py-2.5">
        Open Dedicated Roadmap Page →
      </a>
    </div>
  </div>
</section>

<script is:inline>
  function setupTimelineTabs() {
    const btnCareer = document.getElementById('tab-btn-career');
    const btnTech = document.getElementById('tab-btn-tech');
    const panelCareer = document.getElementById('panel-career');
    const panelTech = document.getElementById('panel-tech');

    if (!btnCareer || !btnTech || !panelCareer || !panelTech) return;

    btnCareer.onclick = () => {
      btnCareer.classList.add('bg-bone-50/10', 'text-ember-400');
      btnCareer.classList.remove('text-bone-400');
      btnCareer.setAttribute('aria-selected', 'true');

      btnTech.classList.remove('bg-bone-50/10', 'text-ember-400');
      btnTech.classList.add('text-bone-400');
      btnTech.setAttribute('aria-selected', 'false');

      panelCareer.classList.remove('hidden');
      panelCareer.style.opacity = '1';
      panelTech.classList.add('hidden');
    };

    btnTech.onclick = () => {
      btnTech.classList.add('bg-bone-50/10', 'text-ember-400');
      btnTech.classList.remove('text-bone-400');
      btnTech.setAttribute('aria-selected', 'true');

      btnCareer.classList.remove('bg-bone-50/10', 'text-ember-400');
      btnCareer.classList.add('text-bone-400');
      btnCareer.setAttribute('aria-selected', 'false');

      panelTech.classList.remove('hidden');
      panelTech.style.opacity = '1';
      panelCareer.classList.add('hidden');

      // Trigger canvas resize if switching into graph tab
      window.dispatchEvent(new Event('resize'));
    };

    // Trajectory Sub-view switcher: Concurrent Matrix vs Chronological Radar
    const btnMatrix = document.getElementById('btn-timeline-matrix');
    const btnRadar = document.getElementById('btn-timeline-radar');
    const matrixView = document.getElementById('timeline-matrix-view');
    const radarView = document.getElementById('timeline-radar-view');

    if (btnMatrix && btnRadar && matrixView && radarView) {
      btnMatrix.onclick = () => {
        btnMatrix.classList.add('bg-bone-50/10', 'text-ember-400');
        btnMatrix.classList.remove('text-bone-400');
        btnRadar.classList.remove('bg-bone-50/10', 'text-ember-400');
        btnRadar.classList.add('text-bone-400');

        matrixView.classList.remove('hidden');
        radarView.classList.add('hidden');
      };

      btnRadar.onclick = () => {
        btnRadar.classList.add('bg-bone-50/10', 'text-ember-400');
        btnRadar.classList.remove('text-bone-400');
        btnMatrix.classList.remove('bg-bone-50/10', 'text-ember-400');
        btnMatrix.classList.add('text-bone-400');

        radarView.classList.remove('hidden');
        matrixView.classList.add('hidden');
      };
    }

    // Track filter buttons
    const trackBtns = document.querySelectorAll('.timeline-track-btn');
    const matrixCards = document.querySelectorAll('.timeline-matrix-card');
    const eraContainers = document.querySelectorAll('.timeline-era-container');
    const radarCards = document.querySelectorAll('.timeline-radar-card');

    function applyTimelineFilter(track) {
      // Filter Matrix view cards
      matrixCards.forEach((card) => {
        const cardTrack = card.getAttribute('data-card-track');
        const match = track === 'all' || cardTrack === track;
        card.style.display = match ? 'flex' : 'none';
      });

      // Filter Era Containers in Matrix view
      eraContainers.forEach((era) => {
        const visible = Array.from(era.querySelectorAll('.timeline-matrix-card')).some((c) => c.style.display !== 'none');
        era.style.display = (track === 'all' || visible) ? 'block' : 'none';
      });

      // Filter Radar view cards
      radarCards.forEach((card) => {
        const cardTrack = card.getAttribute('data-card-track');
        const match = track === 'all' || cardTrack === track;
        card.style.display = match ? 'block' : 'none';
      });
    }

    trackBtns.forEach((btn) => {
      btn.onclick = () => {
        trackBtns.forEach((b) => {
          b.classList.remove('active', 'bg-bone-50/10', 'text-bone-50', 'border-bone-50/20');
          b.classList.add('bg-ink-950/70', 'text-bone-400', 'border-bone-50/5');
        });

        btn.classList.add('active', 'bg-bone-50/10', 'text-bone-50', 'border-bone-50/20');
        btn.classList.remove('bg-ink-950/70', 'text-bone-400', 'border-bone-50/5');

        const selectedTrack = btn.getAttribute('data-track') || 'all';
        applyTimelineFilter(selectedTrack);
      };
    });
  }

  setupTimelineTabs();
  document.addEventListener('astro:page-load', setupTimelineTabs);
</script>
