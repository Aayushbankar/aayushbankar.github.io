---
import { careerTimeline, technicalProgression } from '../../data/timeline';
---

<section id="trajectory" class="w-full mt-20 sm:mt-32 mb-20 sm:mb-28">
  <div class="wrap-wide">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12" data-reveal>
      <div>
        <p class="eyebrow mb-2">
          <span class="tick">TRJ–01</span>
          <span>Career &amp; Technical Evolution</span>
        </p>
        <h2 class="display text-3xl sm:text-4xl lg:text-5xl text-bone-50 leading-[1.08]">
          The Engineering <em class="text-ember-400">Trajectory.</em>
        </h2>
        <p class="lede mt-3 max-w-2xl text-sm sm:text-base text-bone-400">
          From first-principles web protocols to kernel vulnerability research and high-throughput systems.
        </p>
      </div>

      <!-- Mode switch tabs + Subpage link -->
      <div class="flex flex-wrap items-center gap-3">
        <div class="flex items-center gap-1.5 p-1 rounded-full bg-ink-950 border border-bone-50/10 font-micro text-[11px] shrink-0" role="tablist">
          <button
            type="button"
            class="px-4 py-2 rounded-full font-semibold transition-all bg-bone-50/10 text-ember-400 cursor-pointer"
            id="tab-btn-career"
            role="tab"
            aria-selected="true"
          >
            01 / Career Trajectory
          </button>
          <button
            type="button"
            class="px-4 py-2 rounded-full font-semibold transition-all text-bone-400 hover:text-bone-50 cursor-pointer"
            id="tab-btn-tech"
            role="tab"
            aria-selected="false"
          >
            02 / Technical Stack (4 Phases)
          </button>
        </div>

        <a href="/trajectory" class="chip chip-brass !text-[11px] !py-1.5 !px-3 font-semibold hover:border-ember-400 transition-colors">
          Full Roadmap Page ↗
        </a>
      </div>
    </div>

    <!-- Panel 1: Career Timeline -->
    <div id="panel-career" class="space-y-6 transition-opacity duration-300">
      <div class="relative pl-6 sm:pl-8 before:absolute before:inset-0 before:left-3 before:w-px before:bg-gradient-to-b before:from-ember-500 before:via-brass-500/50 before:to-bone-50/10 space-y-8">
        {careerTimeline.map((item, idx) => (
          <div class="relative group">
            <!-- Timeline node pin -->
            <span class="absolute -left-6 sm:-left-8 top-1.5 w-6 h-6 rounded-full bg-ink-950 border-2 border-ember-500/80 group-hover:border-ember-400 group-hover:scale-110 transition-all flex items-center justify-center font-micro text-[9px] text-ember-400 font-bold z-10 shadow-[0_0_12px_rgba(255,77,28,0.4)]">
              {idx + 1}
            </span>

            <div class="card card-glare p-6 sm:p-8 hover:border-bone-50/20 transition-all">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-3">
                <div class="flex flex-wrap items-center gap-2.5">
                  <span class="chip chip-ember !text-[10px] !py-0.5 !px-2.5">{item.year}</span>
                  <span class="font-micro text-xs text-bone-400">{item.period}</span>
                  <span class="text-bone-600">·</span>
                  <span class="font-micro text-xs font-semibold text-brass-400">{item.organization}</span>
                </div>
                <span class="chip !text-[10px] !py-0.5 !px-2 text-bone-400">{item.role}</span>
              </div>

              <h3 class="display text-xl sm:text-2xl text-bone-50 group-hover:text-ember-300 transition-colors">
                {item.title}
              </h3>

              <p class="text-sm sm:text-[15px] text-bone-300 leading-relaxed mt-2.5 max-w-3xl">
                {item.summary}
              </p>

              <div class="mt-4 pt-4 border-t border-bone-50/10 grid grid-cols-1 md:grid-cols-2 gap-2 text-xs text-bone-400 font-sans">
                {item.highlights.map((h) => (
                  <div class="flex items-start gap-2">
                    <span class="text-ember-400 font-bold">›</span>
                    <span class="leading-relaxed">{h}</span>
                  </div>
                ))}
              </div>

              <div class="flex flex-wrap gap-1.5 mt-4">
                {item.tags.map((t) => (
                  <span class="chip !text-[9px] !py-0.5 !px-2 bg-ink-950/80 border-bone-50/10 text-bone-400">{t}</span>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Panel 2: Technical Evolution Stack (No data-reveal conflict) -->
    <div id="panel-tech" class="hidden grid grid-cols-1 md:grid-cols-2 gap-4 transition-opacity duration-300">
      {technicalProgression.map((item) => (
        <div class="card card-glare p-6 sm:p-7 flex flex-col justify-between border-t-2 border-t-brass-500">
          <div>
            <div class="flex items-center justify-between gap-3 mb-3">
              <span class="font-micro text-xs font-bold text-ember-400 tracking-widest">PHASE {item.level}</span>
              <span class="chip chip-brass !text-[9px] !py-0.5 !px-2">PROVEN DEPTH</span>
            </div>
            <h3 class="display text-xl text-bone-50 mb-2">{item.phase}</h3>
            <div class="p-2.5 rounded-lg bg-ink-950 border border-bone-50/10 mb-3">
              <p class="font-micro text-xs text-brass-400 leading-relaxed">{item.skills}</p>
            </div>
            <p class="text-xs sm:text-sm text-bone-300 leading-relaxed">{item.detail}</p>
          </div>
          <div class="mt-5 pt-3 border-t border-bone-50/10 font-micro text-[10px] text-bone-500 uppercase tracking-wider flex items-center justify-between">
            <span>Deterministic Reproduction</span>
            <span class="text-moss-400 font-semibold">✓ 100% Proven</span>
          </div>
        </div>
      ))}
    </div>

    <!-- Gateway to dedicated /trajectory page -->
    <div class="mt-12 p-6 sm:p-8 rounded-2xl bg-ink-900/60 border border-bone-50/10 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <p class="font-display text-lg text-bone-50">Detailed Milestone &amp; Timeline Documentation</p>
        <p class="text-xs text-bone-400 mt-1">Want to review each milestone with full repository links, architecture specs, and academic history?</p>
      </div>
      <a href="/trajectory" class="btn btn-primary shrink-0 !text-xs !py-2.5">
        Open Dedicated Roadmap Page →
      </a>
    </div>
  </div>
</section>

<script is:inline>
  function setupTimelineTabs() {
    const btnCareer = document.getElementById('tab-btn-career');
    const btnTech = document.getElementById('tab-btn-tech');
    const panelCareer = document.getElementById('panel-career');
    const panelTech = document.getElementById('panel-tech');

    if (!btnCareer || !btnTech || !panelCareer || !panelTech) return;

    btnCareer.addEventListener('click', () => {
      btnCareer.classList.add('bg-bone-50/10', 'text-ember-400');
      btnCareer.classList.remove('text-bone-400');
      btnCareer.setAttribute('aria-selected', 'true');

      btnTech.classList.remove('bg-bone-50/10', 'text-ember-400');
      btnTech.classList.add('text-bone-400');
      btnTech.setAttribute('aria-selected', 'false');

      panelCareer.classList.remove('hidden');
      panelCareer.style.opacity = '1';
      panelTech.classList.add('hidden');
    });

    btnTech.addEventListener('click', () => {
      btnTech.classList.add('bg-bone-50/10', 'text-ember-400');
      btnTech.classList.remove('text-bone-400');
      btnTech.setAttribute('aria-selected', 'true');

      btnCareer.classList.remove('bg-bone-50/10', 'text-ember-400');
      btnCareer.classList.add('text-bone-400');
      btnCareer.setAttribute('aria-selected', 'false');

      panelTech.classList.remove('hidden');
      panelTech.style.opacity = '1';
      panelCareer.classList.add('hidden');
    });
  }

  document.addEventListener('astro:page-load', setupTimelineTabs);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupTimelineTabs);
  } else {
    setupTimelineTabs();
  }
</script>
