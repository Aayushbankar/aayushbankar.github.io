---
interface Props {
  class?: string;
  size?: number;
  idPrefix?: string;
}

const { class: className = '', size = 320, idPrefix = 'seal' } = Astro.props;
---

<div class:list={['relative flex items-center justify-center select-none group', className]}>
  <!-- Ambient seal glow -->
  <div class="absolute inset-0 bg-ember-500/10 rounded-full blur-2xl -z-10 group-hover:bg-ember-500/20 transition-all duration-700"></div>

  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 320 320"
    width={size}
    height={size}
    class="w-full max-w-[280px] sm:max-w-[320px] h-auto drop-shadow-[0_12px_36px_rgba(0,0,0,0.65)]"
    role="img"
    aria-label="Aayush Bankar Research Seal - Gandhinagar"
  >
    <defs>
      <!-- Gradients -->
      <radialGradient id={`${idPrefix}-bg`} cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#1c1c18" />
        <stop offset="70%" stop-color="#141412" />
        <stop offset="100%" stop-color="#0c0c0b" />
      </radialGradient>

      <linearGradient id={`${idPrefix}-brass-grad`} x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#e2c582" />
        <stop offset="50%" stop-color="#c8a24b" />
        <stop offset="100%" stop-color="#8c6d28" />
      </linearGradient>

      <linearGradient id={`${idPrefix}-ember-grad`} x1="0%" y1="0%" x2="100%" y2="100%">
        <stop offset="0%" stop-color="#ff7a45" />
        <stop offset="100%" stop-color="#ff4d1c" />
      </linearGradient>

      <!-- Circular text paths -->
      <path
        id={`${idPrefix}-text-path-top`}
        d="M 40,160 A 120,120 0 0,1 280,160"
        fill="none"
      />
      <path
        id={`${idPrefix}-text-path-bottom`}
        d="M 280,160 A 120,120 0 0,1 40,160"
        fill="none"
      />

      <!-- Subtle background grid pattern -->
      <pattern id={`${idPrefix}-grid`} width="16" height="16" patternUnits="userSpaceOnUse">
        <path d="M 16 0 L 0 0 0 16" fill="none" stroke="#ede8dc" stroke-width="0.35" stroke-opacity="0.08" />
      </pattern>
    </defs>

    <!-- Outer Seal Disc -->
    <circle cx="160" cy="160" r="154" fill={`url(#${idPrefix}-bg)`} stroke="#2a2a26" stroke-width="1.5" />
    <circle cx="160" cy="160" r="154" fill={`url(#${idPrefix}-grid)`} />

    <!-- Outer Beaded / Cog Ring -->
    <circle cx="160" cy="160" r="148" fill="none" stroke={`url(#${idPrefix}-brass-grad)`} stroke-width="1.2" stroke-opacity="0.8" />
    <circle
      cx="160"
      cy="160"
      r="144"
      fill="none"
      stroke="#ede8dc"
      stroke-width="1"
      stroke-opacity="0.2"
      stroke-dasharray="2 6"
    />

    <!-- Brass Rivets at Cardinals -->
    <circle cx="160" cy="12" r="2.5" fill="#c8a24b" />
    <circle cx="160" cy="308" r="2.5" fill="#c8a24b" />
    <circle cx="12" cy="160" r="2.5" fill="#c8a24b" />
    <circle cx="308" cy="160" r="2.5" fill="#c8a24b" />

    <!-- Circular Monogram Typography -->
    <text font-family="'JetBrains Mono', monospace" font-size="8.5" letter-spacing="3.2" fill="#a8a29a" text-anchor="middle">
      <textPath href={`#${idPrefix}-text-path-top`} startOffset="50%">
        AAYUSH BANKAR · OFFENSIVE RESEARCH
      </textPath>
    </text>

    <text font-family="'JetBrains Mono', monospace" font-size="8.5" letter-spacing="3.2" fill="#a8a29a" text-anchor="middle">
      <textPath href={`#${idPrefix}-text-path-bottom`} startOffset="50%">
        GANDHINAGAR · 23.2156° N 72.6369° E
      </textPath>
    </text>

    <!-- Inner Framing Circle -->
    <circle cx="160" cy="160" r="98" fill="#141412" stroke="#2a2a26" stroke-width="1" />
    <circle cx="160" cy="160" r="94" fill="none" stroke={`url(#${idPrefix}-brass-grad)`} stroke-width="0.8" stroke-opacity="0.6" stroke-dasharray="4 4" />

    <!-- Center Reticle / Compass Crosshairs -->
    <line x1="160" y1="74" x2="160" y2="86" stroke="#c8a24b" stroke-width="1" stroke-opacity="0.7" />
    <line x1="160" y1="234" x2="160" y2="246" stroke="#c8a24b" stroke-width="1" stroke-opacity="0.7" />
    <line x1="74" y1="160" x2="86" y2="160" stroke="#c8a24b" stroke-width="1" stroke-opacity="0.7" />
    <line x1="234" y1="160" x2="246" y2="160" stroke="#c8a24b" stroke-width="1" stroke-opacity="0.7" />

    <!-- CENTER MONOGRAM: "AB" Display Serif Interlock -->
    <g transform="translate(160, 160)">
      <!-- Backing Shadow of Initials -->
      <text
        x="-32"
        y="24"
        font-family="'Fraunces', serif"
        font-size="78"
        font-weight="700"
        font-style="italic"
        fill="#0c0c0b"
        opacity="0.9"
      >
        A
      </text>

      <!-- Letter 'A' (Primary Bone / White) -->
      <text
        x="-38"
        y="22"
        font-family="'Fraunces', serif"
        font-size="76"
        font-weight="600"
        fill="#ede8dc"
      >
        A
      </text>

      <!-- Letter 'B' (Interlocking Ember/Brass) -->
      <text
        x="6"
        y="26"
        font-family="'Fraunces', serif"
        font-size="74"
        font-weight="600"
        font-style="italic"
        fill={`url(#${idPrefix}-brass-grad)`}
        fill-opacity="0.95"
      >
        B
      </text>

      <!-- Ember Focal Accent Spark -->
      <circle cx="-1" cy="6" r="3.5" fill={`url(#${idPrefix}-ember-grad)`}>
        <animate attributeName="opacity" values="1;0.4;1" dur="2.4s" repeatCount="indefinite" />
      </circle>
    </g>

    <!-- Micro Metadata Badges -->
    <g transform="translate(160, 218)">
      <rect x="-38" y="-9" width="76" height="18" rx="9" fill="#0c0c0b" stroke="#c8a24b" stroke-width="0.8" stroke-opacity="0.8" />
      <text x="0" y="3.5" font-family="'JetBrains Mono', monospace" font-size="8" font-weight="600" fill="#ede8dc" letter-spacing="1.5" text-anchor="middle">
        VERIFIED
      </text>
    </g>
  </svg>
</div>
