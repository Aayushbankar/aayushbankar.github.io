---
/* Floating dock navigation — Awwwards-caliber pill geometry with responsive mobile drawer and live route indicators */
const navItems = [
  { label: 'DOSSIER', href: '/', num: '01' },
  { label: 'SYSTEMS', href: '/systems', num: '02' },
  { label: 'RESEARCH', href: '/research', num: '03' },
  { label: 'ABOUT', href: '/about', num: '04' },
  { label: 'CONTACT', href: '/contact', num: '05' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function isRouteActive(href: string): boolean {
  const cleanHref = href.replace(/\/$/, '') || '/';
  if (cleanHref === '/') {
    return currentPath === '/';
  }
  return currentPath.startsWith(cleanHref);
}

const activeItem = navItems.find((item) => isRouteActive(item.href)) || navItems[0];
---

<header class="sticky top-3 sm:top-5 z-50 w-full px-3 sm:px-6 pointer-events-none">
  <div class="max-w-7xl mx-auto backdrop-blur-xl bg-ink-950/90 border border-bone-50/15 rounded-full px-4 sm:px-6 lg:px-8 py-2 sm:py-2.5 shadow-[0_12px_40px_rgba(0,0,0,0.65)] flex items-center justify-between gap-3 sm:gap-6 pointer-events-auto transition-all">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label="Aayush Bankar Dossier Home">
      <span class="w-2.5 h-2.5 rounded-full bg-ember-500 animate-pulse shadow-[0_0_10px_rgba(255,77,28,0.7)] shrink-0"></span>
      <span class="font-display font-semibold text-sm sm:text-base tracking-wide text-bone-50 group-hover:text-ember-400 transition-colors whitespace-nowrap">
        Aayush Bankar
      </span>
      <span class="hidden 2xl:inline-flex chip !text-[9px] !py-0.5 !px-2 border-bone-50/10 text-bone-500 shrink-0">
        SYS / SEC
      </span>
    </a>

    <!-- Primary Nav (Desktop) -->
    <nav class="hidden md:flex items-center gap-0.5 lg:gap-1 p-1 rounded-full bg-ink-900/60 border border-bone-50/5 shrink-0" aria-label="Main navigation">
      {
        navItems.map((item) => {
          const active = isRouteActive(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                'nav-link font-micro text-[10px] lg:text-[11px] tracking-[0.12em] px-2.5 lg:px-3.5 py-1.5 rounded-full transition-all duration-200 whitespace-nowrap',
                active
                  ? 'bg-bone-50/10 text-ember-400 font-semibold shadow-inner is-active'
                  : 'text-bone-400 hover:text-bone-50 hover:bg-bone-50/5',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              <span class="text-bone-600 mr-1 text-[9px] lg:text-[10px]">{item.num}</span>
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <!-- Right Controls: Locator + GitHub + Mobile Menu Trigger -->
    <div class="flex items-center gap-2 sm:gap-3 shrink-0">
      <div class="hidden xl:flex items-center gap-2 font-micro text-[10px] tracking-[0.14em] text-bone-400 px-3 py-1.5 rounded-full bg-ink-900/60 border border-bone-50/5 whitespace-nowrap" title="Gandhinagar, Gujarat (IST)">
        <span class="w-1.5 h-1.5 rounded-full bg-moss-500"></span>
        <span data-ist-clock>--:-- IST</span>
      </div>

      <a
        href="https://github.com/Aayushbankar"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 btn btn-ghost !py-1 sm:!py-1.5 !px-3 !text-[10px] sm:!text-[11px] !rounded-full shrink-0 whitespace-nowrap"
        aria-label="GitHub Profile"
      >
        <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
        </svg>
        <span>GitHub</span>
        <span class="text-ember-400">↗</span>
      </a>

      <!-- Mobile Menu Toggle Button (Single Dock) -->
      <button
        type="button"
        id="mobile-nav-toggle"
        class="md:hidden flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-ink-900/80 border border-bone-50/15 text-bone-200 hover:text-ember-400 font-micro text-[10px] tracking-wider transition-colors shrink-0 whitespace-nowrap"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
      >
        <span class="text-ember-400 font-semibold">{activeItem.label}</span>
        <svg class="w-3.5 h-3.5 transition-transform shrink-0" id="nav-arrow-icon" viewBox="0 0 20 20" fill="currentColor">
          <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Floating Drawer (Single-Dock Dropdown) -->
  <div
    id="mobile-nav-drawer"
    class="hidden md:hidden mt-2 max-w-sm mx-auto backdrop-blur-2xl bg-ink-950/95 border border-bone-50/15 rounded-2xl p-3 shadow-2xl pointer-events-auto transition-all"
  >
    <div class="space-y-1">
      {
        navItems.map((item) => {
          const active = isRouteActive(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                'flex items-center justify-between px-3 py-2 rounded-xl font-micro text-xs tracking-wider transition-colors',
                active
                  ? 'bg-bone-50/10 text-ember-400 font-semibold'
                  : 'text-bone-300 hover:text-bone-50 hover:bg-bone-50/5',
              ]}
              aria-current={active ? 'page' : undefined}
            >
              <div class="flex items-center gap-2">
                <span class="text-bone-600 text-[10px]">{item.num}</span>
                <span>{item.label}</span>
              </div>
              {active && <span class="w-1.5 h-1.5 rounded-full bg-ember-500"></span>}
            </a>
          );
        })
      }
      <a
        href="https://github.com/Aayushbankar"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between px-3 py-2 rounded-xl font-micro text-xs text-bone-300 hover:text-bone-50 hover:bg-bone-50/5 transition-colors border-t border-bone-50/10 mt-1"
      >
        <div class="flex items-center gap-2">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
          <span>GitHub Profile</span>
        </div>
        <span class="text-ember-400">↗</span>
      </a>
    </div>

    <!-- Mobile Drawer Footer Info -->
    <div class="mt-3 pt-2.5 border-t border-bone-50/10 flex items-center justify-between text-[10px] font-micro text-bone-500 px-2">
      <span class="flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-moss-500"></span>
        <span data-ist-clock>--:-- IST</span>
      </span>
      <span>Gandhinagar, Gujarat</span>
    </div>
  </div>

  <!-- Interactive script for mobile drawer and route sync -->
  <script is:inline>
    (function () {
      function setupNav() {
        var toggle = document.getElementById('mobile-nav-toggle');
        var drawer = document.getElementById('mobile-nav-drawer');
        var icon = document.getElementById('nav-arrow-icon');
        if (!toggle || !drawer) return;

        function closeDrawer() {
          drawer.classList.add('hidden');
          toggle.setAttribute('aria-expanded', 'false');
          if (icon) icon.classList.remove('rotate-180');
        }

        function openDrawer() {
          drawer.classList.remove('hidden');
          toggle.setAttribute('aria-expanded', 'true');
          if (icon) icon.classList.add('rotate-180');
        }

        toggle.onclick = function (e) {
          e.stopPropagation();
          var isHidden = drawer.classList.contains('hidden');
          if (isHidden) {
            openDrawer();
          } else {
            closeDrawer();
          }
        };

        drawer.querySelectorAll('a').forEach(function (a) {
          a.onclick = function () {
            closeDrawer();
          };
        });

        document.addEventListener('click', function (e) {
          if (!drawer.contains(e.target) && !toggle.contains(e.target)) {
            closeDrawer();
          }
        });
      }

      setupNav();
      document.addEventListener('astro:page-load', setupNav);
      document.addEventListener('astro:after-swap', setupNav);
    })();
  </script>
</header>
