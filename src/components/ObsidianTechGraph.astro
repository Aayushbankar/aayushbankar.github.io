---
import { techNodes, techEdges, graphClusters } from '../data/techGraph';

interface Props {
  initialView?: 'graph' | 'grid';
}

const { initialView = 'graph' } = Astro.props;

const clusterList = Object.values(graphClusters);
const isGraphInitial = initialView === 'graph';
---

<div class="w-full obsidian-graph-root" id="obsidian-graph-component">
  <!-- Header & Toolbar -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-2 mb-1.5">
        <span class="w-2 h-2 rounded-full bg-ember-500 animate-pulse"></span>
        <span class="font-micro text-xs uppercase tracking-widest text-ember-400 font-semibold">
          Systems Knowledge &amp; Silicon Architecture
        </span>
      </div>
      <h3 class="display text-2xl sm:text-3xl text-bone-50">
        Connected Skills &amp; <em class="text-ember-400">Silicon Tooling Graph.</em>
      </h3>
      <p class="text-xs sm:text-sm text-bone-400 mt-1 max-w-2xl">
        Interconnected dependency graph mapping {techNodes.length} core technical nodes across silicon tooling, kernel internals, exploit research, high-throughput Rust, offline AI, and web infrastructure.
      </p>
    </div>

    <!-- View Switcher -->
    <div class="flex flex-wrap items-center gap-2">
      <div class="flex items-center p-1 rounded-full bg-ink-950 border border-bone-50/10 font-micro text-xs shrink-0" role="tablist">
        <button
          type="button"
          id="btn-view-graph"
          class={`px-3.5 py-1.5 rounded-full font-semibold transition-all cursor-pointer flex items-center gap-1.5 ${isGraphInitial ? 'bg-bone-50/10 text-ember-400' : 'text-bone-400 hover:text-bone-50'}`}
          role="tab"
          aria-selected={isGraphInitial ? 'true' : 'false'}
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="6" cy="6" r="3" />
            <circle cx="18" cy="18" r="3" />
            <circle cx="18" cy="6" r="3" />
            <circle cx="6" cy="18" r="3" />
            <path d="M8.5 8.5l7 7M15.5 8.5l-7 7" />
          </svg>
          <span>Interactive Graph</span>
        </button>
        <button
          type="button"
          id="btn-view-grid"
          class={`px-3.5 py-1.5 rounded-full font-semibold transition-all cursor-pointer flex items-center gap-1.5 ${!isGraphInitial ? 'bg-bone-50/10 text-ember-400' : 'text-bone-400 hover:text-bone-50'}`}
          role="tab"
          aria-selected={!isGraphInitial ? 'true' : 'false'}
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="14" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" />
          </svg>
          <span>Small Cards Matrix</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Cluster Filter Bar & Search -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-5 p-3 rounded-2xl bg-ink-900/60 border border-bone-50/10">
    <div class="flex flex-wrap items-center gap-1.5" id="cluster-filter-buttons">
      <button
        type="button"
        class="cluster-filter-btn active px-3 py-1 rounded-full font-micro text-[11px] font-semibold transition-all bg-bone-50/10 text-bone-50 border border-bone-50/20 cursor-pointer"
        data-cluster="all"
      >
        All Clusters ({techNodes.length})
      </button>
      {clusterList.map((c) => (
        <button
          type="button"
          class="cluster-filter-btn px-2.5 py-1 rounded-full font-micro text-[10px] sm:text-[11px] font-medium transition-all text-bone-400 hover:text-bone-50 bg-ink-950/70 border border-bone-50/5 hover:border-bone-50/15 cursor-pointer flex items-center gap-1.5"
          data-cluster={c.id}
        >
          <span class="w-2 h-2 rounded-full" style={`background-color: ${c.color};`}></span>
          <span>{c.name}</span>
        </button>
      ))}
    </div>

    <!-- Quick Search Input -->
    <div class="relative w-full md:w-56 shrink-0">
      <input
        type="text"
        id="obsidian-search-input"
        placeholder="Search nodes or tools..."
        class="w-full px-3 py-1.5 pl-8 rounded-full bg-ink-950 border border-bone-50/10 text-xs text-bone-100 placeholder:text-bone-600 focus:outline-none focus:border-ember-400/50 font-micro"
      />
      <svg class="w-3.5 h-3.5 absolute left-2.5 top-2.5 text-bone-500" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
      </svg>
    </div>
  </div>

  <!-- VIEW 3: Bespoke Mobile Silicon Deck (Default on touch screens < 768px) -->
  <div id="mobile-silicon-deck" class={`md:hidden ${isGraphInitial ? 'block' : 'hidden'} space-y-3.5`}>
    <!-- Mobile Cluster Horizontal Filter Ribbon -->
    <div class="flex items-center gap-1.5 overflow-x-auto pb-1.5 no-scrollbar -mx-1 px-1" id="m-cluster-ribbon">
      <button
        type="button"
        class="m-cluster-pill active px-3 py-1 rounded-full font-micro text-[10px] font-semibold transition-all bg-bone-50/10 text-bone-50 border border-bone-50/20 shrink-0 cursor-pointer"
        data-m-cluster="all"
      >
        All ({techNodes.length})
      </button>
      {clusterList.map((c) => (
        <button
          type="button"
          class="m-cluster-pill px-2.5 py-1 rounded-full font-micro text-[10px] font-medium transition-all text-bone-400 hover:text-bone-50 bg-ink-950/80 border border-bone-50/10 shrink-0 cursor-pointer flex items-center gap-1.5"
          data-m-cluster={c.id}
        >
          <span class="w-2 h-2 rounded-full shrink-0" style={`background-color: ${c.color};`}></span>
          <span>{c.name.split(' ')[0]}</span>
        </button>
      ))}
    </div>

    <!-- Active Tactile Node Card with Touch Swipe Gestures -->
    <div
      id="m-node-card"
      class="card card-glare p-4 sm:p-5 rounded-2xl border-t-2 bg-ink-950/95 border-bone-50/15 shadow-2xl relative transition-all duration-300 select-none touch-pan-y"
      style="border-top-color: #ff7a45;"
    >
      <!-- Card Header: Cluster & Level -->
      <div class="flex items-center justify-between gap-2 pb-2.5 mb-2.5 border-b border-bone-50/10">
        <div class="flex items-center gap-1.5 min-w-0">
          <span class="w-2.5 h-2.5 rounded-full shrink-0" id="m-cluster-dot" style="background-color: #ff7a45;"></span>
          <span class="font-micro text-[10px] font-bold uppercase tracking-wider text-ember-400 truncate" id="m-cluster-name">Silicon &amp; Hardware Tooling</span>
        </div>
        <span class="chip chip-brass !text-[8.5px] !py-0.2 !px-2 shrink-0 font-semibold" id="m-node-level">Daily Exploit Tooling</span>
      </div>

      <!-- Node Title -->
      <h4 class="display text-lg sm:text-xl text-bone-50 font-bold mb-1.5 leading-snug" id="m-node-title">
        {techNodes[0].label}
      </h4>

      <!-- Node Summary -->
      <p class="text-xs text-bone-300 leading-relaxed mb-3" id="m-node-summary">
        {techNodes[0].summary}
      </p>

      <!-- Ground Truth Evidence Box -->
      <div class="p-2.5 rounded-xl bg-ink-900/90 border border-bone-50/10 mb-3">
        <div class="flex items-center gap-1 text-moss-400 font-micro text-[9px] uppercase tracking-wider font-semibold mb-0.5">
          <span class="w-1.5 h-1.5 rounded-full bg-moss-400 animate-pulse"></span>
          <span>Verified Rig Proof:</span>
        </div>
        <p class="text-[11px] text-bone-400 leading-relaxed" id="m-node-evidence">
          {techNodes[0].evidence}
        </p>
      </div>

      <!-- Connected Silicon Dependencies -->
      <div class="mb-3">
        <span class="font-micro text-[9px] uppercase tracking-wider text-bone-500 block mb-1.5 font-semibold">
          Connected Silicon Primitives:
        </span>
        <div class="flex flex-wrap gap-1" id="m-node-links">
          <!-- Populated dynamically via JS -->
        </div>
      </div>

      <!-- Artifact Action Link -->
      <div id="m-node-action-wrap">
        <a
          href="#"
          id="m-node-artifact-btn"
          class="btn btn-primary w-full !text-xs !py-2 justify-center flex items-center gap-1.5 hidden shadow-lg"
        >
          <span>Open Research / System Spec</span>
          <span>↗</span>
        </a>
      </div>
    </div>

    <!-- Mobile Deck Navigation Controls (Thumbs Accessible) -->
    <div class="flex items-center justify-between gap-2">
      <button
        type="button"
        id="m-btn-prev"
        class="flex-1 py-2.5 px-3 rounded-xl bg-ink-900/90 border border-bone-50/10 text-bone-200 hover:text-ember-400 font-micro text-[11px] font-semibold flex items-center justify-center gap-1.5 active:scale-95 transition-all cursor-pointer"
        aria-label="Previous Silicon Node"
      >
        <span>◀</span>
        <span>PREV</span>
      </button>

      <div class="px-3 py-2 rounded-xl bg-ink-950 border border-bone-50/10 font-micro text-xs text-bone-300 shrink-0 font-mono">
        <span id="m-node-index">01</span>
        <span class="text-bone-600">/</span>
        <span id="m-node-total">{techNodes.length}</span>
      </div>

      <button
        type="button"
        id="m-btn-next"
        class="flex-1 py-2.5 px-3 rounded-xl bg-ink-900/90 border border-bone-50/10 text-bone-200 hover:text-ember-400 font-micro text-[11px] font-semibold flex items-center justify-center gap-1.5 active:scale-95 transition-all cursor-pointer"
        aria-label="Next Silicon Node"
      >
        <span>NEXT</span>
        <span>▶</span>
      </button>
    </div>

    <!-- Mobile View Mode Toggle (Tactile Deck vs 2D Canvas) -->
    <div class="p-2.5 rounded-xl bg-ink-900/60 border border-bone-50/10 flex items-center justify-between gap-2 font-micro text-[10px]">
      <span class="text-bone-400">Mobile Mode:</span>
      <div class="flex items-center gap-1">
        <button
          type="button"
          id="m-toggle-deck-btn"
          class="px-2.5 py-1 rounded-full bg-bone-50/10 text-ember-400 font-semibold cursor-pointer transition-colors"
        >
          Tactile Deck
        </button>
        <button
          type="button"
          id="m-toggle-canvas-btn"
          class="px-2.5 py-1 rounded-full text-bone-400 hover:text-bone-100 cursor-pointer transition-colors"
        >
          2D Physics Canvas
        </button>
      </div>
    </div>
  </div>

  <!-- VIEW 1: Interactive Force Canvas (Desktop default / Mobile optional) -->
  <div id="obsidian-graph-view" class={`relative w-full rounded-2xl bg-ink-950 border border-bone-50/15 overflow-hidden shadow-2xl ${isGraphInitial ? 'hidden md:block' : 'hidden'}`}>
    <div class="relative w-full h-[520px] sm:h-[620px] lg:h-[680px]">
      <canvas
        id="obsidian-canvas"
        class="w-full h-full cursor-grab active:cursor-grabbing block touch-none"
      ></canvas>

      <!-- Canvas HUD Controls (Top Left & Top Right) -->
      <div class="absolute top-3 left-3 flex items-center gap-1.5 p-1 rounded-xl bg-ink-950/80 backdrop-blur-md border border-bone-50/10 text-bone-300 font-micro text-xs pointer-events-auto">
        <button type="button" id="graph-zoom-in" class="p-1.5 hover:text-ember-400 hover:bg-bone-50/5 rounded transition-colors cursor-pointer" title="Zoom in" aria-label="Zoom in">+</button>
        <button type="button" id="graph-zoom-out" class="p-1.5 hover:text-ember-400 hover:bg-bone-50/5 rounded transition-colors cursor-pointer" title="Zoom out" aria-label="Zoom out">-</button>
        <button type="button" id="graph-reset" class="px-2 py-1 hover:text-ember-400 hover:bg-bone-50/5 rounded text-[10px] transition-colors cursor-pointer" title="Reset view">Reset</button>
        <button type="button" id="graph-pause" class="px-2 py-1 hover:text-ember-400 hover:bg-bone-50/5 rounded text-[10px] transition-colors cursor-pointer" title="Pause physics">Pause</button>
      </div>

      <div class="absolute top-3 right-3 hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-xl bg-ink-950/80 backdrop-blur-md border border-bone-50/10 text-[10px] font-micro text-bone-400 pointer-events-none">
        <span class="w-1.5 h-1.5 rounded-full bg-moss-500"></span>
        <span>Drag nodes · Scroll/Pinch to zoom · Click to inspect</span>
      </div>

      <!-- Node Detail Inspector Card (Docked Floating Inspector) -->
      <div
        id="obsidian-node-inspector"
        class="absolute bottom-3 left-3 right-3 sm:right-auto sm:max-w-md p-3.5 sm:p-5 rounded-2xl bg-ink-900/95 backdrop-blur-xl border border-bone-50/20 shadow-2xl pointer-events-auto transition-all duration-300 translate-y-0 opacity-100 max-h-[44vh] sm:max-h-[500px] overflow-y-auto"
      >
        <div class="flex items-start justify-between gap-2 mb-2">
          <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
            <span class="w-2.5 h-2.5 rounded-full" id="inspector-cluster-dot" style="background-color: #ff7a45;"></span>
            <span class="font-micro text-[10px] uppercase tracking-wider text-ember-400 font-bold" id="inspector-cluster-name">Low-Level &amp; Kernel</span>
            <span class="chip chip-brass !text-[8.5px] sm:!text-[9px] !py-0.2" id="inspector-level">Core Baseline</span>
          </div>
          <div class="flex items-center gap-1 shrink-0">
            <button type="button" id="inspector-min-btn" class="text-bone-400 hover:text-bone-100 p-1 font-mono text-xs cursor-pointer" title="Minimize / Expand Inspector" aria-label="Minimize / Expand">_</button>
            <button type="button" id="inspector-close-btn" class="text-bone-500 hover:text-bone-100 p-1 text-xs cursor-pointer" title="Close inspector" aria-label="Close inspector">✕</button>
          </div>
        </div>

        <div id="inspector-body" class="space-y-2">
          <h4 class="display text-base sm:text-xl text-bone-50" id="inspector-title">C (POSIX / Systems)</h4>
          <p class="text-xs text-bone-300 mt-1 leading-relaxed" id="inspector-summary">
            Manual memory layout, pointer arithmetic, ioctl syscalls, and low-level networking.
          </p>

          <div class="mt-2.5 p-2.5 sm:p-3 rounded-xl bg-ink-950 border border-bone-50/10">
            <p class="font-micro text-[9.5px] sm:text-[10px] text-moss-400 uppercase tracking-wider font-semibold">Verified Proof / Ground Truth:</p>
            <p class="text-[11px] sm:text-xs text-bone-400 mt-0.5 leading-relaxed" id="inspector-evidence">
              Hermetic QEMU harnesses and zero-copy user-space memory inspectors.
            </p>
          </div>

          <!-- Connected Nodes Strip -->
          <div class="mt-2.5 pt-2.5 border-t border-bone-50/10">
            <p class="font-micro text-[9.5px] sm:text-[10px] text-bone-500 uppercase tracking-wider mb-1.5">Connected Dependencies &amp; Edges:</p>
            <div class="flex flex-wrap gap-1.5" id="inspector-connected-nodes">
              <!-- Populated dynamically via JS -->
            </div>
          </div>

          <div class="mt-2 flex items-center justify-between text-[10px] font-micro text-bone-500">
            <span id="inspector-connections-count">2 Direct Connections</span>
            <a href="#" id="inspector-artifact-link" class="text-ember-400 hover:underline hidden">Open Spec Sheet ↗</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- VIEW 2: Small Cards Matrix (Accessible Categorized Grid) -->
  <div id="obsidian-grid-view" class={`space-y-8 ${isGraphInitial ? 'hidden' : ''}`}>
    {clusterList.map((cluster) => {
      const clusterNodes = techNodes.filter((n) => n.cluster === cluster.id);
      return (
        <div class="cluster-group space-y-4" data-group-cluster={cluster.id}>
          <div class="flex items-center gap-2.5 pb-2 border-b border-bone-50/10">
            <span class="w-3 h-3 rounded-full shrink-0" style={`background-color: ${cluster.color};`}></span>
            <h4 class="font-display text-lg sm:text-xl text-bone-50 font-semibold">{cluster.name}</h4>
            <span class="font-micro text-xs text-bone-500">({clusterNodes.length} Nodes)</span>
            <span class="text-xs text-bone-400 hidden sm:inline ml-auto">{cluster.description}</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {clusterNodes.map((node) => {
              const connectedEdges = techEdges.filter((e) => e.source === node.id || e.target === node.id);
              return (
                <div
                  id={`grid-node-${node.id}`}
                  class="obsidian-small-card card card-glare p-5 flex flex-col justify-between border-t-2 transition-all"
                  style={`border-top-color: ${cluster.color};`}
                  data-card-node={node.id}
                  data-card-cluster={node.cluster}
                  data-card-label={node.label}
                  data-card-summary={node.summary}
                >
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-2">
                      <span class="font-micro text-[10px] font-bold uppercase tracking-wider text-bone-400">{cluster.name}</span>
                      <span class="chip !text-[9px] !py-0.5 !px-2 bg-ink-950 border-bone-50/10 text-brass-400">{node.level}</span>
                    </div>

                    <h5 class="display text-base text-bone-50 font-semibold mb-1.5">{node.label}</h5>
                    <p class="text-xs text-bone-300 leading-relaxed mb-3">{node.summary}</p>

                    <div class="p-2.5 rounded-lg bg-ink-950 border border-bone-50/10 mb-3">
                      <span class="font-micro text-[9px] text-moss-400 uppercase tracking-wider block font-semibold">Evidence / Rig Test:</span>
                      <p class="text-[11px] text-bone-400 mt-0.5 leading-relaxed">{node.evidence}</p>
                    </div>
                  </div>

                  <div class="mt-3 pt-3 border-t border-bone-50/10">
                    <span class="font-micro text-[9px] text-bone-500 uppercase tracking-wider block mb-1.5">Connected Graph Nodes ({connectedEdges.length}):</span>
                    <div class="flex flex-wrap gap-1">
                      {connectedEdges.map((e) => {
                        const otherId = e.source === node.id ? e.target : e.source;
                        const otherNode = techNodes.find((n) => n.id === otherId);
                        return otherNode ? (
                          <button
                            type="button"
                            class="grid-neighbor-chip chip !text-[9px] !py-0.5 !px-2 bg-ink-950/80 border-bone-50/10 hover:border-ember-400/50 text-bone-300 hover:text-ember-300 transition-colors cursor-pointer text-left"
                            data-target-id={otherId}
                            title={`${e.relation} (Click to focus)`}
                          >
                            ↔ {otherNode.label}
                          </button>
                        ) : null;
                      })}
                    </div>
                    {node.artifactUrl && (
                      <a href={node.artifactUrl} class="mt-3 inline-flex items-center gap-1 font-micro text-[10px] text-ember-400 hover:underline">
                        <span>View System Spec / Disclosure</span>
                        <span>↗</span>
                      </a>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      );
    })}
  </div>
</div>

<script is:inline define:vars={{ techNodesData: techNodes, techEdgesData: techEdges, clustersData: graphClusters, defaultView: initialView }}>
  (function () {
    let animId = null;
    let isRunning = false;
    let isPhysicsPaused = false;
    let resizeObserver = null;
    let abortController = null;
    let hasInitializedSize = false;

    function cleanup() {
      isRunning = false;
      if (animId) {
        cancelAnimationFrame(animId);
        animId = null;
      }
      if (resizeObserver) {
        resizeObserver.disconnect();
        resizeObserver = null;
      }
      if (abortController) {
        abortController.abort();
        abortController = null;
      }
      window.__activeObsidianCleanup = null;
    }

    function initObsidianGraph() {
      if (typeof window.__activeObsidianCleanup === 'function') {
        window.__activeObsidianCleanup();
      }
      window.__activeObsidianCleanup = cleanup;

      const canvas = document.getElementById('obsidian-canvas');
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      isRunning = true;
      isPhysicsPaused = false;
      hasInitializedSize = false;
      abortController = new AbortController();
      const signal = abortController.signal;

      // View toggle buttons
      const btnGraph = document.getElementById('btn-view-graph');
      const btnGrid = document.getElementById('btn-view-grid');
      const graphView = document.getElementById('obsidian-graph-view');
      const gridView = document.getElementById('obsidian-grid-view');

      function showGraphView() {
        if (btnGraph && btnGrid && graphView && gridView) {
          btnGraph.classList.add('bg-bone-50/10', 'text-ember-400');
          btnGraph.classList.remove('text-bone-400');
          btnGraph.setAttribute('aria-selected', 'true');

          btnGrid.classList.remove('bg-bone-50/10', 'text-ember-400');
          btnGrid.classList.add('text-bone-400');
          btnGrid.setAttribute('aria-selected', 'false');

          gridView.classList.add('hidden');
          if (mDeckView) mDeckView.classList.remove('hidden');
          if (window.innerWidth >= 768) {
            graphView.classList.remove('hidden');
            resize();
          } else {
            if (mToggleCanvasBtn && mToggleCanvasBtn.classList.contains('text-ember-400')) {
              graphView.classList.remove('hidden');
              resize();
            } else {
              graphView.classList.add('hidden');
            }
          }
        }
      }

      function showGridView() {
        if (btnGraph && btnGrid && graphView && gridView) {
          btnGrid.classList.add('bg-bone-50/10', 'text-ember-400');
          btnGrid.classList.remove('text-bone-400');
          btnGrid.setAttribute('aria-selected', 'true');

          btnGraph.classList.remove('bg-bone-50/10', 'text-ember-400');
          btnGraph.classList.add('text-bone-400');
          btnGraph.setAttribute('aria-selected', 'false');

          gridView.classList.remove('hidden');
          graphView.classList.add('hidden');
          if (mDeckView) mDeckView.classList.add('hidden');
          applyGridFilter();
        }
      }

      if (btnGraph) btnGraph.onclick = showGraphView;
      if (btnGrid) btnGrid.onclick = showGridView;

      // Mobile Silicon Deck Controller
      let mobileCurrentIndex = 0;
      let mobileFilteredNodes = [...techNodesData];

      const mDeckView = document.getElementById('mobile-silicon-deck');
      const mCard = document.getElementById('m-node-card');
      const mClusterDot = document.getElementById('m-cluster-dot');
      const mClusterName = document.getElementById('m-cluster-name');
      const mNodeIndex = document.getElementById('m-node-index');
      const mNodeTotal = document.getElementById('m-node-total');
      const mNodeLevel = document.getElementById('m-node-level');
      const mNodeTitle = document.getElementById('m-node-title');
      const mNodeSummary = document.getElementById('m-node-summary');
      const mNodeEvidence = document.getElementById('m-node-evidence');
      const mNodeLinks = document.getElementById('m-node-links');
      const mArtifactBtn = document.getElementById('m-node-artifact-btn');
      const mBtnPrev = document.getElementById('m-btn-prev');
      const mBtnNext = document.getElementById('m-btn-next');
      const mToggleDeckBtn = document.getElementById('m-toggle-deck-btn');
      const mToggleCanvasBtn = document.getElementById('m-toggle-canvas-btn');

      function updateMobileCard(index) {
        if (!mobileFilteredNodes.length) return;
        if (index < 0) index = mobileFilteredNodes.length - 1;
        if (index >= mobileFilteredNodes.length) index = 0;
        mobileCurrentIndex = index;

        const node = mobileFilteredNodes[index];
        const cluster = clustersData[node.cluster] || { name: node.cluster, color: '#ff7a45' };

        if (mClusterDot) mClusterDot.style.backgroundColor = cluster.color;
        if (mClusterName) mClusterName.textContent = cluster.name;
        if (mCard) mCard.style.borderTopColor = cluster.color;
        if (mNodeIndex) mNodeIndex.textContent = String(index + 1).padStart(2, '0');
        if (mNodeTotal) mNodeTotal.textContent = String(mobileFilteredNodes.length).padStart(2, '0');
        if (mNodeLevel) mNodeLevel.textContent = node.level;
        if (mNodeTitle) mNodeTitle.textContent = node.label;
        if (mNodeSummary) mNodeSummary.textContent = node.summary;
        if (mNodeEvidence) mNodeEvidence.textContent = node.evidence;

        if (mNodeLinks) {
          mNodeLinks.innerHTML = '';
          const connected = techEdgesData.filter(e => e.source === node.id || e.target === node.id);
          if (connected.length === 0) {
            const span = document.createElement('span');
            span.className = 'text-[10px] text-bone-500 font-micro';
            span.textContent = 'None directly connected';
            mNodeLinks.appendChild(span);
          } else {
            connected.forEach(e => {
              const targetId = e.source === node.id ? e.target : e.source;
              const targetNode = techNodesData.find(n => n.id === targetId);
              if (targetNode) {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'chip !text-[8.5px] !py-0.2 !px-1.5 bg-ink-900 border-bone-50/10 text-bone-300 hover:text-ember-300 hover:border-ember-400/40 cursor-pointer transition-colors';
                btn.textContent = `↔ ${targetNode.label}`;
                btn.onclick = (ev) => {
                  ev.preventDefault();
                  jumpToMobileNode(targetId);
                };
                mNodeLinks.appendChild(btn);
              }
            });
          }
        }

        if (mArtifactBtn) {
          if (node.artifactUrl) {
            mArtifactBtn.href = node.artifactUrl;
            mArtifactBtn.classList.remove('hidden');
          } else {
            mArtifactBtn.classList.add('hidden');
          }
        }
      }

      function jumpToMobileNode(nodeId) {
        let idx = mobileFilteredNodes.findIndex(n => n.id === nodeId);
        if (idx === -1) {
          mobileFilteredNodes = [...techNodesData];
          document.querySelectorAll('.m-cluster-pill').forEach(p => {
            const isAll = p.getAttribute('data-m-cluster') === 'all';
            p.classList.toggle('active', isAll);
            p.classList.toggle('bg-bone-50/10', isAll);
            p.classList.toggle('text-bone-50', isAll);
            p.classList.toggle('text-bone-400', !isAll);
          });
          idx = mobileFilteredNodes.findIndex(n => n.id === nodeId);
        }
        if (idx !== -1) {
          if (mCard) {
            mCard.style.opacity = '0.5';
            setTimeout(() => {
              updateMobileCard(idx);
              mCard.style.opacity = '1';
            }, 100);
          } else {
            updateMobileCard(idx);
          }
        }
      }

      if (mBtnPrev) {
        mBtnPrev.onclick = () => updateMobileCard(mobileCurrentIndex - 1);
      }
      if (mBtnNext) {
        mBtnNext.onclick = () => updateMobileCard(mobileCurrentIndex + 1);
      }

      if (mCard) {
        let touchStartX = 0;
        mCard.addEventListener('touchstart', (e) => {
          touchStartX = e.changedTouches[0].screenX;
        }, { passive: true, signal });

        mCard.addEventListener('touchend', (e) => {
          const touchEndX = e.changedTouches[0].screenX;
          const diff = touchStartX - touchEndX;
          if (diff > 45) {
            updateMobileCard(mobileCurrentIndex + 1);
          } else if (diff < -45) {
            updateMobileCard(mobileCurrentIndex - 1);
          }
        }, { passive: true, signal });
      }

      document.querySelectorAll('.m-cluster-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          document.querySelectorAll('.m-cluster-pill').forEach(p => {
            p.classList.remove('active', 'bg-bone-50/10', 'text-bone-50');
            p.classList.add('text-bone-400');
          });
          pill.classList.add('active', 'bg-bone-50/10', 'text-bone-50');
          pill.classList.remove('text-bone-400');

          const cl = pill.getAttribute('data-m-cluster');
          if (cl === 'all') {
            mobileFilteredNodes = [...techNodesData];
          } else {
            mobileFilteredNodes = techNodesData.filter(n => n.cluster === cl);
          }
          updateMobileCard(0);
        }, { signal });
      });

      if (mToggleDeckBtn && mToggleCanvasBtn) {
        mToggleDeckBtn.onclick = () => {
          mToggleDeckBtn.classList.add('bg-bone-50/10', 'text-ember-400');
          mToggleDeckBtn.classList.remove('text-bone-400');
          mToggleCanvasBtn.classList.remove('bg-bone-50/10', 'text-ember-400');
          mToggleCanvasBtn.classList.add('text-bone-400');

          if (mDeckView) mDeckView.classList.remove('hidden');
          if (graphView) {
            graphView.classList.add('hidden');
            graphView.classList.add('md:block');
          }
        };

        mToggleCanvasBtn.onclick = () => {
          mToggleCanvasBtn.classList.add('bg-bone-50/10', 'text-ember-400');
          mToggleCanvasBtn.classList.remove('text-bone-400');
          mToggleDeckBtn.classList.remove('bg-bone-50/10', 'text-ember-400');
          mToggleDeckBtn.classList.add('text-bone-400');

          if (mDeckView) mDeckView.classList.add('hidden');
          if (graphView) {
            graphView.classList.remove('hidden', 'md:block');
            resize();
          }
        };
      }

      updateMobileCard(0);

      if (defaultView === 'grid') {
        showGridView();
      }

      // Graph data clone
      const nodes = techNodesData.map((n, i) => {
        const angle = (i / techNodesData.length) * Math.PI * 2;
        const radius = 210 + (i % 4) * 45;
        const incidentEdgesCount = techEdgesData.filter(e => e.source === n.id || e.target === n.id).length;
        return {
          ...n,
          x: Math.cos(angle) * radius,
          y: Math.sin(angle) * radius,
          vx: 0,
          vy: 0,
          radius: 12 + (incidentEdgesCount * 1.5),
          color: (clustersData[n.cluster] && clustersData[n.cluster].color) || '#ff7a45',
        };
      });

      const edges = techEdgesData.map(e => ({
        ...e,
        sourceNode: nodes.find(n => n.id === e.source),
        targetNode: nodes.find(n => n.id === e.target),
      })).filter(e => e.sourceNode && e.targetNode);

      let width = 0;
      let height = 0;
      let dpr = window.devicePixelRatio || 1;

      // Transform state (Pan & Zoom)
      let transform = {
        x: 0,
        y: 0,
        scale: 1,
      };

      function resize() {
        const rect = canvas.getBoundingClientRect();
        if (rect.width === 0 || rect.height === 0) return;

        const firstInit = !hasInitializedSize || width === 0 || height === 0;
        width = rect.width;
        height = rect.height;
        dpr = window.devicePixelRatio || 1;
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        if (firstInit || transform.x === 0) {
          transform.x = width / 2;
          transform.y = height / 2;
          transform.scale = 1;
          hasInitializedSize = true;
        }
      }

      resize();

      // Observe container size changes (fixes hidden tab initialization and responsive resizes)
      if (window.ResizeObserver) {
        resizeObserver = new ResizeObserver((entries) => {
          for (let entry of entries) {
            if (entry.contentRect.width > 0 && entry.contentRect.height > 0) {
              resize();
            }
          }
        });
        if (canvas.parentElement) {
          resizeObserver.observe(canvas.parentElement);
        }
        const graphContainer = document.getElementById('obsidian-graph-component');
        if (graphContainer) {
          resizeObserver.observe(graphContainer);
        }
      }

      window.addEventListener('resize', resize, { signal });

      let hoveredNode = null;
      let selectedNode = nodes[0] || null;
      let draggedNode = null;
      let isPanning = false;
      let panStart = { x: 0, y: 0 };
      let activeCluster = 'all';
      let searchQuery = '';
      let initialPinchDist = null;
      let initialScale = 1;

      // Inspector DOM elements
      const inspector = document.getElementById('obsidian-node-inspector');
      const inspTitle = document.getElementById('inspector-title');
      const inspClusterDot = document.getElementById('inspector-cluster-dot');
      const inspClusterName = document.getElementById('inspector-cluster-name');
      const inspLevel = document.getElementById('inspector-level');
      const inspSummary = document.getElementById('inspector-summary');
      const inspEvidence = document.getElementById('inspector-evidence');
      const inspConnected = document.getElementById('inspector-connected-nodes');
      const inspCount = document.getElementById('inspector-connections-count');
      const inspArtifact = document.getElementById('inspector-artifact-link');
      const inspClose = document.getElementById('inspector-close-btn');
      const inspMin = document.getElementById('inspector-min-btn');
      const inspBody = document.getElementById('inspector-body');

      let isMinimized = false;

      if (inspClose) {
        inspClose.onclick = () => {
          if (inspector) inspector.classList.add('opacity-0', 'pointer-events-none');
        };
      }

      if (inspMin && inspBody) {
        inspMin.onclick = () => {
          isMinimized = !isMinimized;
          inspBody.classList.toggle('hidden', isMinimized);
          inspMin.textContent = isMinimized ? '▲' : '_';
        };
      }

      function updateInspector(node) {
        if (!node || !inspector) return;
        inspector.classList.remove('opacity-0', 'pointer-events-none');
        if (isMinimized && inspBody && inspMin) {
          isMinimized = false;
          inspBody.classList.remove('hidden');
          inspMin.textContent = '_';
        }

        if (inspTitle) inspTitle.textContent = node.label;
        if (inspClusterDot) inspClusterDot.style.backgroundColor = node.color;
        if (inspClusterName) {
          const c = clustersData[node.cluster];
          inspClusterName.textContent = c ? c.name : node.cluster;
        }
        if (inspLevel) inspLevel.textContent = node.level;
        if (inspSummary) inspSummary.textContent = node.summary;
        if (inspEvidence) inspEvidence.textContent = node.evidence;

        const incidentEdges = edges.filter(e => e.source === node.id || e.target === node.id);
        if (inspCount) inspCount.textContent = `${incidentEdges.length} Connected Dependencies`;

        if (inspConnected) {
          inspConnected.innerHTML = '';
          incidentEdges.forEach(e => {
            const other = e.source === node.id ? e.targetNode : e.sourceNode;
            if (!other) return;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'chip !text-[10px] !py-0.5 !px-2 bg-ink-950 border-bone-50/10 hover:border-ember-400 text-bone-200 cursor-pointer transition-colors';
            btn.textContent = `↔ ${other.label}`;
            btn.title = e.relation;
            btn.onclick = (ev) => {
              ev.stopPropagation();
              selectedNode = other;
              updateInspector(other);
              transform.x = width / 2 - other.x * transform.scale;
              transform.y = height / 2 - other.y * transform.scale;
            };
            inspConnected.appendChild(btn);
          });
        }

        if (inspArtifact) {
          if (node.artifactUrl) {
            inspArtifact.href = node.artifactUrl;
            inspArtifact.classList.remove('hidden');
          } else {
            inspArtifact.classList.add('hidden');
          }
        }
      }

      if (selectedNode) {
        updateInspector(selectedNode);
      }

      // Grid view dynamic filtering
      function applyGridFilter() {
        const groups = document.querySelectorAll('.cluster-group');
        const cards = document.querySelectorAll('.obsidian-small-card');

        cards.forEach(card => {
          const cardCluster = card.getAttribute('data-card-cluster');
          const cardLabel = (card.getAttribute('data-card-label') || '').toLowerCase();
          const cardSummary = (card.getAttribute('data-card-summary') || '').toLowerCase();

          const matchesCluster = activeCluster === 'all' || cardCluster === activeCluster;
          const matchesSearch = !searchQuery || cardLabel.includes(searchQuery) || cardSummary.includes(searchQuery);

          if (matchesCluster && matchesSearch) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });

        groups.forEach(group => {
          const groupCluster = group.getAttribute('data-group-cluster');
          const clusterMatches = activeCluster === 'all' || groupCluster === activeCluster;
          const hasVisibleCards = Array.from(group.querySelectorAll('.obsidian-small-card')).some(c => c.style.display !== 'none');
          group.style.display = (clusterMatches && hasVisibleCards) ? 'block' : 'none';
        });
      }

      // Cluster filter buttons
      document.querySelectorAll('.cluster-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.cluster-filter-btn').forEach(b => {
            b.classList.remove('active', 'bg-bone-50/10', 'text-bone-50', 'border-bone-50/20');
            b.classList.add('text-bone-400', 'bg-ink-950/70', 'border-bone-50/5');
          });
          btn.classList.add('active', 'bg-bone-50/10', 'text-bone-50', 'border-bone-50/20');
          btn.classList.remove('text-bone-400', 'bg-ink-950/70', 'border-bone-50/5');
          activeCluster = btn.getAttribute('data-cluster') || 'all';
          applyGridFilter();
        }, { signal });
      });

      // Search input
      const searchInput = document.getElementById('obsidian-search-input');
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = e.target.value.trim().toLowerCase();
          applyGridFilter();
        }, { signal });
      }

      // Grid neighbor chips
      document.querySelectorAll('.grid-neighbor-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          const targetId = chip.getAttribute('data-target-id');
          if (!targetId) return;
          const targetCard = document.getElementById(`grid-node-${targetId}`);
          if (targetCard) {
            targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            targetCard.classList.add('ring-2', 'ring-ember-500');
            setTimeout(() => {
              targetCard.classList.remove('ring-2', 'ring-ember-500');
            }, 1800);
          }
        }, { signal });
      });

      // HUD zoom & controls (centered on canvas center)
      function zoomAround(pivotX, pivotY, factor) {
        const newScale = Math.min(2.5, Math.max(0.4, transform.scale * factor));
        transform.x = pivotX - (pivotX - transform.x) * (newScale / transform.scale);
        transform.y = pivotY - (pivotY - transform.y) * (newScale / transform.scale);
        transform.scale = newScale;
      }

      const btnZoomIn = document.getElementById('graph-zoom-in');
      const btnZoomOut = document.getElementById('graph-zoom-out');
      const btnReset = document.getElementById('graph-reset');
      const btnPause = document.getElementById('graph-pause');

      if (btnZoomIn) btnZoomIn.onclick = () => zoomAround(width / 2, height / 2, 1.25);
      if (btnZoomOut) btnZoomOut.onclick = () => zoomAround(width / 2, height / 2, 0.8);
      if (btnReset) btnReset.onclick = () => {
        transform.scale = 1;
        transform.x = width / 2;
        transform.y = height / 2;
      };
      if (btnPause) {
        btnPause.onclick = () => {
          isPhysicsPaused = !isPhysicsPaused;
          btnPause.textContent = isPhysicsPaused ? 'Play' : 'Pause';
        };
      }

      function toGraphCoords(clientX, clientY) {
        const rect = canvas.getBoundingClientRect();
        const screenX = clientX - rect.left;
        const screenY = clientY - rect.top;
        return {
          x: (screenX - transform.x) / transform.scale,
          y: (screenY - transform.y) / transform.scale,
        };
      }

      function findNodeAt(gX, gY) {
        // Prioritize non-dimmed nodes
        for (let i = nodes.length - 1; i >= 0; i--) {
          const n = nodes[i];
          const matchesCluster = activeCluster === 'all' || n.cluster === activeCluster;
          const matchesSearch = !searchQuery || n.label.toLowerCase().includes(searchQuery) || n.summary.toLowerCase().includes(searchQuery);
          if (matchesCluster && matchesSearch) {
            const distSq = (n.x - gX) * (n.x - gX) + (n.y - gY) * (n.y - gY);
            if (distSq <= (n.radius + 10) * (n.radius + 10)) {
              return n;
            }
          }
        }
        for (let i = nodes.length - 1; i >= 0; i--) {
          const n = nodes[i];
          const distSq = (n.x - gX) * (n.x - gX) + (n.y - gY) * (n.y - gY);
          if (distSq <= (n.radius + 10) * (n.radius + 10)) {
            return n;
          }
        }
        return null;
      }

      // Mouse Listeners
      canvas.addEventListener('mousedown', (e) => {
        if (e.button !== 0) return;
        const pos = toGraphCoords(e.clientX, e.clientY);
        const hit = findNodeAt(pos.x, pos.y);
        if (hit) {
          draggedNode = hit;
          selectedNode = hit;
          updateInspector(hit);
          canvas.style.cursor = 'grabbing';
        } else {
          isPanning = true;
          panStart = { x: e.clientX - transform.x, y: e.clientY - transform.y };
          canvas.style.cursor = 'grabbing';
        }
      }, { signal });

      window.addEventListener('mousemove', (e) => {
        if (draggedNode) {
          const pos = toGraphCoords(e.clientX, e.clientY);
          draggedNode.x = pos.x;
          draggedNode.y = pos.y;
          draggedNode.vx = 0;
          draggedNode.vy = 0;
          return;
        }

        if (isPanning) {
          transform.x = e.clientX - panStart.x;
          transform.y = e.clientY - panStart.y;
          return;
        }

        const pos = toGraphCoords(e.clientX, e.clientY);
        hoveredNode = findNodeAt(pos.x, pos.y);
        canvas.style.cursor = hoveredNode ? 'pointer' : 'grab';
      }, { signal });

      window.addEventListener('mouseup', () => {
        draggedNode = null;
        isPanning = false;
        canvas.style.cursor = hoveredNode ? 'pointer' : 'grab';
      }, { signal });

      canvas.addEventListener('wheel', (e) => {
        e.preventDefault();
        const zoomFactor = e.deltaY < 0 ? 1.1 : 0.9;
        const rect = canvas.getBoundingClientRect();
        const mouseX = e.clientX - rect.left;
        const mouseY = e.clientY - rect.top;
        zoomAround(mouseX, mouseY, zoomFactor);
      }, { passive: false, signal });

      // Touch & Pinch-to-zoom handlers
      canvas.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          const t = e.touches[0];
          const pos = toGraphCoords(t.clientX, t.clientY);
          const hit = findNodeAt(pos.x, pos.y);
          if (hit) {
            draggedNode = hit;
            selectedNode = hit;
            updateInspector(hit);
            e.preventDefault();
          } else {
            isPanning = true;
            panStart = { x: t.clientX - transform.x, y: t.clientY - transform.y };
          }
        } else if (e.touches.length === 2) {
          isPanning = false;
          draggedNode = null;
          const dx = e.touches[0].clientX - e.touches[1].clientX;
          const dy = e.touches[0].clientY - e.touches[1].clientY;
          initialPinchDist = Math.hypot(dx, dy);
          initialScale = transform.scale;
          e.preventDefault();
        }
      }, { passive: false, signal });

      canvas.addEventListener('touchmove', (e) => {
        if (e.touches.length === 1) {
          const t = e.touches[0];
          if (draggedNode) {
            e.preventDefault();
            const pos = toGraphCoords(t.clientX, t.clientY);
            draggedNode.x = pos.x;
            draggedNode.y = pos.y;
            draggedNode.vx = 0;
            draggedNode.vy = 0;
          } else if (isPanning) {
            e.preventDefault();
            transform.x = t.clientX - panStart.x;
            transform.y = t.clientY - panStart.y;
          }
        } else if (e.touches.length === 2 && initialPinchDist) {
          e.preventDefault();
          const dx = e.touches[0].clientX - e.touches[1].clientX;
          const dy = e.touches[0].clientY - e.touches[1].clientY;
          const currentDist = Math.hypot(dx, dy);
          const factor = currentDist / initialPinchDist;
          const midX = (e.touches[0].clientX + e.touches[1].clientX) / 2;
          const midY = (e.touches[0].clientY + e.touches[1].clientY) / 2;
          const rect = canvas.getBoundingClientRect();
          zoomAround(midX - rect.left, midY - rect.top, (factor * initialScale) / transform.scale);
        }
      }, { passive: false, signal });

      canvas.addEventListener('touchend', () => {
        draggedNode = null;
        isPanning = false;
        initialPinchDist = null;
      }, { signal });

      // Physics update: force-directed layout with Newton third law conservation
      function updatePhysics() {
        if (!isRunning || isPhysicsPaused) return;
        if (width === 0 || height === 0) return;

        // Anti-collision repulsion
        for (let i = 0; i < nodes.length; i++) {
          for (let j = i + 1; j < nodes.length; j++) {
            const n1 = nodes[i];
            const n2 = nodes[j];
            let dx = n2.x - n1.x;
            let dy = n2.y - n1.y;
            let dist = Math.sqrt(dx * dx + dy * dy) || 0.01;
            const minDist = n1.radius + n2.radius + 85;

            if (dist < minDist) {
              let force = (minDist - dist) / minDist;
              let fx = (dx / dist) * force * 1.6;
              let fy = (dy / dist) * force * 1.6;
              if (n1 !== draggedNode) { n1.vx -= fx; n1.vy -= fy; }
              if (n2 !== draggedNode) { n2.vx += fx; n2.vy += fy; }
            }
          }
        }

        // Spring attraction (Equal and opposite reaction!)
        for (let i = 0; i < edges.length; i++) {
          const e = edges[i];
          const n1 = e.sourceNode;
          const n2 = e.targetNode;
          let dx = n2.x - n1.x;
          let dy = n2.y - n1.y;
          let dist = Math.sqrt(dx * dx + dy * dy) || 1;
          let ideal = 135;
          let force = (dist - ideal) * 0.025;
          force = Math.max(-4, Math.min(4, force));

          let fx = (dx / dist) * force;
          let fy = (dy / dist) * force;

          if (n1 !== draggedNode) { n1.vx += fx; n1.vy += fy; }
          if (n2 !== draggedNode) { n2.vx -= fx; n2.vy -= fy; }
        }

        // Center gravity & dampening
        for (let i = 0; i < nodes.length; i++) {
          const n = nodes[i];
          if (n === draggedNode) continue;

          n.vx -= n.x * 0.0025;
          n.vy -= n.y * 0.0025;

          n.vx *= 0.85;
          n.vy *= 0.85;

          n.vx = Math.max(-6, Math.min(6, n.vx));
          n.vy = Math.max(-6, Math.min(6, n.vy));

          n.x += n.vx;
          n.y += n.vy;
        }
      }

      // Draw loop
      function loop() {
        if (!isRunning) return;

        updatePhysics();

        if (width > 0 && height > 0) {
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          ctx.clearRect(0, 0, width, height);

          ctx.save();
          ctx.translate(transform.x, transform.y);
          ctx.scale(transform.scale, transform.scale);

          // Background subtle grid stars
          ctx.fillStyle = 'rgba(237, 232, 220, 0.04)';
          for (let gx = -600; gx <= 600; gx += 60) {
            for (let gy = -600; gy <= 600; gy += 60) {
              ctx.beginPath();
              ctx.arc(gx, gy, 1, 0, Math.PI * 2);
              ctx.fill();
            }
          }

          const activeNode = hoveredNode || selectedNode;

          // Draw Edges
          for (let i = 0; i < edges.length; i++) {
            const e = edges[i];
            const n1 = e.sourceNode;
            const n2 = e.targetNode;

            const isConnectedToActive = activeNode && (e.source === activeNode.id || e.target === activeNode.id);
            const n1Matches = activeCluster === 'all' || n1.cluster === activeCluster;
            const n2Matches = activeCluster === 'all' || n2.cluster === activeCluster;
            const isDimmed = !n1Matches && !n2Matches;

            ctx.beginPath();
            ctx.moveTo(n1.x, n1.y);
            ctx.lineTo(n2.x, n2.y);

            if (isConnectedToActive) {
              ctx.strokeStyle = 'rgba(255, 122, 69, 0.85)';
              ctx.lineWidth = 2.4 / transform.scale;
              ctx.shadowColor = '#ff4d1c';
              ctx.shadowBlur = 10;
            } else if (isDimmed) {
              ctx.strokeStyle = 'rgba(237, 232, 220, 0.04)';
              ctx.lineWidth = 0.8 / transform.scale;
              ctx.shadowBlur = 0;
            } else {
              ctx.strokeStyle = 'rgba(237, 232, 220, 0.15)';
              ctx.lineWidth = 1.2 / transform.scale;
              ctx.shadowBlur = 0;
            }
            ctx.stroke();
            ctx.shadowBlur = 0;
          }

          // Draw Nodes
          for (let i = 0; i < nodes.length; i++) {
            const n = nodes[i];

            const matchesCluster = activeCluster === 'all' || n.cluster === activeCluster;
            const matchesSearch = !searchQuery || n.label.toLowerCase().includes(searchQuery) || n.summary.toLowerCase().includes(searchQuery);
            const isDimmed = !matchesCluster || !matchesSearch;

            const isHovered = n === hoveredNode;
            const isSelected = n === selectedNode;
            const isConnected = activeNode && edges.some(e =>
              (e.source === activeNode.id && e.target === n.id) ||
              (e.target === activeNode.id && e.source === n.id)
            );

            ctx.save();
            if (isDimmed) {
              ctx.globalAlpha = 0.18;
            }

            // Halo glow for hovered/selected/connected
            if (isHovered || isSelected || isConnected) {
              ctx.beginPath();
              ctx.arc(n.x, n.y, n.radius + 6, 0, Math.PI * 2);
              ctx.fillStyle = isSelected ? 'rgba(255, 77, 28, 0.3)' : 'rgba(237, 232, 220, 0.15)';
              ctx.fill();
            }

            // Main node circle
            ctx.beginPath();
            ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2);
            ctx.fillStyle = n.color;
            if (isSelected || isHovered) {
              ctx.shadowColor = n.color;
              ctx.shadowBlur = 14;
            }
            ctx.fill();
            ctx.shadowBlur = 0;

            // Inner pin dot
            ctx.beginPath();
            ctx.arc(n.x, n.y, 3, 0, Math.PI * 2);
            ctx.fillStyle = '#0c0c0b';
            ctx.fill();

            // Label text
            ctx.font = `${isHovered || isSelected ? 'bold 11px' : '10px'} "JetBrains Mono", monospace`;
            ctx.textAlign = 'center';
            ctx.textBaseline = 'top';
            ctx.fillStyle = isSelected ? '#ff7a45' : isHovered ? '#ede8dc' : 'rgba(237, 232, 220, 0.85)';
            ctx.fillText(n.label, n.x, n.y + n.radius + 5);

            ctx.restore();
          }

          ctx.restore();
        }

        if (isRunning) {
          animId = requestAnimationFrame(loop);
        }
      }

      animId = requestAnimationFrame(loop);
    }

    if (!window.__obsidianGraphLifecycleRegistered) {
      window.__obsidianGraphLifecycleRegistered = true;
      document.addEventListener('astro:page-load', () => {
        if (document.getElementById('obsidian-canvas')) {
          initObsidianGraph();
        }
      });
      document.addEventListener('astro:before-swap', () => {
        if (typeof window.__activeObsidianCleanup === 'function') {
          window.__activeObsidianCleanup();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initObsidianGraph, { once: true });
    } else {
      initObsidianGraph();
    }
  })();
</script>
