---
import { techNodes, techEdges, graphClusters } from '../data/techGraph';

interface Props {
  initialView?: 'graph' | 'grid';
}

const { initialView = 'graph' } = Astro.props;

const clusterList = Object.values(graphClusters);
---

<div class="w-full obsidian-graph-root" id="obsidian-graph-component">
  <!-- Header & Toolbar -->
  <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
    <div>
      <div class="flex items-center gap-2 mb-1.5">
        <span class="w-2 h-2 rounded-full bg-ember-500 animate-pulse"></span>
        <span class="font-micro text-xs uppercase tracking-widest text-ember-400 font-semibold">
          Obsidian Knowledge &amp; Dependency Architecture
        </span>
      </div>
      <h3 class="display text-2xl sm:text-3xl text-bone-50">
        Connected Skills &amp; <em class="text-ember-400">Silicon Tooling Graph.</em>
      </h3>
      <p class="text-xs sm:text-sm text-bone-400 mt-1 max-w-2xl">
        Interconnected dependency graph mapping 24 core technical nodes across kernel internals, exploit research, high-throughput Rust, offline AI, and web infrastructure.
      </p>
    </div>

    <!-- View Switcher -->
    <div class="flex flex-wrap items-center gap-2">
      <div class="flex items-center p-1 rounded-full bg-ink-950 border border-bone-50/10 font-micro text-xs shrink-0" role="tablist">
        <button
          type="button"
          id="btn-view-graph"
          class="px-3.5 py-1.5 rounded-full font-semibold transition-all bg-bone-50/10 text-ember-400 cursor-pointer flex items-center gap-1.5"
          role="tab"
          aria-selected="true"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="6" cy="6" r="3" />
            <circle cx="18" cy="18" r="3" />
            <circle cx="18" cy="6" r="3" />
            <circle cx="6" cy="18" r="3" />
            <path d="M8.5 8.5l7 7M15.5 8.5l-7 7" />
          </svg>
          <span>Obsidian Graph</span>
        </button>
        <button
          type="button"
          id="btn-view-grid"
          class="px-3.5 py-1.5 rounded-full font-semibold transition-all text-bone-400 hover:text-bone-50 cursor-pointer flex items-center gap-1.5"
          role="tab"
          aria-selected="false"
        >
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="3" width="7" height="7" rx="1" />
            <rect x="14" y="14" width="7" height="7" rx="1" />
            <rect x="3" y="14" width="7" height="7" rx="1" />
          </svg>
          <span>Small Cards Matrix</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Cluster Filter Bar & Search -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-5 p-3 rounded-2xl bg-ink-900/60 border border-bone-50/10">
    <div class="flex flex-wrap items-center gap-1.5" id="cluster-filter-buttons">
      <button
        type="button"
        class="cluster-filter-btn active px-3 py-1 rounded-full font-micro text-[11px] font-semibold transition-all bg-bone-50/10 text-bone-50 border border-bone-50/20 cursor-pointer"
        data-cluster="all"
      >
        All Clusters ({techNodes.length})
      </button>
      {clusterList.map((c) => (
        <button
          type="button"
          class="cluster-filter-btn px-2.5 py-1 rounded-full font-micro text-[10px] sm:text-[11px] font-medium transition-all text-bone-400 hover:text-bone-50 bg-ink-950/70 border border-bone-50/5 hover:border-bone-50/15 cursor-pointer flex items-center gap-1.5"
          data-cluster={c.id}
        >
          <span class="w-2 h-2 rounded-full" style={`background-color: ${c.color};`}></span>
          <span>{c.name}</span>
        </button>
      ))}
    </div>

    <!-- Quick Search Input -->
    <div class="relative w-full md:w-56 shrink-0">
      <input
        type="text"
        id="obsidian-search-input"
        placeholder="Search nodes or tools..."
        class="w-full px-3 py-1.5 pl-8 rounded-full bg-ink-950 border border-bone-50/10 text-xs text-bone-100 placeholder:text-bone-600 focus:outline-none focus:border-ember-400/50 font-micro"
      />
      <svg class="w-3.5 h-3.5 absolute left-2.5 top-2.5 text-bone-500" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 100 11 5.5 5.5 0 000-11zM2 9a7 7 0 1112.452 4.391l3.328 3.329a.75.75 0 11-1.06 1.06l-3.329-3.328A7 7 0 012 9z" clip-rule="evenodd" />
      </svg>
    </div>
  </div>

  <!-- VIEW 1: Interactive Obsidian Canvas -->
  <div id="obsidian-graph-view" class="relative w-full rounded-2xl bg-ink-950 border border-bone-50/15 overflow-hidden shadow-2xl">
    <div class="relative w-full h-[520px] sm:h-[620px] lg:h-[680px]">
      <canvas
        id="obsidian-canvas"
        class="w-full h-full cursor-grab active:cursor-grabbing block touch-none"
      ></canvas>

      <!-- Canvas HUD Controls (Top Left & Top Right) -->
      <div class="absolute top-3 left-3 flex items-center gap-1.5 p-1 rounded-xl bg-ink-950/80 backdrop-blur-md border border-bone-50/10 text-bone-300 font-micro text-xs pointer-events-auto">
        <button type="button" id="graph-zoom-in" class="p-1.5 hover:text-ember-400 hover:bg-bone-50/5 rounded transition-colors cursor-pointer" title="Zoom in" aria-label="Zoom in">+</button>
        <button type="button" id="graph-zoom-out" class="p-1.5 hover:text-ember-400 hover:bg-bone-50/5 rounded transition-colors cursor-pointer" title="Zoom out" aria-label="Zoom out">-</button>
        <button type="button" id="graph-reset" class="px-2 py-1 hover:text-ember-400 hover:bg-bone-50/5 rounded text-[10px] transition-colors cursor-pointer" title="Reset view">Reset</button>
        <button type="button" id="graph-pause" class="px-2 py-1 hover:text-ember-400 hover:bg-bone-50/5 rounded text-[10px] transition-colors cursor-pointer" title="Pause physics">Pause</button>
      </div>

      <div class="absolute top-3 right-3 hidden sm:flex items-center gap-2 px-3 py-1.5 rounded-xl bg-ink-950/80 backdrop-blur-md border border-bone-50/10 text-[10px] font-micro text-bone-400 pointer-events-none">
        <span class="w-1.5 h-1.5 rounded-full bg-moss-500"></span>
        <span>Drag nodes · Scroll/Pinch to zoom · Click to inspect</span>
      </div>

      <!-- Node Detail Inspector Card (Docked Floating Inspector) -->
      <div
        id="obsidian-node-inspector"
        class="absolute bottom-3 left-3 right-3 sm:right-auto sm:max-w-md p-3.5 sm:p-5 rounded-2xl bg-ink-900/95 backdrop-blur-xl border border-bone-50/20 shadow-2xl pointer-events-auto transition-all duration-300 translate-y-0 opacity-100 max-h-[44vh] sm:max-h-[500px] overflow-y-auto"
      >
        <div class="flex items-start justify-between gap-2 mb-2">
          <div class="flex flex-wrap items-center gap-1.5 sm:gap-2">
            <span class="w-2.5 h-2.5 rounded-full" id="inspector-cluster-dot" style="background-color: #ff7a45;"></span>
            <span class="font-micro text-[10px] uppercase tracking-wider text-ember-400 font-bold" id="inspector-cluster-name">Low-Level &amp; Kernel</span>
            <span class="chip chip-brass !text-[8.5px] sm:!text-[9px] !py-0.2" id="inspector-level">Core Baseline</span>
          </div>
          <div class="flex items-center gap-1 shrink-0">
            <button type="button" id="inspector-min-btn" class="text-bone-400 hover:text-bone-100 p-1 font-mono text-xs cursor-pointer" title="Minimize / Expand Inspector" aria-label="Minimize / Expand">_</button>
            <button type="button" id="inspector-close-btn" class="text-bone-500 hover:text-bone-100 p-1 text-xs cursor-pointer" title="Close inspector" aria-label="Close inspector">✕</button>
          </div>
        </div>

        <div id="inspector-body" class="space-y-2">
          <h4 class="display text-base sm:text-xl text-bone-50" id="inspector-title">C (POSIX / Systems)</h4>
          <p class="text-xs text-bone-300 mt-1 leading-relaxed" id="inspector-summary">
            Manual memory layout, pointer arithmetic, ioctl syscalls, and low-level networking.
          </p>

          <div class="mt-2.5 p-2.5 sm:p-3 rounded-xl bg-ink-950 border border-bone-50/10">
            <p class="font-micro text-[9.5px] sm:text-[10px] text-moss-400 uppercase tracking-wider font-semibold">Verified Proof / Ground Truth:</p>
            <p class="text-[11px] sm:text-xs text-bone-400 mt-0.5 leading-relaxed" id="inspector-evidence">
              Hermetic QEMU harnesses and zero-copy user-space memory inspectors.
            </p>
          </div>

          <!-- Connected Nodes Strip -->
          <div class="mt-2.5 pt-2.5 border-t border-bone-50/10">
            <p class="font-micro text-[9.5px] sm:text-[10px] text-bone-500 uppercase tracking-wider mb-1.5">Connected Dependencies &amp; Edges:</p>
            <div class="flex flex-wrap gap-1.5" id="inspector-connected-nodes">
              <!-- Populated dynamically via JS -->
            </div>
          </div>

          <div class="mt-2 flex items-center justify-between text-[10px] font-micro text-bone-500">
            <span id="inspector-connections-count">2 Direct Connections</span>
            <a href="#" id="inspector-artifact-link" class="text-ember-400 hover:underline hidden">Open Spec Sheet ↗</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- VIEW 2: Small Cards Matrix (Accessible Categorized Grid) -->
  <div id="obsidian-grid-view" class="hidden space-y-8">
    {clusterList.map((cluster) => {
      const clusterNodes = techNodes.filter((n) => n.cluster === cluster.id);
      return (
        <div class="cluster-group space-y-4" data-group-cluster={cluster.id}>
          <div class="flex items-center gap-2.5 pb-2 border-b border-bone-50/10">
            <span class="w-3 h-3 rounded-full shrink-0" style={`background-color: ${cluster.color};`}></span>
            <h4 class="font-display text-lg sm:text-xl text-bone-50 font-semibold">{cluster.name}</h4>
            <span class="font-micro text-xs text-bone-500">({clusterNodes.length} Nodes)</span>
            <span class="text-xs text-bone-400 hidden sm:inline ml-auto">{cluster.description}</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {clusterNodes.map((node) => {
              const connectedEdges = techEdges.filter((e) => e.source === node.id || e.target === node.id);
              return (
                <div
                  id={`grid-node-${node.id}`}
                  class="obsidian-small-card card card-glare p-5 flex flex-col justify-between border-t-2 transition-all"
                  style={`border-top-color: ${cluster.color};`}
                  data-card-node={node.id}
                  data-card-cluster={node.cluster}
                  data-card-label={node.label}
                  data-card-summary={node.summary}
                >
                  <div>
                    <div class="flex items-center justify-between gap-2 mb-2">
                      <span class="font-micro text-[10px] font-bold uppercase tracking-wider text-bone-400">{cluster.name}</span>
                      <span class="chip !text-[9px] !py-0.5 !px-2 bg-ink-950 border-bone-50/10 text-brass-400">{node.level}</span>
                    </div>

                    <h5 class="display text-base text-bone-50 font-semibold mb-1.5">{node.label}</h5>
                    <p class="text-xs text-bone-300 leading-relaxed mb-3">{node.summary}</p>

                    <div class="p-2.5 rounded-lg bg-ink-950 border border-bone-50/10 mb-3">
                      <span class="font-micro text-[9px] text-moss-400 uppercase tracking-wider block font-semibold">Evidence / Rig Test:</span>
                      <p class="text-[11px] text-bone-400 mt-0.5 leading-relaxed">{node.evidence}</p>
                    </div>
                  </div>

                  <div class="mt-3 pt-3 border-t border-bone-50/10">
                    <span class="font-micro text-[9px] text-bone-500 uppercase tracking-wider block mb-1.5">Connected Graph Nodes ({connectedEdges.length}):</span>
                    <div class="flex flex-wrap gap-1">
                      {connectedEdges.map((e) => {
                        const otherId = e.source === node.id ? e.target : e.source;
                        const otherNode = techNodes.find((n) => n.id === otherId);
                        return otherNode ? (
                          <button
                            type="button"
                            class="grid-neighbor-chip chip !text-[9px] !py-0.5 !px-2 bg-ink-950/80 border-bone-50/10 hover:border-ember-400/50 text-bone-300 hover:text-ember-300 transition-colors cursor-pointer text-left"
                            data-target-id={otherId}
                            title={`${e.relation} (Click to focus)`}
                          >
                            ↔ {otherNode.label}
                          </button>
                        ) : null;
                      })}
                    </div>
                    {node.artifactUrl && (
                      <a href={node.artifactUrl} class="mt-3 inline-flex items-center gap-1 font-micro text-[10px] text-ember-400 hover:underline">
                        <span>View System Spec / Disclosure</span>
                        <span>↗</span>
                      </a>
                    )}
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      );
    })}
  </div>
</div>

<script is:inline define:vars={{ techNodesData: techNodes, techEdgesData: techEdges, clustersData: graphClusters }}>
  (function () {
    let animId = null;
    let isRunning = true;
    let resizeObserver = null;
    let abortController = null;

    function cleanup() {
      if (animId) {
        cancelAnimationFrame(animId);
        animId = null;
      }
      if (resizeObserver) {
        resizeObserver.disconnect();
        resizeObserver = null;
      }
      if (abortController) {
        abortController.abort();
        abortController = null;
      }
      isRunning = false;
    }

    function initObsidianGraph() {
      cleanup();

      const canvas = document.getElementById('obsidian-canvas');
      if (!canvas) return;

      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      isRunning = true;
      abortController = new AbortController();
      const signal = abortController.signal;

      // View toggle buttons
      const btnGraph = document.getElementById('btn-view-graph');
      const btnGrid = document.getElementById('btn-view-grid');
      const graphView = document.getElementById('obsidian-graph-view');
      const gridView = document.getElementById('obsidian-grid-view');

      if (btnGraph && btnGrid && graphView && gridView) {
        btnGraph.onclick = () => {
          btnGraph.classList.add('bg-bone-50/10', 'text-ember-400');
          btnGraph.classList.remove('text-bone-400');
          btnGraph.setAttribute('aria-selected', 'true');

          btnGrid.classList.remove('bg-bone-50/10', 'text-ember-400');
          btnGrid.classList.add('text-bone-400');
          btnGrid.setAttribute('aria-selected', 'false');

          graphView.classList.remove('hidden');
          gridView.classList.add('hidden');
          resize();
        };

        btnGrid.onclick = () => {
          btnGrid.classList.add('bg-bone-50/10', 'text-ember-400');
          btnGrid.classList.remove('text-bone-400');
          btnGrid.setAttribute('aria-selected', 'true');

          btnGraph.classList.remove('bg-bone-50/10', 'text-ember-400');
          btnGraph.classList.add('text-bone-400');
          btnGraph.setAttribute('aria-selected', 'false');

          gridView.classList.remove('hidden');
          graphView.classList.add('hidden');
          applyGridFilter();
        };
      }

      // Graph data clone
      const nodes = techNodesData.map((n, i) => {
        const angle = (i / techNodesData.length) * Math.PI * 2;
        const radius = 175 + (i % 4) * 45;
        return {
          ...n,
          x: Math.cos(angle) * radius,
          y: Math.sin(angle) * radius,
          vx: (Math.random() - 0.5) * 0.4,
          vy: (Math.random() - 0.5) * 0.4,
          radius: 12 + ((techEdgesData.filter(e => e.source === n.id || e.target === n.id).length) * 1.5),
          color: (clustersData[n.cluster] && clustersData[n.cluster].color) || '#ff7a45',
        };
      });

      const edges = techEdgesData.map(e => ({
        ...e,
        sourceNode: nodes.find(n => n.id === e.source),
        targetNode: nodes.find(n => n.id === e.target),
      })).filter(e => e.sourceNode && e.targetNode);

      let width = 800;
      let height = 600;
      let dpr = window.devicePixelRatio || 1;

      // Transform state (Pan & Zoom)
      let transform = {
        x: width / 2,
        y: height / 2,
        scale: 1,
      };

      function resize() {
        const rect = canvas.getBoundingClientRect();
        if (rect.width === 0 || rect.height === 0) return;
        width = rect.width;
        height = rect.height;
        dpr = window.devicePixelRatio || 1;
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        if (transform.x === 0 || Math.abs(transform.x - width / 2) > width) {
          transform.x = width / 2;
          transform.y = height / 2;
        }
      }

      resize();

      // Observe container size changes (fixes hidden tab initialization)
      const graphContainer = document.getElementById('obsidian-graph-component');
      if (window.ResizeObserver && graphContainer) {
        resizeObserver = new ResizeObserver((entries) => {
          for (let entry of entries) {
            if (entry.contentRect.width > 0 && entry.contentRect.height > 0) {
              resize();
            }
          }
        });
        resizeObserver.observe(graphContainer);
      }

      window.addEventListener('resize', resize, { signal });

      let hoveredNode = null;
      let selectedNode = nodes[0];
      let draggedNode = null;
      let isPanning = false;
      let panStart = { x: 0, y: 0 };
      let activeCluster = 'all';
      let searchQuery = '';
      let initialPinchDist = null;
      let initialScale = 1;

      // Inspector DOM elements
      const inspector = document.getElementById('obsidian-node-inspector');
      const inspTitle = document.getElementById('inspector-title');
      const inspClusterDot = document.getElementById('inspector-cluster-dot');
      const inspClusterName = document.getElementById('inspector-cluster-name');
      const inspLevel = document.getElementById('inspector-level');
      const inspSummary = document.getElementById('inspector-summary');
      const inspEvidence = document.getElementById('inspector-evidence');
      const inspConnected = document.getElementById('inspector-connected-nodes');
      const inspCount = document.getElementById('inspector-connections-count');
      const inspArtifact = document.getElementById('inspector-artifact-link');
      const inspClose = document.getElementById('inspector-close-btn');
      const inspMin = document.getElementById('inspector-min-btn');
      const inspBody = document.getElementById('inspector-body');

      let isMinimized = false;

      if (inspClose) {
        inspClose.onclick = () => {
          if (inspector) inspector.classList.add('opacity-0', 'pointer-events-none');
        };
      }

      if (inspMin && inspBody) {
        inspMin.onclick = () => {
          isMinimized = !isMinimized;
          inspBody.classList.toggle('hidden', isMinimized);
          inspMin.textContent = isMinimized ? '▲' : '_';
        };
      }

      function updateInspector(node) {
        if (!node || !inspector) return;
        inspector.classList.remove('opacity-0', 'pointer-events-none');
        if (isMinimized && inspBody && inspMin) {
          isMinimized = false;
          inspBody.classList.remove('hidden');
          inspMin.textContent = '_';
        }

        if (inspTitle) inspTitle.textContent = node.label;
        if (inspClusterDot) inspClusterDot.style.backgroundColor = node.color;
        if (inspClusterName) {
          const c = clustersData[node.cluster];
          inspClusterName.textContent = c ? c.name : node.cluster;
        }
        if (inspLevel) inspLevel.textContent = node.level;
        if (inspSummary) inspSummary.textContent = node.summary;
        if (inspEvidence) inspEvidence.textContent = node.evidence;

        const incidentEdges = edges.filter(e => e.source === node.id || e.target === node.id);
        if (inspCount) inspCount.textContent = `${incidentEdges.length} Connected Dependencies`;

        if (inspConnected) {
          inspConnected.innerHTML = '';
          incidentEdges.forEach(e => {
            const other = e.source === node.id ? e.targetNode : e.sourceNode;
            if (!other) return;
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'chip !text-[10px] !py-0.5 !px-2 bg-ink-950 border-bone-50/10 hover:border-ember-400 text-bone-200 cursor-pointer transition-colors';
            btn.textContent = `↔ ${other.label}`;
            btn.title = e.relation;
            btn.onclick = (ev) => {
              ev.stopPropagation();
              selectedNode = other;
              updateInspector(other);
              transform.x = width / 2 - other.x * transform.scale;
              transform.y = height / 2 - other.y * transform.scale;
            };
            inspConnected.appendChild(btn);
          });
        }

        if (inspArtifact) {
          if (node.artifactUrl) {
            inspArtifact.href = node.artifactUrl;
            inspArtifact.classList.remove('hidden');
          } else {
            inspArtifact.classList.add('hidden');
          }
        }
      }

      updateInspector(selectedNode);

      // Grid view dynamic filtering
      function applyGridFilter() {
        const groups = document.querySelectorAll('.cluster-group');
        const cards = document.querySelectorAll('.obsidian-small-card');

        cards.forEach(card => {
          const cardCluster = card.getAttribute('data-card-cluster');
          const cardLabel = (card.getAttribute('data-card-label') || '').toLowerCase();
          const cardSummary = (card.getAttribute('data-card-summary') || '').toLowerCase();

          const matchesCluster = activeCluster === 'all' || cardCluster === activeCluster;
          const matchesSearch = !searchQuery || cardLabel.includes(searchQuery) || cardSummary.includes(searchQuery);

          if (matchesCluster && matchesSearch) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });

        groups.forEach(group => {
          const groupCluster = group.getAttribute('data-group-cluster');
          const visibleCards = group.querySelectorAll('.obsidian-small-card[style*="display: flex"]');
          if ((activeCluster === 'all' || groupCluster === activeCluster) && visibleCards.length > 0) {
            group.style.display = 'block';
          } else {
            group.style.display = 'none';
          }
        });
      }

      // Cluster filter buttons
      document.querySelectorAll('.cluster-filter-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.cluster-filter-btn').forEach(b => {
            b.classList.remove('active', 'bg-bone-50/10', 'text-bone-50', 'border-bone-50/20');
            b.classList.add('text-bone-400', 'bg-ink-950/70', 'border-bone-50/5');
          });
          btn.classList.add('active', 'bg-bone-50/10', 'text-bone-50', 'border-bone-50/20');
          btn.classList.remove('text-bone-400', 'bg-ink-950/70', 'border-bone-50/5');
          activeCluster = btn.getAttribute('data-cluster') || 'all';
          applyGridFilter();
        }, { signal });
      });

      // Search input
      const searchInput = document.getElementById('obsidian-search-input');
      if (searchInput) {
        searchInput.addEventListener('input', (e) => {
          searchQuery = e.target.value.trim().toLowerCase();
          applyGridFilter();
        }, { signal });
      }

      // Grid neighbor chips
      document.querySelectorAll('.grid-neighbor-chip').forEach(chip => {
        chip.addEventListener('click', () => {
          const targetId = chip.getAttribute('data-target-id');
          if (!targetId) return;
          const targetCard = document.getElementById(`grid-node-${targetId}`);
          if (targetCard) {
            targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            targetCard.classList.add('ring-2', 'ring-ember-500');
            setTimeout(() => {
              targetCard.classList.remove('ring-2', 'ring-ember-500');
            }, 1800);
          }
        }, { signal });
      });

      // HUD zoom & controls
      const btnZoomIn = document.getElementById('graph-zoom-in');
      const btnZoomOut = document.getElementById('graph-zoom-out');
      const btnReset = document.getElementById('graph-reset');
      const btnPause = document.getElementById('graph-pause');

      if (btnZoomIn) btnZoomIn.onclick = () => { transform.scale = Math.min(2.5, transform.scale * 1.25); };
      if (btnZoomOut) btnZoomOut.onclick = () => { transform.scale = Math.max(0.4, transform.scale / 1.25); };
      if (btnReset) btnReset.onclick = () => {
        transform.scale = 1;
        transform.x = width / 2;
        transform.y = height / 2;
      };
      if (btnPause) {
        btnPause.onclick = () => {
          isRunning = !isRunning;
          btnPause.textContent = isRunning ? 'Pause' : 'Play';
          if (isRunning) requestAnimationFrame(loop);
        };
      }

      function toGraphCoords(clientX, clientY) {
        const rect = canvas.getBoundingClientRect();
        const screenX = clientX - rect.left;
        const screenY = clientY - rect.top;
        return {
          x: (screenX - transform.x) / transform.scale,
          y: (screenY - transform.y) / transform.scale,
        };
      }

      function findNodeAt(gX, gY) {
        for (let i = nodes.length - 1; i >= 0; i--) {
          const n = nodes[i];
          const distSq = (n.x - gX) * (n.x - gX) + (n.y - gY) * (n.y - gY);
          if (distSq <= (n.radius + 8) * (n.radius + 8)) {
            return n;
          }
        }
        return null;
      }

      // Mouse Listeners
      canvas.addEventListener('mousedown', (e) => {
        const pos = toGraphCoords(e.clientX, e.clientY);
        const hit = findNodeAt(pos.x, pos.y);
        if (hit) {
          draggedNode = hit;
          selectedNode = hit;
          updateInspector(hit);
        } else {
          isPanning = true;
          panStart = { x: e.clientX - transform.x, y: e.clientY - transform.y };
        }
      }, { signal });

      window.addEventListener('mousemove', (e) => {
        if (draggedNode) {
          const pos = toGraphCoords(e.clientX, e.clientY);
          draggedNode.x = pos.x;
          draggedNode.y = pos.y;
          draggedNode.vx = 0;
          draggedNode.vy = 0;
          return;
        }

        if (isPanning) {
          transform.x = e.clientX - panStart.x;
          transform.y = e.clientY - panStart.y;
          return;
        }

        const pos = toGraphCoords(e.clientX, e.clientY);
        hoveredNode = findNodeAt(pos.x, pos.y);
        canvas.style.cursor = hoveredNode ? 'pointer' : 'grab';
      }, { signal });

      window.addEventListener('mouseup', () => {
        draggedNode = null;
        isPanning = false;
      }, { signal });

      canvas.addEventListener('wheel', (e) => {
        e.preventDefault();
        const zoomFactor = e.deltaY < 0 ? 1.1 : 0.9;
        const rect = canvas.getBoundingClientRect();
        const mouseX = e.clientX - rect.left;
        const mouseY = e.clientY - rect.top;

        const newScale = Math.min(2.5, Math.max(0.4, transform.scale * zoomFactor));
        transform.x = mouseX - (mouseX - transform.x) * (newScale / transform.scale);
        transform.y = mouseY - (mouseY - transform.y) * (newScale / transform.scale);
        transform.scale = newScale;
      }, { passive: false, signal });

      // Touch & Pinch-to-zoom handlers
      canvas.addEventListener('touchstart', (e) => {
        if (e.touches.length === 1) {
          const t = e.touches[0];
          const pos = toGraphCoords(t.clientX, t.clientY);
          const hit = findNodeAt(pos.x, pos.y);
          if (hit) {
            draggedNode = hit;
            selectedNode = hit;
            updateInspector(hit);
            e.preventDefault();
          } else {
            isPanning = true;
            panStart = { x: t.clientX - transform.x, y: t.clientY - transform.y };
          }
        } else if (e.touches.length === 2) {
          isPanning = false;
          draggedNode = null;
          const dx = e.touches[0].clientX - e.touches[1].clientX;
          const dy = e.touches[0].clientY - e.touches[1].clientY;
          initialPinchDist = Math.hypot(dx, dy);
          initialScale = transform.scale;
          e.preventDefault();
        }
      }, { passive: false, signal });

      canvas.addEventListener('touchmove', (e) => {
        if (e.touches.length === 1) {
          const t = e.touches[0];
          if (draggedNode) {
            e.preventDefault();
            const pos = toGraphCoords(t.clientX, t.clientY);
            draggedNode.x = pos.x;
            draggedNode.y = pos.y;
            draggedNode.vx = 0;
            draggedNode.vy = 0;
          } else if (isPanning) {
            transform.x = t.clientX - panStart.x;
            transform.y = t.clientY - panStart.y;
          }
        } else if (e.touches.length === 2 && initialPinchDist) {
          e.preventDefault();
          const dx = e.touches[0].clientX - e.touches[1].clientX;
          const dy = e.touches[0].clientY - e.touches[1].clientY;
          const currentDist = Math.hypot(dx, dy);
          const factor = currentDist / initialPinchDist;
          transform.scale = Math.min(2.5, Math.max(0.4, initialScale * factor));
        }
      }, { passive: false, signal });

      canvas.addEventListener('touchend', () => {
        draggedNode = null;
        isPanning = false;
        initialPinchDist = null;
      }, { signal });

      // Physics update
      function updatePhysics() {
        if (!isRunning) return;

        // Anti-collision repulsion
        for (let i = 0; i < nodes.length; i++) {
          for (let j = i + 1; j < nodes.length; j++) {
            const n1 = nodes[i];
            const n2 = nodes[j];
            let dx = n2.x - n1.x;
            let dy = n2.y - n1.y;
            let distSq = dx * dx + dy * dy + 0.01;
            let dist = Math.sqrt(distSq);

            if (dist < 260) {
              let force = (260 - dist) / 260;
              let fx = (dx / dist) * force * 1.8;
              let fy = (dy / dist) * force * 1.8;
              if (n1 !== draggedNode) { n1.vx -= fx; n1.vy -= fy; }
              if (n2 !== draggedNode) { n2.vx += fx; n2.vy += fy; }
            }
          }
        }

        // Spring attraction
        for (let i = 0; i < edges.length; i++) {
          const e = edges[i];
          const n1 = e.sourceNode;
          const n2 = e.targetNode;
          let dx = n2.x - n1.x;
          let dy = n2.y - n1.y;
          let dist = Math.sqrt(dx * dx + dy * dy) || 1;
          let ideal = 110;
          let force = (dist - ideal) * 0.022;

          let fx = (dx / dist) * force;
          let fy = (dy / dist) * force;

          if (n1 !== draggedNode) { n1.vx += fx; n1.vy += fy; }
          if (n2 !== draggedNode) { n2.vx += fx; n2.vy += fy; }
        }

        // Center gravity & dampening
        for (let i = 0; i < nodes.length; i++) {
          const n = nodes[i];
          if (n === draggedNode) continue;

          n.vx -= n.x * 0.0025;
          n.vy -= n.y * 0.0025;

          n.vx *= 0.86;
          n.vy *= 0.86;

          n.x += n.vx;
          n.y += n.vy;
        }
      }

      // Draw loop
      function loop() {
        if (!isRunning) return;

        updatePhysics();

        ctx.clearRect(0, 0, width, height);

        ctx.save();
        ctx.translate(transform.x, transform.y);
        ctx.scale(transform.scale, transform.scale);

        // Background subtle grid stars
        ctx.fillStyle = 'rgba(237, 232, 220, 0.04)';
        for (let gx = -600; gx <= 600; gx += 60) {
          for (let gy = -600; gy <= 600; gy += 60) {
            ctx.beginPath();
            ctx.arc(gx, gy, 1, 0, Math.PI * 2);
            ctx.fill();
          }
        }

        const activeNode = hoveredNode || selectedNode;

        // Draw Edges
        for (let i = 0; i < edges.length; i++) {
          const e = edges[i];
          const n1 = e.sourceNode;
          const n2 = e.targetNode;

          const isConnectedToActive = activeNode && (e.source === activeNode.id || e.target === activeNode.id);

          ctx.beginPath();
          ctx.moveTo(n1.x, n1.y);
          ctx.lineTo(n2.x, n2.y);

          if (isConnectedToActive) {
            ctx.strokeStyle = 'rgba(255, 122, 69, 0.75)';
            ctx.lineWidth = 2.2 / transform.scale;
            ctx.shadowColor = '#ff4d1c';
            ctx.shadowBlur = 8;
          } else {
            ctx.strokeStyle = 'rgba(237, 232, 220, 0.12)';
            ctx.lineWidth = 1 / transform.scale;
            ctx.shadowBlur = 0;
          }
          ctx.stroke();
          ctx.shadowBlur = 0;
        }

        // Draw Nodes
        for (let i = 0; i < nodes.length; i++) {
          const n = nodes[i];

          const matchesCluster = activeCluster === 'all' || n.cluster === activeCluster;
          const matchesSearch = !searchQuery || n.label.toLowerCase().includes(searchQuery) || n.summary.toLowerCase().includes(searchQuery);
          const isDimmed = !matchesCluster || !matchesSearch;

          const isHovered = n === hoveredNode;
          const isSelected = n === selectedNode;
          const isConnected = activeNode && edges.some(e =>
            (e.source === activeNode.id && e.target === n.id) ||
            (e.target === activeNode.id && e.source === n.id)
          );

          ctx.save();
          if (isDimmed) {
            ctx.globalAlpha = 0.18;
          }

          if (isHovered || isSelected || isConnected) {
            ctx.beginPath();
            ctx.arc(n.x, n.y, n.radius + 6, 0, Math.PI * 2);
            ctx.fillStyle = isSelected ? 'rgba(255, 77, 28, 0.25)' : 'rgba(237, 232, 220, 0.15)';
            ctx.fill();
          }

          ctx.beginPath();
          ctx.arc(n.x, n.y, n.radius, 0, Math.PI * 2);
          ctx.fillStyle = n.color;
          if (isSelected || isHovered) {
            ctx.shadowColor = n.color;
            ctx.shadowBlur = 14;
          }
          ctx.fill();
          ctx.shadowBlur = 0;

          // Inner pin dot
          ctx.beginPath();
          ctx.arc(n.x, n.y, 3, 0, Math.PI * 2);
          ctx.fillStyle = '#0c0c0b';
          ctx.fill();

          // Label text
          ctx.font = `${isHovered || isSelected ? 'bold 11px' : '10px'} "JetBrains Mono", monospace`;
          ctx.textAlign = 'center';
          ctx.textBaseline = 'top';
          ctx.fillStyle = isSelected ? '#ff7a45' : isHovered ? '#ede8dc' : 'rgba(237, 232, 220, 0.8)';
          ctx.fillText(n.label, n.x, n.y + n.radius + 4);

          ctx.restore();
        }

        ctx.restore();

        if (isRunning) {
          animId = requestAnimationFrame(loop);
        }
      }

      animId = requestAnimationFrame(loop);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initObsidianGraph);
    } else {
      initObsidianGraph();
    }
    document.addEventListener('astro:page-load', initObsidianGraph);
    document.addEventListener('astro:before-swap', cleanup);
  })();
</script>
