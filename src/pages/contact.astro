---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { profile } from '../data/profile';
import { collab } from '../data/collab';
---

<BaseLayout
  title="Contact & Scoped Engagements — Aayush Bankar"
  description="Numbered, scoped security research and verifiable systems engagements — evidence first, claims never."
>
  <div class="wrap-wide py-10 sm:py-16">
    <!-- ═══════════════════════════════════════════════════════════════
         HEADER — Direct & Confident
         ═══════════════════════════════════════════════════════════════ -->
    <header class="mb-14 sm:mb-20 rise">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <p class="eyebrow !mb-0">
          <span class="tick">CNT–00</span>
          <span>Open Channel · Scoped Collaborations</span>
        </p>
        <div class="flex items-center gap-2">
          <span class="chip chip-brass">
            <span class="w-1.5 h-1.5 rounded-full bg-moss-500 animate-pulse"></span>
            {collab.availability.status}
          </span>
        </div>
      </div>

      <h1 class="display text-4xl sm:text-5xl lg:text-6xl text-bone-50 leading-[1.04]">
        Have a system that <em class="text-ember-400">needs proof?</em>
      </h1>
      <p class="font-display italic text-lg sm:text-xl text-bone-200 mt-3 leading-snug">
        Numbered, scoped, and verifiable — no vague retainers; only empirical deliverables with test logs.
      </p>
      <p class="lede mt-3.5 max-w-2xl text-sm sm:text-base text-bone-400 leading-relaxed">
        {collab.subheadline} Available for discrete offensive vulnerability audits, kernel race condition reproductions,
        and high-throughput systems engineering.
      </p>
    </header>

    <!-- ═══════════════════════════════════════════════════════════════
         INTERACTIVE AVAILABILITY & 1-CLICK COPY STATION (Framer-Style)
         ═══════════════════════════════════════════════════════════════ -->
    <section class="card card-glare p-8 sm:p-10 border-l-4 border-l-brass-500 mb-14 sm:mb-20" data-reveal>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7">
          <div class="flex items-center gap-2.5 mb-3 font-micro text-xs">
            <span class="w-2.5 h-2.5 rounded-full bg-moss-500 animate-pulse shadow-[0_0_10px_rgba(52,211,153,0.6)]"></span>
            <span class="uppercase tracking-widest text-brass-400 font-semibold">{collab.availability.status}</span>
            <span class="text-bone-600">·</span>
            <span class="text-bone-400" data-ist-clock>--:-- IST</span>
          </div>

          <h2 class="display text-2xl sm:text-3xl text-bone-50 mb-3">
            Direct Line: Security Audits &amp; Systems Work
          </h2>
          <p class="text-sm sm:text-base text-bone-300 leading-relaxed max-w-2xl">
            {collab.availability.note}
          </p>

          <div class="flex flex-wrap items-center gap-4 mt-5 text-xs font-micro text-bone-400">
            <span class="flex items-center gap-1.5">
              <span class="text-ember-400">📍</span> Gandhinagar, Gujarat (IST, UTC+5:30)
            </span>
            <span class="flex items-center gap-1.5">
              <span class="text-brass-400">⚡</span> Response time: within 24 hours
            </span>
          </div>
        </div>

        <!-- 1-Click Interactive Email Copy & Message Actions -->
        <div class="lg:col-span-5 flex flex-col gap-3">
          <!-- Copy to Clipboard Button -->
          <button
            type="button"
            id="copy-email-btn"
            class="group w-full p-4 rounded-2xl bg-ink-950 border border-bone-50/15 hover:border-ember-500/50 hover:bg-ink-850 transition-all text-left flex items-center justify-between cursor-pointer"
            aria-label="Copy email address to clipboard"
          >
            <div>
              <span class="font-micro text-[10px] tracking-wider uppercase text-bone-500 block">Direct Inquiry Email</span>
              <span class="font-mono text-sm sm:text-base text-bone-50 group-hover:text-ember-400 transition-colors font-medium mt-0.5 block" id="copy-email-text">
                {profile.email}
              </span>
            </div>
            <span class="chip chip-brass shrink-0 text-[10px] font-semibold transition-all" id="copy-badge">
              Click to Copy 📋
            </span>
          </button>

          <!-- Alternative Direct Actions -->
          <div class="grid grid-cols-2 gap-3">
            <a href={`mailto:${profile.email}`} class="btn btn-primary text-center justify-center !text-xs">
              Open Mail App ↗
            </a>
            <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-ghost text-center justify-center !text-xs">
              LinkedIn InMail ↗
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         NUMBERED ENGAGEMENT SCOPES
         ═══════════════════════════════════════════════════════════════ -->
    <section class="mb-14 sm:mb-20" data-reveal>
      <SectionHeading index="01" eyebrow="Engagement Scopes" title="Three Structured <em>Tracks.</em>">
        <p slot="lede" class="lede">
          Clear deliverables, predictable milestones, and zero ambiguity. Here is how we structure technical engagements.
        </p>
      </SectionHeading>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
        {collab.services.map((service) => (
          <article class="card card-glare p-7 sm:p-8 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-3 mb-4">
                <span class="font-micro text-xs text-ember-400 tracking-widest font-semibold">[{service.index}]</span>
                <span class="chip font-micro text-[10px]">{service.timeline}</span>
              </div>

              <h3 class="display text-xl text-bone-50 mb-3">{service.title}</h3>
              <p class="text-xs sm:text-sm text-bone-400 leading-relaxed mb-6">
                {service.scope}
              </p>

              <div class="pt-4 border-t border-bone-50/10">
                <p class="font-micro text-[10px] tracking-wider uppercase text-bone-500 mb-2.5">Key Deliverables:</p>
                <ul class="space-y-2 text-xs text-bone-300 font-sans">
                  {service.deliverables.map((d) => (
                    <li class="flex items-start gap-2">
                      <span class="text-ember-400 font-bold shrink-0">›</span>
                      <span class="leading-relaxed">{d}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-bone-50/10 flex items-center justify-between font-micro text-xs">
              <span class="text-bone-500">Formal Verification</span>
              <a href={`mailto:${profile.email}?subject=Inquiry:%20${encodeURIComponent(service.title)}`} class="link-sweep text-ember-400 uppercase tracking-wider">
                Initiate Scope →
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         ENGAGEMENT WORKFLOW — 4-Phase Delivery Contract
         ═══════════════════════════════════════════════════════════════ -->
    <section class="mb-14 sm:mb-20" data-reveal>
      <SectionHeading index="02" eyebrow="Workflow Integrity" title="How Engagements <em>Execute.</em>">
        <p slot="lede" class="lede">
          A transparent 4-stage engineering lifecycle from initial scope definition to verified proof delivery.
        </p>
      </SectionHeading>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-8">
        <div class="p-6 rounded-2xl bg-ink-900/60 border border-bone-50/10">
          <span class="font-display italic text-2xl text-ember-400">01</span>
          <h4 class="font-display text-base text-bone-50 mt-2 mb-1.5">Scope &amp; Non-Goals</h4>
          <p class="text-xs text-bone-400 leading-relaxed">
            Explicit technical contracts and boundaries agreed upfront. Eliminates scope creep and guarantees clarity.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-ink-900/60 border border-bone-50/10">
          <span class="font-display italic text-2xl text-brass-400">02</span>
          <h4 class="font-display text-base text-bone-50 mt-2 mb-1.5">Hermetic Test Harness</h4>
          <p class="text-xs text-bone-400 leading-relaxed">
            Target conditions reproduced deterministically inside isolated QEMU VMs or microbenchmarks before implementation.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-ink-900/60 border border-bone-50/10">
          <span class="font-display italic text-2xl text-moss-500">03</span>
          <h4 class="font-display text-base text-bone-50 mt-2 mb-1.5">Empirical Evidence</h4>
          <p class="text-xs text-bone-400 leading-relaxed">
            All milestones accompanied by verifiable test traces, memory dumps, or flamegraphs committed to the audit ledger.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-ink-900/60 border border-bone-50/10">
          <span class="font-display italic text-2xl text-bone-200">04</span>
          <h4 class="font-display text-base text-bone-50 mt-2 mb-1.5">Actionable Delivery</h4>
          <p class="text-xs text-bone-400 leading-relaxed">
            Complete technical documentation, reproduction scripts, mitigation advisories, and knowledge transfer provided.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         DIRECT CHANNELS & SECURITY COORDINATES
         ═══════════════════════════════════════════════════════════════ -->
    <section class="card p-8 sm:p-10" data-reveal>
      <SectionHeading index="03" eyebrow="Direct Channels" title="Connect <em>Directly.</em>" />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6 font-micro text-xs">
        <a
          href={`mailto:${profile.email}`}
          class="p-5 rounded-xl bg-ink-950 border border-bone-50/10 hover:border-ember-500 transition-colors group block"
        >
          <span class="text-bone-500 block uppercase tracking-wider text-[10px]">Primary Channel</span>
          <span class="text-bone-100 font-semibold text-sm group-hover:text-ember-400 transition-colors mt-1 block truncate">
            {profile.email}
          </span>
          <span class="text-bone-500 mt-2 block text-[11px]">Direct inbox · PGP on request</span>
        </a>

        <a
          href={profile.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="p-5 rounded-xl bg-ink-950 border border-bone-50/10 hover:border-ember-500 transition-colors group block"
        >
          <span class="text-bone-500 block uppercase tracking-wider text-[10px]">Professional Network</span>
          <span class="text-bone-100 font-semibold text-sm group-hover:text-ember-400 transition-colors mt-1 block">
            LinkedIn Profile ↗
          </span>
          <span class="text-bone-500 mt-2 block text-[11px]">in/aayushbankar</span>
        </a>

        <a
          href={profile.github}
          target="_blank"
          rel="noopener noreferrer"
          class="p-5 rounded-xl bg-ink-950 border border-bone-50/10 hover:border-ember-500 transition-colors group block"
        >
          <span class="text-bone-500 block uppercase tracking-wider text-[10px]">Open Repositories</span>
          <span class="text-bone-100 font-semibold text-sm group-hover:text-ember-400 transition-colors mt-1 block">
            GitHub Telemetry ↗
          </span>
          <span class="text-bone-500 mt-2 block text-[11px]">github.com/Aayushbankar</span>
        </a>
      </div>
    </section>
  </div>

  <!-- Client-side script for 1-click email copying -->
  <script is:inline>
    (function () {
      function setupEmailCopy() {
        var btn = document.getElementById('copy-email-btn');
        var badge = document.getElementById('copy-badge');
        var email = 'aayushbankar42@gmail.com';

        if (!btn || !badge) return;

        btn.addEventListener('click', function () {
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(email).then(function () {
              badge.textContent = 'Copied to Clipboard! ✓';
              badge.className = 'chip chip-ember shrink-0 text-[10px] font-semibold transition-all';
              setTimeout(function () {
                badge.textContent = 'Click to Copy 📋';
                badge.className = 'chip chip-brass shrink-0 text-[10px] font-semibold transition-all';
              }, 2500);
            });
          } else {
            // Fallback for older browsers
            window.location.href = 'mailto:' + email;
          }
        });
      }

      document.addEventListener('astro:page-load', setupEmailCopy);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupEmailCopy);
      } else {
        setupEmailCopy();
      }
    })();
  </script>
</BaseLayout>
