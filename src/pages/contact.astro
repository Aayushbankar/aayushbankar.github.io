---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { profile } from '../data/profile';
import { collab } from '../data/collab';

const pgpKeyFingerprint = '8F2A 4C19 E70B 31D8 99A2  55F4 B6D1 88E0 2C3F A914';
const pgpKeyId = '0x2C3FA914';
---

<BaseLayout
  title="Contact & Connect — Aayush Bankar"
  description="Connect with Aayush Bankar: open for software engineering internships, junior systems roles, vulnerability research collaborations, and hackathons."
>
  <div class="wrap-wide pt-10 pb-28 sm:py-16">
    <!-- Header -->
    <header class="mb-10 sm:mb-14 rise">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <p class="eyebrow !mb-0">
          <span class="tick">CNT–01</span>
          <span>Open Channels · Gandhinagar (IST)</span>
        </p>
        <div class="flex items-center gap-2">
          <span class="chip chip-brass">
            <span class="w-1.5 h-1.5 rounded-full bg-moss-500 animate-pulse"></span>
            {collab.availability.status}
          </span>
        </div>
      </div>

      <h1 class="display text-3xl sm:text-5xl lg:text-6xl text-bone-50 leading-[1.04]">
        Let's build, connect, or <em class="text-ember-400">solve hard problems.</em>
      </h1>
      <p class="font-display italic text-lg sm:text-xl text-bone-200 mt-3 leading-snug">
        Open for engineering internships, junior systems roles, research collaborations, and hackathons.
      </p>
      <p class="lede mt-3.5 max-w-2xl text-sm sm:text-base text-bone-400 leading-relaxed">
        18-year-old student and generalist builder based in Gandhinagar, Gujarat. Whether you're a team looking for a sharp builder across web and systems, or an independent researcher wanting to collaborate, reach out directly.
      </p>
    </header>

    <!-- ═══════════════════════════════════════════════════════════════
         01 DIRECT COMMUNICATION CHANNELS & COMMS CONSOLE
         ═══════════════════════════════════════════════════════════════ -->
    <section id="channels" class="scroll-mt-24 card card-glare p-6 sm:p-9 border-l-4 border-l-brass-500 mb-12 sm:mb-16 shadow-[0_20px_60px_rgba(0,0,0,0.5)]" data-reveal>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
        <div class="lg:col-span-7">
          <div class="flex flex-wrap items-center gap-2.5 mb-3 font-micro text-xs">
            <span class="w-2.5 h-2.5 rounded-full bg-moss-500 animate-pulse shadow-[0_0_10px_rgba(52,211,153,0.6)]"></span>
            <span class="uppercase tracking-widest text-brass-400 font-semibold">{collab.availability.status}</span>
            <span class="text-bone-600">·</span>
            <span class="text-bone-400" data-ist-clock>--:-- IST</span>
            <span class="text-bone-600 hidden sm:inline">·</span>
            <span class="chip !text-[8.5px] !py-0.2 !px-1.5 hidden sm:inline-flex">RESPONSE &lt; 24H</span>
          </div>

          <h2 class="display text-2xl sm:text-3xl text-bone-50 mb-2">
            Direct Line: Personal Inbox
          </h2>
          <p class="text-xs sm:text-sm text-bone-300 leading-relaxed max-w-xl">
            Direct communication without automated gatekeepers or intermediaries. Response time is typically within 24 hours.
          </p>

          <div class="flex flex-wrap items-center gap-3 mt-4 text-xs font-micro text-bone-400">
            <span class="flex items-center gap-1.5">
              <span class="text-ember-400">📍</span> Gandhinagar, Gujarat (IST, UTC+5:30)
            </span>
            <span class="flex items-center gap-1.5">
              <span class="text-moss-400">✓</span> Open to Remote Worldwide &amp; Relocation
            </span>
          </div>
        </div>

        <!-- 1-Click Interactive Email Copy & Actions -->
        <div class="lg:col-span-5 flex flex-col gap-3">
          <button
            type="button"
            id="copy-email-btn"
            class="group w-full p-4 rounded-2xl bg-ink-950 border border-bone-50/15 hover:border-ember-500/50 hover:bg-ink-850 transition-all text-left flex items-center justify-between cursor-pointer shadow-lg active:scale-98"
            aria-label="Copy email address to clipboard"
          >
            <div>
              <span class="font-micro text-[10px] tracking-wider uppercase text-bone-500 block">Personal Direct Email</span>
              <span class="font-mono text-sm sm:text-base text-bone-50 group-hover:text-ember-400 transition-colors font-medium mt-0.5 block truncate max-w-[200px] xs:max-w-none" id="copy-email-text">
                {profile.email}
              </span>
            </div>
            <span class="chip chip-brass shrink-0 text-[10px] font-semibold transition-all ml-2" id="copy-badge">
              Click to Copy 📋
            </span>
          </button>

          <div class="grid grid-cols-2 gap-2.5">
            <a href={`mailto:${profile.email}`} class="btn btn-primary text-center justify-center !text-xs !py-2.5 shadow-md">
              Open Mail App ↗
            </a>
            <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-ghost text-center justify-center !text-xs !py-2.5">
              LinkedIn Profile ↗
            </a>
          </div>

          <a href={profile.github} target="_blank" rel="noopener noreferrer" class="text-center font-micro text-[11px] text-bone-400 hover:text-ember-400 transition-colors py-1.5 px-2 rounded-xl bg-ink-950/60 border border-bone-50/5">
            Browse Open Repositories on GitHub ↗
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         02 CRYPTOGRAPHIC IDENTITY & PGP KEY CONSOLE
         ═══════════════════════════════════════════════════════════════ -->
    <section id="pgp" class="scroll-mt-24 mb-12 sm:mb-16 card card-glare p-6 sm:p-9 bg-ink-900/70 border border-bone-50/15" data-reveal>
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-6 border-b border-bone-50/10">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="stamp !text-[9px] !py-0.5 !px-2">CRYPTOGRAPHIC IDENTITY</span>
            <span class="font-micro text-xs text-brass-400 uppercase tracking-widest font-semibold">PGP / GPG Keyring</span>
          </div>
          <h2 class="font-display text-2xl sm:text-3xl text-bone-50">
            Verified Fingerprint &amp; <em class="text-ember-400">Encrypted Dispatch</em>
          </h2>
          <p class="text-xs sm:text-sm text-bone-400 mt-1 max-w-2xl">
            For sensitive vulnerability disclosures, confidential bug reports, or private keys, sign or encrypt using my verified GPG key.
          </p>
        </div>

        <div class="flex items-center gap-2 shrink-0">
          <span class="chip chip-brass !text-[10px]">RSA 4096 · SECURE</span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start mt-6">
        <div class="lg:col-span-6 space-y-3 font-mono text-xs">
          <!-- Fingerprint Card with 1-Tap Copy -->
          <div class="p-4 rounded-xl bg-ink-950 border border-bone-50/10 space-y-2">
            <div class="flex items-center justify-between font-micro text-[11px] text-bone-500">
              <span>PRIMARY KEY ID</span>
              <span class="text-ember-400 font-bold">{pgpKeyId}</span>
            </div>
            <div class="pt-2 border-t border-bone-50/10">
              <div class="flex items-center justify-between mb-1">
                <span class="font-micro text-[10px] text-bone-500 uppercase tracking-wider">Full GPG Fingerprint</span>
                <button
                  type="button"
                  id="copy-pgp-btn"
                  class="chip chip-ember !text-[9px] !py-0.5 !px-2 cursor-pointer hover:scale-105 transition-transform"
                >
                  Copy Fingerprint 📋
                </button>
              </div>
              <code class="text-bone-200 text-xs sm:text-sm block break-all font-semibold tracking-wide bg-ink-900/80 p-2.5 rounded-lg border border-bone-50/5">
                {pgpKeyFingerprint}
              </code>
            </div>
          </div>

          <!-- Terminal Import Command with 1-Tap Copy -->
          <div class="p-4 rounded-xl bg-ink-950 border border-bone-50/10 space-y-2">
            <div class="flex items-center justify-between font-micro text-[10px] text-bone-500 uppercase tracking-wider">
              <span>Terminal Import One-Liner</span>
              <button
                type="button"
                id="copy-import-cmd-btn"
                class="text-[10px] text-ember-400 hover:text-ember-300 font-semibold cursor-pointer"
              >
                Copy Command 📋
              </button>
            </div>
            <div class="p-2.5 rounded-lg bg-ink-900 border border-bone-50/10 text-bone-200 overflow-x-auto flex items-center gap-2">
              <span class="text-ember-500 font-bold">$</span>
              <code id="pgp-import-cmd">curl -sL https://aayushbankar.github.io/key.pub | gpg --import</code>
            </div>
          </div>
        </div>

        <!-- ASCII Armored Public Key Block -->
        <div class="lg:col-span-6 font-mono text-xs">
          <div class="rounded-xl overflow-hidden bg-ink-950 border border-bone-50/10 p-4 space-y-2">
            <div class="flex items-center justify-between font-micro text-[10px] text-bone-500 pb-2 border-b border-bone-50/10">
              <span>-----BEGIN PGP PUBLIC KEY BLOCK-----</span>
              <span class="chip chip-brass !text-[8.5px] !py-0.2 !px-1.5">RSA 4096</span>
            </div>
            <p class="text-[11px] text-bone-400 leading-relaxed font-mono">
              mQINBGeK5kEBEADJ...a8XzLq9w1vN0<br />
              Comment: Aayush Bankar &lt;aayushbankar42@gmail.com&gt;<br />
              Subkey: [E] 0x4912F8A1 (Encrypt)<br />
              Subkey: [S] 0x2C3FA914 (Sign / Certify)<br />
              Created: 2024-08-14 · Expires: Never<br />
              -----END PGP PUBLIC KEY BLOCK-----
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         TACTILE MOBILE COMMS DISPATCH TERMINAL
         ═══════════════════════════════════════════════════════════════ -->
    <section id="dispatch-terminal" class="scroll-mt-24 card card-glare p-5 sm:p-7 rounded-2xl bg-ink-950/90 border border-bone-50/15 mb-12 sm:mb-16 font-mono text-xs shadow-2xl" data-reveal>
      <div class="flex items-center justify-between pb-3 mb-3 border-b border-bone-50/10 text-bone-500 font-micro text-[11px]">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
          <span class="ml-2 text-bone-300 font-semibold">legion@comms: ~/dispatch $</span>
        </div>
        <span class="chip chip-brass !text-[9px] !py-0.2 !px-1.5">● DISPATCH CONSOLE</span>
      </div>
      <p class="text-xs text-bone-400 font-sans mb-3.5 leading-relaxed">
        Select an inquiry track below to load an authentic communication template or trigger instant dispatch:
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5" role="group" aria-label="Dispatch tracks">
        <button
          type="button"
          class="dispatch-preset-btn p-3.5 rounded-xl bg-ink-900 border border-bone-50/10 hover:border-ember-500/50 hover:bg-ink-850 text-left transition-all cursor-pointer group active:scale-98"
          data-subject="Inquiry: Software Engineering / Systems Role"
          data-body="Hi Aayush,%0D%0A%0D%0AI came across your dossier and would like to connect regarding an engineering role / internship.%0D%0A%0D%0AOrganization / Team: [Company / Project]%0D%0AFocus Area: [Full-Stack / Systems / Low-Level]%0D%0A%0D%0ABest,%0D%0A[Name]"
        >
          <span class="font-micro text-[10px] text-brass-400 font-bold block mb-1">TRACK 01 // ROLES</span>
          <span class="text-xs text-bone-200 group-hover:text-ember-400 font-semibold block transition-colors">Software &amp; Systems Roles</span>
          <span class="font-micro text-[9.5px] text-bone-500 block mt-1">Full-stack, C/Rust systems, internships</span>
        </button>
        <button
          type="button"
          class="dispatch-preset-btn p-3.5 rounded-xl bg-ink-900 border border-bone-50/10 hover:border-ember-500/50 hover:bg-ink-850 text-left transition-all cursor-pointer group active:scale-98"
          data-subject="Inquiry: Vulnerability Research / CVE Collaboration"
          data-body="Hi Aayush,%0D%0A%0D%0AI reviewed your research notes and would like to collaborate on low-level security research.%0D%0A%0D%0ATarget / Scope: [CVE / Kernel / Subsystem]%0D%0AProposed Lab: [QEMU harness / GDB trace]%0D%0A%0D%0ABest,%0D%0A[Name]"
        >
          <span class="font-micro text-[10px] text-ember-400 font-bold block mb-1">TRACK 02 // RESEARCH</span>
          <span class="text-xs text-bone-200 group-hover:text-ember-400 font-semibold block transition-colors">CVE &amp; Exploit Collabs</span>
          <span class="font-micro text-[9.5px] text-bone-500 block mt-1">QEMU harnesses, kernel UAF, GDB triage</span>
        </button>
        <button
          type="button"
          class="dispatch-preset-btn p-3.5 rounded-xl bg-ink-900 border border-bone-50/10 hover:border-ember-500/50 hover:bg-ink-850 text-left transition-all cursor-pointer group active:scale-98"
          data-subject="Inquiry: Hackathon / Open Source Collaboration"
          data-body="Hi Aayush,%0D%0A%0D%0AWould you be interested in teaming up for [Hackathon Name / Open Source Project]?%0D%0A%0D%0ATeam & Stack: [Summary]%0D%0AObjective: [Build goal]%0D%0A%0D%0ABest,%0D%0A[Name]"
        >
          <span class="font-micro text-[10px] text-moss-400 font-bold block mb-1">TRACK 03 // HACKATHONS</span>
          <span class="text-xs text-bone-200 group-hover:text-ember-400 font-semibold block transition-colors">Hackathons &amp; OSS</span>
          <span class="font-micro text-[9.5px] text-bone-500 block mt-1">SIH 2026 sprints, local-first offline AI</span>
        </button>
      </div>
      <!-- Feedback status line -->
      <div id="dispatch-feedback" class="mt-3 p-2.5 rounded-lg bg-ink-900/60 border border-bone-50/5 text-bone-400 font-micro text-[10.5px] hidden flex items-center justify-between">
        <span id="dispatch-feedback-text">Template loaded. Opening mail client...</span>
        <span class="text-emerald-400 font-bold">● DISPATCH ARMED</span>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         03 SCOPE, AVAILABILITY & COLLABORATION TERMS
         ═══════════════════════════════════════════════════════════════ -->
    <section id="scope" class="scroll-mt-24 mb-12 sm:mb-16" data-reveal>
      <SectionHeading index="03" eyebrow="Open Channels" title="What I'm Looking <em>To Do.</em>">
        <p slot="lede" class="lede">
          Concrete ways we can collaborate, build, or research together.
        </p>
      </SectionHeading>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mt-6">
        <div class="card card-glare p-6 flex flex-col justify-between">
          <div>
            <span class="font-micro text-xs text-brass-400 font-bold uppercase tracking-wider block mb-2">[01 / ROLES]</span>
            <h3 class="display text-lg text-bone-50 mb-2">Software &amp; Systems Roles</h3>
            <p class="text-xs text-bone-400 leading-relaxed">
              Seeking full-time or internship roles across full-stack web engineering, systems tooling (C/Rust), or vulnerability research. Fast AI-augmented exploration combined with disciplined manual verification.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-bone-50/10 font-micro text-[10px] text-bone-500">
            Immediate &amp; Summer 2026
          </div>
        </div>

        <div class="card card-glare p-6 flex flex-col justify-between">
          <div>
            <span class="font-micro text-xs text-ember-400 font-bold uppercase tracking-wider block mb-2">[02 / RESEARCH]</span>
            <h3 class="display text-lg text-bone-50 mb-2">Vulnerability Research Collabs</h3>
            <p class="text-xs text-bone-400 leading-relaxed">
              Partnering with independent security researchers and teams to build hermetic QEMU harnesses, trace Linux/Android race conditions under GDB, and verify root causes with deterministic test artifacts.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-bone-50/10 font-micro text-[10px] text-bone-500">
            Open CVE Research &amp; Tooling
          </div>
        </div>

        <div class="card card-glare p-6 flex flex-col justify-between">
          <div>
            <span class="font-micro text-xs text-moss-400 font-bold uppercase tracking-wider block mb-2">[03 / HACKATHONS]</span>
            <h3 class="display text-lg text-bone-50 mb-2">Hackathons &amp; Open Source</h3>
            <p class="text-xs text-bone-400 leading-relaxed">
              Teaming up for national hackathons (like SIH) or building local-first open-source tools (offline speech pipelines, campus web tools, SIMD log preprocessors) on modest hardware.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-bone-50/10 font-micro text-[10px] text-bone-500">
            Sprint &amp; Hackathon Cycles
          </div>
        </div>
      </div>

      <!-- FAQ Section -->
      <div class="mt-12 pt-8 border-t border-bone-50/10">
        <h3 class="display text-xl sm:text-2xl text-bone-50 mb-4">
          Frequently Answered <em class="text-ember-400">Questions.</em>
        </h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {collab.faqs.map((faq, i) => (
            <div class="p-6 rounded-2xl bg-ink-900/60 border border-bone-50/10 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 mb-2 font-micro text-xs text-brass-400 font-semibold">
                  <span>0{i + 1}</span>
                  <span class="text-bone-600">/</span>
                  <span>FAQ</span>
                </div>
                <h4 class="display text-base text-bone-50 mb-2">{faq.q}</h4>
                <p class="text-xs text-bone-400 leading-relaxed">{faq.a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>

  <!-- Client-side script for 1-click email, PGP copying and interactive dispatch terminal -->
  <script is:inline>
    (function () {
      function setupContactPage() {
        var emailBtn = document.getElementById('copy-email-btn');
        var emailBadge = document.getElementById('copy-badge');
        var pgpBtn = document.getElementById('copy-pgp-btn');
        var importCmdBtn = document.getElementById('copy-import-cmd-btn');
        var dispatchBtns = document.querySelectorAll('.dispatch-preset-btn');
        var dispatchFeedback = document.getElementById('dispatch-feedback');
        var dispatchFeedbackText = document.getElementById('dispatch-feedback-text');
        var email = 'aayushbankar42@gmail.com';
        var fingerprint = '8F2A 4C19 E70B 31D8 99A2 55F4 B6D1 88E0 2C3F A914';
        var importCmd = 'curl -sL https://aayushbankar.github.io/key.pub | gpg --import';

        if (emailBtn && emailBadge) {
          emailBtn.addEventListener('click', function () {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(email).then(function () {
                emailBadge.textContent = 'Copied to Clipboard! ✓';
                emailBadge.className = 'chip chip-ember shrink-0 text-[10px] font-semibold transition-all ml-2';
                setTimeout(function () {
                  emailBadge.textContent = 'Click to Copy 📋';
                  emailBadge.className = 'chip chip-brass shrink-0 text-[10px] font-semibold transition-all ml-2';
                }, 2500);
              });
            } else {
              window.location.href = 'mailto:' + email;
            }
          });
        }

        if (pgpBtn) {
          pgpBtn.addEventListener('click', function () {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(fingerprint).then(function () {
                var prev = pgpBtn.textContent;
                pgpBtn.textContent = 'Copied! ✓';
                setTimeout(function () {
                  pgpBtn.textContent = prev;
                }, 2500);
              });
            }
          });
        }

        if (importCmdBtn) {
          importCmdBtn.addEventListener('click', function () {
            if (navigator.clipboard && navigator.clipboard.writeText) {
              navigator.clipboard.writeText(importCmd).then(function () {
                importCmdBtn.textContent = 'Copied! ✓';
                setTimeout(function () {
                  importCmdBtn.textContent = 'Copy Command 📋';
                }, 2500);
              });
            }
          });
        }

        if (dispatchBtns.length) {
          dispatchBtns.forEach(function (btn) {
            btn.addEventListener('click', function () {
              var subject = btn.getAttribute('data-subject') || '';
              var body = btn.getAttribute('data-body') || '';
              var mailtoUri = 'mailto:' + email + '?subject=' + encodeURIComponent(subject) + '&body=' + body;

              if (dispatchFeedback && dispatchFeedbackText) {
                dispatchFeedback.classList.remove('hidden');
                dispatchFeedbackText.textContent = 'Armed: ' + subject + ' — Launching mail client...';
                setTimeout(function () {
                  window.location.href = mailtoUri;
                }, 400);
              } else {
                window.location.href = mailtoUri;
              }
            });
          });
        }
      }

      document.addEventListener('astro:page-load', setupContactPage);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupContactPage);
      } else {
        setupContactPage();
      }
    })();
  </script>
</BaseLayout>
