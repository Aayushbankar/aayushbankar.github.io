---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import MonogramSeal from '../components/ui/MonogramSeal.astro';
import ProgressionTimeline from '../components/ui/ProgressionTimeline.astro';

import { profile } from '../data/profile';
---

<BaseLayout
  title="About & Reality — Aayush Bankar"
  description="18-year-old curious generalist builder exploring systems, web architecture, security, and offline AI. AI-augmented speed with manual ground-truth verification."
>
  <div class="wrap-wide py-10 sm:py-16">
    <!-- ═══════════════════════════════════════════════════════════════
         MOBILE CYBERDECK DECK CONTROLLER (Tactile 4-Tab Switcher)
         Philosophy · Methodology · Career Trajectory · Silicon Skills
         ═══════════════════════════════════════════════════════════════ -->
    <div class="md:hidden sticky top-14 z-30 mb-8 -mx-3 px-3 py-2.5 bg-ink-950/95 backdrop-blur-xl border-b border-bone-50/15 shadow-xl">
      <div class="flex items-center justify-between gap-2 pb-1.5 mb-1.5 border-b border-bone-50/10 font-micro text-[10px]">
        <div class="flex items-center gap-1.5">
          <span class="w-2 h-2 rounded-full bg-ember-500 animate-pulse"></span>
          <span class="text-ember-400 font-bold uppercase tracking-wider">Cyberdeck Deck</span>
        </div>
        <span class="text-bone-400 font-mono" id="m-about-active-tab-indicator">DECK 01 / 04 · PHILOSOPHY</span>
      </div>
      <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-0.5" role="tablist" id="m-about-deck-tabs">
        <button
          type="button"
          class="m-about-tab-btn active px-3 py-1.5 rounded-full font-micro text-[11px] font-semibold transition-all shrink-0 bg-bone-50/10 text-ember-400 border border-bone-50/20 shadow-inner cursor-pointer"
          data-about-tab="philosophy"
          role="tab"
          aria-selected="true"
        >
          01 PHILOSOPHY
        </button>
        <button
          type="button"
          class="m-about-tab-btn px-3 py-1.5 rounded-full font-micro text-[11px] font-medium transition-all shrink-0 text-bone-400 hover:text-bone-50 bg-ink-900/60 border border-bone-50/10 cursor-pointer"
          data-about-tab="methodology"
          role="tab"
          aria-selected="false"
        >
          02 METHODOLOGY
        </button>
        <button
          type="button"
          class="m-about-tab-btn px-3 py-1.5 rounded-full font-micro text-[11px] font-medium transition-all shrink-0 text-bone-400 hover:text-bone-50 bg-ink-900/60 border border-bone-50/10 cursor-pointer"
          data-about-tab="trajectory"
          role="tab"
          aria-selected="false"
        >
          03 TRAJECTORY
        </button>
        <button
          type="button"
          class="m-about-tab-btn px-3 py-1.5 rounded-full font-micro text-[11px] font-medium transition-all shrink-0 text-bone-400 hover:text-bone-50 bg-ink-900/60 border border-bone-50/10 cursor-pointer"
          data-about-tab="silicon"
          role="tab"
          aria-selected="false"
        >
          04 SILICON SKILLS
        </button>
      </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════
         01 PROFILE — Who I Am As a Person First
         ═══════════════════════════════════════════════════════════════ -->
    <section id="profile" class="scroll-mt-24 mb-14 sm:mb-20 rise">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <p class="eyebrow !mb-0">
          <span class="tick">AB–01</span>
          <span>Person &amp; Background · Gandhinagar (IST)</span>
        </p>
        <div class="flex items-center gap-2">
          <span class="chip chip-brass">
            <span class="w-1.5 h-1.5 rounded-full bg-moss-500 animate-pulse"></span>
            Open to Roles &amp; Projects
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Visual Anchor: Monogram Seal with Identity Plate -->
        <div class="lg:col-span-4 flex flex-col items-center justify-center text-center p-6 sm:p-8 rounded-3xl bg-ink-900/60 border border-bone-50/10 shadow-[0_16px_50px_rgba(0,0,0,0.5)]">
          <MonogramSeal class="w-40 h-40 sm:w-48 sm:h-48" size={192} />
          <div class="mt-5 space-y-1">
            <h2 class="display text-xl text-bone-50">Aayush Bankar</h2>
            <p class="font-micro text-[11px] tracking-[0.16em] uppercase text-ember-400 font-semibold">
              Curious Generalist Builder &amp; Student
            </p>
            <p class="font-micro text-[10px] tracking-[0.14em] uppercase text-bone-500">
              Age 18 · Gandhinagar, Gujarat · 23.2156° N, 72.6369° E
            </p>
          </div>
        </div>

        <!-- Person-First Narrative Column -->
        <div class="lg:col-span-8 flex flex-col justify-center">
          <h1 class="display text-3xl sm:text-4xl lg:text-5xl text-bone-50 leading-[1.06]">
            Curious generalist, <em class="text-ember-400">empirical builder.</em>
          </h1>
          <p class="font-display italic text-lg sm:text-xl text-bone-200 mt-3 leading-snug">
            I don't fit neatly into a single box, and I don't pretend to be a corporate director. I'm an 18-year-old student who directs AI models to scaffold fast, then spends hours verifying how things actually work under the hood.
          </p>
          <p class="lede mt-3.5 !max-w-2xl text-sm sm:text-base text-bone-400 leading-relaxed">
            Based in Gandhinagar, Gujarat. I get drawn to wherever interesting engineering problems live — whether that's
            tracing Linux kernel memory under GDB, architecting campus web portals for <strong>500+ daily peers</strong>,
            chaining local conversational speech models on an 8GB laptop, or simulating quantitative market friction.
            Following an internship at <strong>CypherMatrix</strong>, I continue to collaborate with them on low-level systems and security research.
          </p>

          <!-- Verified Reality Metric Strip -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6 pt-6 border-t border-bone-50/10">
            <div class="p-3.5 rounded-xl bg-ink-950/80 border border-bone-50/10">
              <p class="font-display text-xl sm:text-2xl text-brass-400 font-semibold">{profile.education.cpi}</p>
              <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">Academic CPI (Final Yr)</p>
            </div>
            <div class="p-3.5 rounded-xl bg-ink-950/80 border border-bone-50/10">
              <p class="font-display text-xl sm:text-2xl text-ember-400 font-semibold">500+</p>
              <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">Daily Campus Users</p>
            </div>
            <div class="p-3.5 rounded-xl bg-ink-950/80 border border-bone-50/10">
              <p class="font-display text-xl sm:text-2xl text-moss-500 font-semibold">8 GB RAM</p>
              <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">Everyday Hardware Rig</p>
            </div>
            <div class="p-3.5 rounded-xl bg-ink-950/80 border border-bone-50/10">
              <p class="font-display text-xl sm:text-2xl text-bone-200 font-semibold">SIH 2026</p>
              <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">National Screening</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         02 THE 8GB HARDWARE RIG (COMPACT & GROUNDED SPECIMEN)
         ═══════════════════════════════════════════════════════════════ -->
    <section id="hardware" class="scroll-mt-24 mb-14 sm:mb-20" data-reveal>
      <SectionHeading index="02" eyebrow="Hardware Reality" title="The 8GB Rig: <em>Constraints Breed Discipline.</em>">
        <p slot="lede" class="lede">
          All my code, from local quantized LLMs to kernel exploit harnesses, is built and tested directly on an everyday HP EliteBook with 8 GB of RAM running EndeavourOS.
        </p>
      </SectionHeading>

      <div class="card card-glare p-7 sm:p-9 mt-8 border-l-4 border-l-ember-500">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7">
            <div class="flex items-center gap-2 mb-2 font-micro text-xs">
              <span class="w-2 h-2 rounded-full bg-moss-500"></span>
              <span class="text-bone-400 uppercase tracking-wider">Physical Daily Workstation</span>
            </div>
            <h3 class="display text-2xl sm:text-3xl text-bone-50">{profile.labRig.model}</h3>
            <p class="text-xs sm:text-sm text-bone-300 leading-relaxed mt-2 max-w-xl">
              When you don't have access to 80GB cloud GPUs or 64-core enterprise servers, you cannot afford wasteful abstractions. You are forced to understand how every single byte is allocated — writing zero-copy C, tuning quantization, and minimizing cache misses.
            </p>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 mt-5 font-micro text-xs">
              <div class="p-2.5 rounded-lg bg-ink-950 border border-bone-50/10">
                <span class="text-bone-500 text-[10px] block uppercase">CPU</span>
                <span class="text-bone-100 font-semibold block mt-0.5 truncate">i5-8350U (4C/8T)</span>
              </div>
              <div class="p-2.5 rounded-lg bg-ink-950 border border-bone-50/10">
                <span class="text-bone-500 text-[10px] block uppercase">RAM</span>
                <span class="text-bone-100 font-semibold block mt-0.5">8 GB DDR4</span>
              </div>
              <div class="p-2.5 rounded-lg bg-ink-950 border border-bone-50/10">
                <span class="text-bone-500 text-[10px] block uppercase">OS</span>
                <span class="text-bone-100 font-semibold block mt-0.5 truncate">EndeavourOS (Arch)</span>
              </div>
              <div class="p-2.5 rounded-lg bg-ink-950 border border-bone-50/10">
                <span class="text-bone-500 text-[10px] block uppercase">GPU</span>
                <span class="text-bone-100 font-semibold block mt-0.5 truncate">Intel UHD 620</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-5 p-5 rounded-2xl bg-ink-950/80 border border-bone-50/10 space-y-3 font-micro text-xs">
            <span class="text-ember-400 uppercase tracking-widest font-semibold block text-[11px]">Strict Execution Baseline</span>
            <div class="flex items-center justify-between text-bone-300">
              <span>llama.cpp Q4_K_M GGUF</span>
              <span class="text-bone-500">Runs locally in ~4.2 GB RSS</span>
            </div>
            <div class="flex items-center justify-between text-bone-300">
              <span>QEMU Micro-VM Kernel Lab</span>
              <span class="text-bone-500">Boots in &lt;400ms with KASAN</span>
            </div>
            <div class="flex items-center justify-between text-bone-300">
              <span>Cloud Infrastructure Cost</span>
              <span class="text-moss-400 font-semibold">₹0 / month (100% Offline)</span>
            </div>
          </div>
        </div>

        <!-- Authentic EndeavourOS Rig Terminal Console with Interactive Tabs -->
        <div class="mt-8 pt-6 border-t border-bone-50/10 rounded-xl overflow-hidden bg-ink-950 border border-bone-50/15 p-4 sm:p-5 font-mono text-xs">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 pb-3 border-b border-bone-50/10 text-bone-500 font-micro text-[11px]">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-red-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-yellow-500/80"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-green-500/80"></span>
              <span class="ml-2 text-bone-300 font-semibold" id="terminal-prompt-user">legion@elitebook-g5: ~ $</span>
            </div>
            <!-- Interactive Command Tabs -->
            <div class="flex flex-wrap gap-1 p-0.5 rounded-lg bg-ink-900 border border-bone-50/10" role="tablist">
              <button type="button" class="term-tab-btn active px-2.5 py-1 rounded font-semibold text-ember-400 bg-bone-50/10 cursor-pointer" data-cmd="neofetch">neofetch</button>
              <button type="button" class="term-tab-btn px-2.5 py-1 rounded text-bone-400 hover:text-bone-100 cursor-pointer" data-cmd="lscpu">lscpu</button>
              <button type="button" class="term-tab-btn px-2.5 py-1 rounded text-bone-400 hover:text-bone-100 cursor-pointer" data-cmd="free">free -h</button>
              <button type="button" class="term-tab-btn px-2.5 py-1 rounded text-bone-400 hover:text-bone-100 cursor-pointer" data-cmd="uname">uname -a</button>
            </div>
          </div>

          <!-- Command 1: Neofetch Output -->
          <div id="term-panel-neofetch" class="term-panel grid grid-cols-1 md:grid-cols-2 gap-4 text-[11.5px] leading-relaxed">
            <div class="space-y-1 text-bone-300">
              <p><span class="text-ember-400 font-semibold">OS:</span> EndeavourOS Linux x86_64</p>
              <p><span class="text-ember-400 font-semibold">Host:</span> HP EliteBook 840 G5 (Serial: 5CG8...)</p>
              <p><span class="text-ember-400 font-semibold">Kernel:</span> 6.12.67-arch1-1 (SMP PREEMPT_DYNAMIC)</p>
              <p><span class="text-ember-400 font-semibold">Uptime:</span> 14 days, 6 hours</p>
              <p><span class="text-ember-400 font-semibold">Packages:</span> 984 (pacman)</p>
              <p><span class="text-ember-400 font-semibold">Shell:</span> zsh 5.9 / foot terminal</p>
            </div>
            <div class="space-y-1 text-bone-300">
              <p><span class="text-brass-400 font-semibold">CPU:</span> Intel Core i5-8350U (8) @ 3.60GHz</p>
              <p><span class="text-brass-400 font-semibold">GPU:</span> Intel UHD Graphics 620</p>
              <p><span class="text-brass-400 font-semibold">Memory:</span> 3,120 MiB / 7,842 MiB (DDR4 2400 MT/s)</p>
              <p><span class="text-brass-400 font-semibold">Storage:</span> 256 GB NVMe SSD (ext4)</p>
              <p><span class="text-moss-400 font-semibold">Security Mitigations:</span> RETPOLINE=y, KASAN=y, Freelist Hardening</p>
            </div>
          </div>

          <!-- Command 2: lscpu Output -->
          <div id="term-panel-lscpu" class="term-panel hidden space-y-1 text-[11.5px] leading-relaxed text-bone-300">
            <p><span class="text-brass-400 font-semibold">Architecture:</span> x86_64 (CPU op-mode(s): 32-bit, 64-bit)</p>
            <p><span class="text-brass-400 font-semibold">Model name:</span> Intel(R) Core(TM) i5-8350U CPU @ 1.70GHz (Boost: 3.60GHz)</p>
            <p><span class="text-brass-400 font-semibold">CPU(s):</span> 8 threads (4 cores, 2 threads/core, 1 socket)</p>
            <p><span class="text-brass-400 font-semibold">L1d cache:</span> 128 KiB | <span class="text-brass-400 font-semibold">L2 cache:</span> 1 MiB | <span class="text-brass-400 font-semibold">L3 cache:</span> 6 MiB</p>
            <p class="break-all"><span class="text-brass-400 font-semibold">Flags:</span> fpu vme de pse tsc msr pae mce cx8 apic sep mtrr pge mca cmov pat pse36 clflush dts acpi mmx fxsr sse sse2 ss ht tm pbe syscall nx pdpe1gb rdtscp lm constant_tsc art arch_perfmon pebs bts rep_good nopl xtopology nonstop_tsc cpuid aperfmperf pni pclmulqdq dtes64 monitor ds_cpl vmx smx est tm2 ssse3 sdbg fma cx16 xtpr pdcm pcid sse4_1 sse4_2 x2apic movbe popcnt tsc_deadline_timer aes xsave avx f16c rdrand lahf_lm abm 3dnowprefetch cpuid_fault epb invpcid_single pti ssbd ibrs ibpb stibp tpr_shadow flexpriority ept vpid ept_ad fsgsbase tsc_adjust bmi1 hle avx2 smep bmi2 erms invpcid rtm mpx rdseed adx smap clflushopt intel_pt xsaveopt xsavec xgetbv1 xsaves dtherm ida arat pln pts hwp hwp_notify hwp_act_window hwp_epp md_clear flush_l1d arch_capabilities</p>
          </div>

          <!-- Command 3: free -h Output -->
          <div id="term-panel-free" class="term-panel hidden space-y-1 text-[11.5px] leading-relaxed text-bone-300">
            <p class="text-bone-500 font-semibold">               total        used        free      shared  buff/cache   available</p>
            <p>Mem:           <span class="text-ember-400">7.6Gi</span>       3.0Gi       2.8Gi       142Mi       1.8Gi       <span class="text-moss-400">4.3Gi</span></p>
            <p>Swap:          8.0Gi          0B       8.0Gi</p>
            <p class="text-[10px] text-bone-500 mt-2">Zero swap thrash observed during local llama.cpp Q4_K_M 3B inference tests.</p>
          </div>

          <!-- Command 4: uname -a Output -->
          <div id="term-panel-uname" class="term-panel hidden space-y-1 text-[11.5px] leading-relaxed text-bone-300">
            <p class="text-bone-100">Linux arch-elitebook-840g5 6.12.67-arch1-1 #1 SMP PREEMPT_DYNAMIC Sun Jan 18 14:22:10 UTC 2026 x86_64 GNU/Linux</p>
            <p class="text-[10px] text-bone-500 mt-2">CONFIG_PREEMPT_DYNAMIC=y enabled for deterministic low-latency eBPF ringbuf tracepoint processing.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         03 ACADEMIC TRAJECTORY & VERIFIED CREDENTIALS
         ═══════════════════════════════════════════════════════════════ -->
    <section id="creds" class="scroll-mt-24 mb-14 sm:mb-20" data-reveal>
      <SectionHeading index="03" eyebrow="Education & Credentials" title="Academic Standing &amp; <em>Verified Records.</em>">
        <p slot="lede" class="lede">
          Grounded institutional performance, government polytechnic credentials, and industry research collaborations.
        </p>
      </SectionHeading>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mt-8">
        {profile.credentials.map((c) => (
          <div class="card card-glare p-6 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="font-micro text-xs text-ember-400 font-bold">[{c.id}]</span>
                <span class="chip chip-brass !text-[9px]">✓ {c.status}</span>
              </div>
              <h4 class="display text-base text-bone-50 mb-1">{c.title}</h4>
              <p class="font-micro text-[10px] text-bone-500 uppercase tracking-wider mb-3">
                {c.issuer} · {c.date}
              </p>
              <p class="text-xs text-bone-400 leading-relaxed">{c.detail}</p>
            </div>
            <div class="mt-4 pt-3 border-t border-bone-50/10 font-micro text-[10px] text-bone-500 flex items-center justify-between">
              <span>Verified Record</span>
              <span class="text-moss-400 font-semibold">● Authentic</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         04 HOW I ACTUALLY WORK: AI SPEED + SILICON TRUTH & ETHOS
         ═══════════════════════════════════════════════════════════════ -->
    <section id="ethos" class="scroll-mt-24 mb-14 sm:mb-20" data-reveal>
      <SectionHeading index="04" eyebrow="Engineering Methodology" title="How I Work: <em>AI Speed + Silicon Truth.</em>">
        <p slot="lede" class="lede">
          AI models are formidable brainstorming and scaffolding engines, but they hallucinate memory layouts and concurrency windows. Here is the exact methodology I use to bridge high-velocity exploration with undeniable manual verification.
        </p>
      </SectionHeading>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
        <!-- Card 1: The AI Scaffolding Engine -->
        <article class="card card-glare p-7 sm:p-8 border-t-2 border-t-ember-500 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-micro text-xs text-ember-400 tracking-widest font-semibold uppercase">01 / High-Velocity Scaffolding</span>
              <span class="chip chip-ember !text-[9px]">EXPLORATION CATALYST</span>
            </div>
            <h3 class="display text-xl sm:text-2xl text-bone-50 mb-3">AI As a Force Multiplier</h3>
            <p class="text-xs sm:text-sm text-bone-300 leading-relaxed">
              I direct frontier LLMs to analyze vulnerability disclosures, draft initial test harnesses, parse RFC specifications, and generate frontend layout scaffolds. This compresses days of mechanical syntax generation into minutes of focused exploration across the spectrum.
            </p>

            <div class="mt-5 p-4 rounded-xl bg-ink-950 border border-bone-50/10 space-y-2">
              <p class="font-micro text-[10px] text-ember-400 font-semibold uppercase tracking-wider">Where AI Accelerates Me:</p>
              <ul class="text-xs text-bone-400 space-y-1.5 list-disc list-inside">
                <li>Drafting initial test runner scripts and command matrices</li>
                <li>Generating boilerplate for Linux ioctl, socket, and web harness code</li>
                <li>Rapidly exploring alternative architectural ideas across unfamiliar libraries</li>
              </ul>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-bone-50/10 flex items-center justify-between font-micro text-xs text-bone-500">
            <span>Velocity: 10x Breadth</span>
            <span class="text-ember-400">Never trusted blindly</span>
          </div>
        </article>

        <!-- Card 2: Empirical Verification & First-Principles Systems Truth -->
        <article class="card card-glare p-7 sm:p-8 border-t-2 border-t-moss-500 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-micro text-xs text-moss-400 tracking-widest font-semibold uppercase">02 / Empirical Verification</span>
              <span class="chip chip-brass !text-[9px]">FIRST-PRINCIPLES TRUTH</span>
            </div>
            <h3 class="display text-xl sm:text-2xl text-bone-50 mb-3">Hermetic Testing &amp; Systems Ground Truth</h3>
            <p class="text-xs sm:text-sm text-bone-300 leading-relaxed">
              AI models and abstractions hallucinate boundary conditions, memory structures, and concurrency windows. My engineering methodology demands reproducible, first-principles verification: if a system claims 13,000 EPS or sub-millisecond voice latency, it must be proved through instrumented harnesses, automated regression scripts, and observable physical metrics.
            </p>

            <div class="mt-5 p-4 rounded-xl bg-ink-950 border border-bone-50/10 space-y-2">
              <p class="font-micro text-[10px] text-moss-400 font-semibold uppercase tracking-wider">How I Personally Verify Systems:</p>
              <ul class="text-xs text-bone-400 space-y-1.5 list-disc list-inside">
                <li><strong>Hermetic Environments:</strong> Building deterministic test runners, micro-VMs, and isolated lab scripts so every experiment is 100% reproducible.</li>
                <li><strong>First-Principles Profiling:</strong> Measuring cache line footprints, lock contention, CPU cycle efficiency, and zero-copy data flow under real workload pressure.</li>
                <li><strong>Diagnostic Sanitizers:</strong> Catching silent memory corruptions and race conditions using KASAN, Valgrind, UBSan, and eBPF kernel tracepoints.</li>
                <li><strong>Documented Failure Paths:</strong> Openly cataloging dead ends, compiler bugs, and retraction registers alongside verified wins.</li>
              </ul>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-bone-50/10 flex items-center justify-between font-micro text-xs text-bone-500">
            <span>Proof: Reproducible Testbenches</span>
            <span class="text-moss-400">100% Deterministic</span>
          </div>
        </article>
      </div>

      <!-- Ground Truth Operating Manifesto (The 3 Rules) -->
      <div class="card p-7 sm:p-8 mt-6 bg-ink-900/60 border border-bone-50/15">
        <p class="eyebrow mb-4"><span class="tick">RUL</span><span>Non-Negotiable Operating Rules</span></p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-4 rounded-xl bg-ink-950/80 border border-bone-50/10">
