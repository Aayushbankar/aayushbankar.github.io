---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import MonogramSeal from '../components/ui/MonogramSeal.astro';
import ProgressionTimeline from '../components/ui/ProgressionTimeline.astro';

import { profile } from '../data/profile';
import { methodology } from '../data/methodology';
---

<BaseLayout
  title="About & Research Methodology — Aayush Bankar"
  description="Ground truth biographical profile, 5-phase research lifecycle, local lab bench hardware, and academic trajectory."
>
  <div class="wrap-wide py-10 sm:py-16">
    <!-- ═══════════════════════════════════════════════════════════════
         HERO — Editorial Split with Interactive Monogram Seal
         ═══════════════════════════════════════════════════════════════ -->
    <header class="mb-14 sm:mb-20 rise">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <p class="eyebrow !mb-0">
          <span class="tick">AB–00</span>
          <span>Ground-Truth Profile · Gandhinagar (IST)</span>
        </p>
        <div class="flex items-center gap-2">
          <span class="chip chip-brass">
            <span class="w-1.5 h-1.5 rounded-full bg-moss-500 animate-pulse"></span>
            Open to Scoped Research
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Visual Anchor: Monogram Seal with Orbit Accent -->
        <div class="lg:col-span-4 flex flex-col items-center justify-center text-center p-6 sm:p-8 rounded-3xl bg-ink-900/60 border border-bone-50/10">
          <MonogramSeal class="w-40 h-40 sm:w-48 sm:h-48" size={192} />
          <div class="mt-5 space-y-1">
            <h2 class="display text-xl text-bone-50">Aayush Bankar</h2>
            <p class="font-micro text-[11px] tracking-[0.16em] uppercase text-ember-400 font-semibold">
              Systems Security Researcher
            </p>
            <p class="font-micro text-[10px] tracking-[0.14em] uppercase text-bone-500">
              Gandhinagar, Gujarat · 23.2156° N, 72.6369° E
            </p>
          </div>
        </div>

        <!-- Editorial Typography Column -->
        <div class="lg:col-span-8 flex flex-col justify-center">
          <h1 class="display text-4xl sm:text-5xl lg:text-6xl text-bone-50 leading-[1.04]">
            Ground truth, <em class="text-ember-400">empirical proof.</em>
          </h1>
          <p class="font-display italic text-lg sm:text-xl text-bone-200 mt-3 leading-snug">
            First-principles understanding of kernel memory, high-throughput systems, and offline AI before automation or abstraction.
          </p>
          <p class="lede mt-3.5 !max-w-2xl text-sm sm:text-base text-bone-400 leading-relaxed">
            18-year-old security researcher and student based in Gandhinagar, Gujarat. Currently conducting vulnerability research
            and systems analysis at <strong>CypherMatrix</strong>, focusing on Linux kernel race condition triage, exploit reproduction,
            and verifiable log pipelines.
          </p>

          <!-- Metric Strip -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6 pt-6 border-t border-bone-50/10">
            <div class="p-3 rounded-xl bg-ink-950/80 border border-bone-50/10">
              <p class="font-display text-xl sm:text-2xl text-brass-400 font-semibold">{profile.education.cpi}</p>
              <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">Academic CPI</p>
            </div>
            <div class="p-3 rounded-xl bg-ink-950/80 border border-bone-50/10">
              <p class="font-display text-xl sm:text-2xl text-ember-400 font-semibold">500+</p>
              <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">Daily Campus Users</p>
            </div>
            <div class="p-3 rounded-xl bg-ink-950/80 border border-bone-50/10">
              <p class="font-display text-xl sm:text-2xl text-moss-500 font-semibold">SIH 2026</p>
              <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">National Screening</p>
            </div>
            <div class="p-3 rounded-xl bg-ink-950/80 border border-bone-50/10">
              <p class="font-display text-xl sm:text-2xl text-bone-200 font-semibold">42 Claims</p>
              <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">Audited Ledger</p>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- ═══════════════════════════════════════════════════════════════
         CORE OPERATING PRINCIPLES (Framer Bento Grid)
         ═══════════════════════════════════════════════════════════════ -->
    <section class="mb-14 sm:mb-20" data-reveal>
      <SectionHeading index="01" eyebrow="Operating Principles" title="The Non-Negotiable <em>Rules.</em>">
        <p slot="lede" class="lede">
          How I approach systems security, exploit analysis, and tooling. No hype, no unverified assertions.
        </p>
      </SectionHeading>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-8">
        <article class="card card-glare p-7 flex flex-col justify-between border-t-2 border-t-ember-500">
          <div>
            <span class="font-micro text-xs text-ember-400 tracking-widest font-semibold block mb-2">01 // REPRODUCIBILITY</span>
            <h3 class="display text-xl text-bone-50 mb-2">Evidence Over Claims</h3>
            <p class="text-xs sm:text-sm text-bone-400 leading-relaxed">
              Every vulnerability assertion, compiler offset, and throughput benchmark must run deterministically inside a local test harness. If it cannot be audited with GDB traces or measured timestamps, it does not exist.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-bone-50/10 font-micro text-[10px] text-bone-500 uppercase tracking-wider">
            Deterministic Reproducibility
          </div>
        </article>

        <article class="card card-glare p-7 flex flex-col justify-between border-t-2 border-t-brass-500">
          <div>
            <span class="font-micro text-xs text-brass-400 tracking-widest font-semibold block mb-2">02 // INTEGRITY</span>
            <h3 class="display text-xl text-bone-50 mb-2">Honesty on Dead Ends</h3>
            <p class="text-xs sm:text-sm text-bone-400 leading-relaxed">
              Failed exploitation attempts, compiler struct discrepancies, and unviable branches are documented openly in the research ledger. Knowing precisely where and why a technique fails is just as vital as root execution.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-bone-50/10 font-micro text-[10px] text-bone-500 uppercase tracking-wider">
            Public Dead-Ends Register
          </div>
        </article>

        <article class="card card-glare p-7 flex flex-col justify-between border-t-2 border-t-moss-500">
          <div>
            <span class="font-micro text-xs text-moss-400 tracking-widest font-semibold block mb-2">03 // FLUENCY</span>
            <h3 class="display text-xl text-bone-50 mb-2">Manual Systems Depth</h3>
            <p class="text-xs sm:text-sm text-bone-400 leading-relaxed">
              Direct understanding of raw POSIX system calls, C memory allocators (SLUB), and assembly under GDB is non-negotiable. AI agents are used as exploratory catalysts; the human must audit and verify the assembly by hand.
            </p>
          </div>
          <div class="mt-6 pt-4 border-t border-bone-50/10 font-micro text-[10px] text-bone-500 uppercase tracking-wider">
            First-Principles Architecture
          </div>
        </article>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         METHODOLOGY TIMELINE — 5-Phase Research Lifecycle
         ═══════════════════════════════════════════════════════════════ -->
    <section class="mb-14 sm:mb-20" data-reveal>
      <SectionHeading index="02" eyebrow="Research Cadence" title="5-Phase Empirical <em>Methodology.</em>">
        <p slot="lede" class="lede">
          {methodology.creed}
        </p>
      </SectionHeading>

      <div class="card card-glare p-7 sm:p-10 mt-8">
        <div class="space-y-8 relative before:absolute before:inset-0 before:left-3.5 before:w-px before:bg-bone-50/10">
          {methodology.phases.map((p) => (
            <div class="relative flex items-start gap-5 pl-1 group">
              <span class="w-7 h-7 rounded-full bg-ink-950 border border-ember-500/80 group-hover:border-ember-400 group-hover:scale-110 transition-all flex items-center justify-center font-display text-xs text-ember-400 shrink-0 z-10">
                {p.number}
              </span>
              <div class="flex-1 pb-2">
                <div class="flex flex-wrap items-baseline gap-2.5">
                  <h4 class="font-display text-lg text-bone-50">{p.title}</h4>
                  <span class="font-micro text-[10px] tracking-wider uppercase text-ember-400">({p.name})</span>
                </div>
                <p class="font-display italic text-xs text-brass-400 mt-1">"{p.motto}"</p>
                <p class="text-xs sm:text-sm text-bone-300 leading-relaxed mt-2">{p.description}</p>
                <div class="flex flex-wrap gap-1.5 mt-3">
                  {p.artifacts.map((a) => (
                    <span class="chip !text-[9px] !py-0.5 !px-2">{a}</span>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         BENCH HARDWARE & LAB ENVIRONMENT + CREDENTIALS GRID
         ═══════════════════════════════════════════════════════════════ -->
    <section class="mb-14 sm:mb-20" data-reveal>
      <SectionHeading index="03" eyebrow="Infrastructure & Credentials" title="Hardware Rig & <em>Verified Records.</em>">
        <p slot="lede" class="lede">
          Empirical telemetry starts at the silicon level. Every exploit and model is reproduced on this physical workstation.
        </p>
      </SectionHeading>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 mt-8">
        <!-- Lab Hardware Rig Spec Sheet -->
        <div class="lg:col-span-6 card card-glare p-7 sm:p-9 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <p class="eyebrow mb-0"><span class="tick">RIG</span><span>Laboratory Hardware</span></p>
              <span class="chip chip-brass !text-[9px] !py-0.5 !px-2">LOCAL EXECUTION</span>
            </div>
            <h3 class="display text-2xl text-bone-50 mb-1">{profile.labRig.model}</h3>
            <p class="font-micro text-xs text-ember-400 uppercase tracking-wider mb-6">Physical Telemetry Baseline</p>

            <div class="space-y-3 font-micro text-xs">
              <div class="p-3 rounded-lg bg-ink-950 border border-bone-50/10 flex items-center justify-between">
                <span class="text-bone-500 uppercase tracking-wider text-[10px]">Processor</span>
                <span class="text-bone-200 font-semibold">{profile.labRig.cpu}</span>
              </div>
              <div class="p-3 rounded-lg bg-ink-950 border border-bone-50/10 flex items-center justify-between">
                <span class="text-bone-500 uppercase tracking-wider text-[10px]">Memory &amp; Storage</span>
                <span class="text-bone-200 font-semibold">{profile.labRig.ram} · {profile.labRig.storage}</span>
              </div>
              <div class="p-3 rounded-lg bg-ink-950 border border-bone-50/10 flex items-center justify-between">
                <span class="text-bone-500 uppercase tracking-wider text-[10px]">Operating Systems</span>
                <span class="text-bone-200 font-semibold">{profile.labRig.os}</span>
              </div>
              <div class="p-3 rounded-lg bg-ink-950 border border-bone-50/10 flex items-center justify-between">
                <span class="text-bone-500 uppercase tracking-wider text-[10px]">Virtualization</span>
                <span class="text-bone-200 font-semibold">{profile.labRig.virtualization}</span>
              </div>
              <div class="p-3 rounded-lg bg-ink-950 border border-bone-50/10 flex items-center justify-between">
                <span class="text-bone-500 uppercase tracking-wider text-[10px]">Local Inference</span>
                <span class="text-bone-200 font-semibold">{profile.labRig.edgeAi}</span>
              </div>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-bone-50/10 flex items-center justify-between font-micro text-xs text-bone-400">
            <span>Kernel Debug: QEMU + GDB</span>
            <span class="text-moss-400 font-semibold">✓ Zero Cloud Dependencies</span>
          </div>
        </div>

        <!-- Academic & Verified Credentials Column -->
        <div class="lg:col-span-6 space-y-6">
          <!-- Academic Profile -->
          <article class="card card-glare p-7 sm:p-8">
            <p class="eyebrow mb-2"><span class="tick">EDU</span><span>Academic Profile</span></p>
            <h3 class="display text-xl text-bone-50 mb-1">{profile.education.institution}</h3>
            <p class="font-micro text-xs text-brass-400 uppercase tracking-wider mb-4">
              {profile.education.degree} · CPI {profile.education.cpi}
            </p>

            <ul class="space-y-2.5 text-xs text-bone-300 font-sans leading-relaxed">
              <li class="flex items-start gap-2.5">
                <span class="text-ember-400 font-bold">›</span>
                <span>{profile.education.role}</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-ember-400 font-bold">›</span>
                <span>{profile.education.nextStep}</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-ember-400 font-bold">›</span>
                <span>SIH 2026: Team Spectre cleared college round, currently in national screening for NTRO statement.</span>
              </li>
            </ul>
          </article>

          <!-- Verified Credentials -->
          <article class="card card-glare p-7 sm:p-8">
            <p class="eyebrow mb-3"><span class="tick">LEDGER</span><span>Verified Credentials</span></p>
            <div class="divide-y divide-bone-50/10">
              {profile.credentials.map((c) => (
                <div class="py-3 first:pt-0 last:pb-0">
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-micro text-xs text-ember-400 font-semibold">[{c.id}]</span>
                    <span class="chip chip-brass !text-[9px] !py-0.5 !px-2">✓ {c.status}</span>
                  </div>
                  <h4 class="text-sm font-medium text-bone-50 mt-1">{c.title}</h4>
                  <p class="font-micro text-[10px] text-bone-500 uppercase tracking-wider mt-0.5">
                    {c.issuer} · {c.date}
                  </p>
                  <p class="text-xs text-bone-400 mt-1 leading-relaxed">{c.detail}</p>
                </div>
              ))}
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- Technical Competencies Matrix -->
    <section class="mb-14 sm:mb-20" data-reveal>
      <div class="card p-7 sm:p-9">
        <p class="eyebrow mb-4"><span class="tick">SKL</span><span>Technical Competencies Across the Spectrum</span></p>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {profile.competencies.map((group) => (
            <div>
              <p class="font-micro text-xs uppercase tracking-wider text-ember-400 font-semibold mb-3">{group.category}</p>
              <div class="flex flex-wrap gap-1.5">
                {group.skills.map((s) => (
                  <span class="chip !text-[10px] !py-0.5 !px-2">{s}</span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       INTERACTIVE CAREER TRAJECTORY & TECHNICAL PROGRESSION
       ═══════════════════════════════════════════════════════════════ -->
  <ProgressionTimeline />
</BaseLayout>
