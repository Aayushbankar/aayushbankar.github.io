---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import MonogramSeal from '../components/ui/MonogramSeal.astro';
import ProgressionTimeline from '../components/ui/ProgressionTimeline.astro';

import { profile } from '../data/profile';
---

<BaseLayout
  title="About & Reality — Aayush Bankar"
  description="18-year-old curious generalist builder exploring systems, web architecture, security, and offline AI. AI-augmented speed with manual ground-truth verification."
>
  <div class="wrap-wide py-10 sm:py-16">
    <!-- ═══════════════════════════════════════════════════════════════
         HERO — Who I Am As a Person First
         ═══════════════════════════════════════════════════════════════ -->
    <header class="mb-14 sm:mb-20 rise">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <p class="eyebrow !mb-0">
          <span class="tick">AB–01</span>
          <span>Person &amp; Background · Gandhinagar (IST)</span>
        </p>
        <div class="flex items-center gap-2">
          <span class="chip chip-brass">
            <span class="w-1.5 h-1.5 rounded-full bg-moss-500 animate-pulse"></span>
            Open to Roles &amp; Projects
          </span>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        <!-- Visual Anchor: Monogram Seal with Identity Plate -->
        <div class="lg:col-span-4 flex flex-col items-center justify-center text-center p-6 sm:p-8 rounded-3xl bg-ink-900/60 border border-bone-50/10 shadow-[0_16px_50px_rgba(0,0,0,0.5)]">
          <MonogramSeal class="w-40 h-40 sm:w-48 sm:h-48" size={192} />
          <div class="mt-5 space-y-1">
            <h2 class="display text-xl text-bone-50">Aayush Bankar</h2>
            <p class="font-micro text-[11px] tracking-[0.16em] uppercase text-ember-400 font-semibold">
              Curious Generalist Builder &amp; Student
            </p>
            <p class="font-micro text-[10px] tracking-[0.14em] uppercase text-bone-500">
              Age 18 · Gandhinagar, Gujarat · 23.2156° N, 72.6369° E
            </p>
          </div>
        </div>

        <!-- Person-First Narrative Column -->
        <div class="lg:col-span-8 flex flex-col justify-center">
          <h1 class="display text-3xl sm:text-4xl lg:text-5xl text-bone-50 leading-[1.06]">
            Curious generalist, <em class="text-ember-400">empirical builder.</em>
          </h1>
          <p class="font-display italic text-lg sm:text-xl text-bone-200 mt-3 leading-snug">
            I don't fit neatly into a single box, and I don't pretend to be a corporate director. I'm an 18-year-old student who directs AI models to scaffold fast, then spends hours verifying how things actually work under the hood.
          </p>
          <p class="lede mt-3.5 !max-w-2xl text-sm sm:text-base text-bone-400 leading-relaxed">
            Based in Gandhinagar, Gujarat. I get drawn to wherever interesting engineering problems live — whether that's
            tracing Linux kernel memory under GDB, architecting campus web portals for <strong>500+ daily peers</strong>,
            chaining local conversational speech models on an 8GB laptop, or simulating quantitative market friction.
            Following an internship at <strong>CypherMatrix</strong>, I continue to collaborate with them on low-level systems and security research.
          </p>

          <!-- Verified Reality Metric Strip -->
          <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6 pt-6 border-t border-bone-50/10">
            <div class="p-3.5 rounded-xl bg-ink-950/80 border border-bone-50/10">
              <p class="font-display text-xl sm:text-2xl text-brass-400 font-semibold">{profile.education.cpi}</p>
              <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">Academic CPI (Final Yr)</p>
            </div>
            <div class="p-3.5 rounded-xl bg-ink-950/80 border border-bone-50/10">
              <p class="font-display text-xl sm:text-2xl text-ember-400 font-semibold">500+</p>
              <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">Daily Campus Users</p>
            </div>
            <div class="p-3.5 rounded-xl bg-ink-950/80 border border-bone-50/10">
              <p class="font-display text-xl sm:text-2xl text-moss-500 font-semibold">8 GB RAM</p>
              <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">Everyday Hardware Rig</p>
            </div>
            <div class="p-3.5 rounded-xl bg-ink-950/80 border border-bone-50/10">
              <p class="font-display text-xl sm:text-2xl text-bone-200 font-semibold">SIH 2026</p>
              <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">National Screening</p>
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- ═══════════════════════════════════════════════════════════════
         01 HOW I ACTUALLY WORK: AI SPEED + SILICON TRUTH + 3 RULES
         ═══════════════════════════════════════════════════════════════ -->
    <section class="mb-14 sm:mb-20" data-reveal>
      <SectionHeading index="01" eyebrow="Engineering Methodology" title="How I Work: <em>AI Speed + Silicon Truth.</em>">
        <p slot="lede" class="lede">
          AI models are formidable brainstorming and scaffolding engines, but they hallucinate memory layouts and concurrency windows. Here is the exact methodology I use to bridge high-velocity exploration with undeniable manual verification.
        </p>
      </SectionHeading>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
        <!-- Card 1: The AI Scaffolding Engine -->
        <article class="card card-glare p-7 sm:p-8 border-t-2 border-t-ember-500 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-micro text-xs text-ember-400 tracking-widest font-semibold uppercase">01 / High-Velocity Scaffolding</span>
              <span class="chip chip-ember !text-[9px]">EXPLORATION CATALYST</span>
            </div>
            <h3 class="display text-xl sm:text-2xl text-bone-50 mb-3">AI As a Force Multiplier</h3>
            <p class="text-xs sm:text-sm text-bone-300 leading-relaxed">
              I direct frontier LLMs to analyze vulnerability disclosures, draft initial test harnesses, parse RFC specifications, and generate frontend layout scaffolds. This compresses days of mechanical syntax generation into minutes of focused exploration across the spectrum.
            </p>

            <div class="mt-5 p-4 rounded-xl bg-ink-950 border border-bone-50/10 space-y-2">
              <p class="font-micro text-[10px] text-ember-400 font-semibold uppercase tracking-wider">Where AI Accelerates Me:</p>
              <ul class="text-xs text-bone-400 space-y-1.5 list-disc list-inside">
                <li>Drafting initial test runner scripts and command matrices</li>
                <li>Generating boilerplate for Linux ioctl, socket, and web harness code</li>
                <li>Rapidly exploring alternative architectural ideas across unfamiliar libraries</li>
              </ul>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-bone-50/10 flex items-center justify-between font-micro text-xs text-bone-500">
            <span>Velocity: 10x Breadth</span>
            <span class="text-ember-400">Never trusted blindly</span>
          </div>
        </article>

        <!-- Card 2: Manual Ground-Truth Verification -->
        <article class="card card-glare p-7 sm:p-8 border-t-2 border-t-moss-500 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-micro text-xs text-moss-400 tracking-widest font-semibold uppercase">02 / Silicon Ground Truth</span>
              <span class="chip chip-brass !text-[9px]">VERIFICATION PHASE</span>
            </div>
            <h3 class="display text-xl sm:text-2xl text-bone-50 mb-3">Manual GDB &amp; Memory Depth</h3>
            <p class="text-xs sm:text-sm text-bone-300 leading-relaxed">
              Every struct alignment, SLUB cache allocation, and assembly instruction is verified by hand. When an AI model hallucinates a struct member displacement (e.g. 8 bytes off under GCC), I catch it with GDB breakpoint traces, memory inspection, and local micro-VM runs.
            </p>

            <div class="mt-5 p-4 rounded-xl bg-ink-950 border border-bone-50/10 space-y-2">
              <p class="font-micro text-[10px] text-moss-400 font-semibold uppercase tracking-wider">What I Personally Verify:</p>
              <ul class="text-xs text-bone-400 space-y-1.5 list-disc list-inside">
                <li>Exact memory offsets in SLUB (<code class="text-moss-300">kmalloc-192</code>) under KASAN</li>
                <li>ROP gadget viability and stack pivot alignment under RETPOLINE</li>
                <li>Real-world latency, cache footprint, and zero-copy data integrity</li>
              </ul>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-bone-50/10 flex items-center justify-between font-micro text-xs text-bone-500">
            <span>Proof: Empirical Logs</span>
            <span class="text-moss-400">100% Deterministic</span>
          </div>
        </article>
      </div>

      <!-- Ground Truth Operating Manifesto (The 3 Rules) -->
      <div class="card p-7 sm:p-8 mt-6 bg-ink-900/60 border border-bone-50/15">
        <p class="eyebrow mb-4"><span class="tick">RUL</span><span>Non-Negotiable Operating Rules</span></p>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-4 rounded-xl bg-ink-950/80 border border-bone-50/10">
            <span class="font-micro text-xs text-brass-400 font-bold block mb-2 tracking-wider">RULE 01 // EVIDENCE FIRST</span>
            <p class="text-xs sm:text-sm text-bone-300 leading-relaxed">
              No claim is published without a hermetic reproduction command, compile flags, and exact kernel commit hash.
            </p>
          </div>
          <div class="p-4 rounded-xl bg-ink-950/80 border border-bone-50/10">
            <span class="font-micro text-xs text-ember-400 font-bold block mb-2 tracking-wider">RULE 02 // OPEN DEAD ENDS</span>
            <p class="text-xs sm:text-sm text-bone-300 leading-relaxed">
              When an exploitation branch or architecture fails due to compiler alignments or system mitigations, it is documented openly.
            </p>
          </div>
          <div class="p-4 rounded-xl bg-ink-950/80 border border-bone-50/10">
            <span class="font-micro text-xs text-moss-400 font-bold block mb-2 tracking-wider">RULE 03 // ZERO HYPE</span>
            <p class="text-xs sm:text-sm text-bone-300 leading-relaxed">
              I speak as an 18-year-old student passionate about building real systems, not an exaggerated corporate figurehead.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         02 BUILDING ACROSS THE SPECTRUM (GENERALIST BREADTH)
         ═══════════════════════════════════════════════════════════════ -->
    <section class="mb-14 sm:mb-20" data-reveal>
      <SectionHeading index="02" eyebrow="Breadth & Interests" title="No Silos. <em>From Web to Silicon.</em>">
        <p slot="lede" class="lede">
          I don't believe in boxing yourself into one niche. The best engineering happens when you understand the whole picture — from pixels and network protocols to memory allocators and neural models.
        </p>
      </SectionHeading>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mt-8">
        <!-- Spectrum 1: Web Architecture -->
        <div class="card card-glare p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="font-micro text-xs text-brass-400 font-bold uppercase tracking-wider">[01 / WEB]</span>
              <span class="chip chip-brass !text-[9px]">CAMPUS SCALE</span>
            </div>
            <h4 class="display text-lg text-bone-50 mb-2">Production Web Architecture</h4>
            <p class="text-xs text-bone-400 leading-relaxed">
              Architected and maintain the official IT Department Web Portal for Government Polytechnic Gandhinagar. Self-hosted, sub-second loads, serving 500+ daily active students and faculty with zero infrastructure budget.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-bone-50/10 font-micro text-[10px] text-bone-500">
            Astro · Modern JS · Accessible UI
          </div>
        </div>

        <!-- Spectrum 2: Low-Level Systems & Security -->
        <div class="card card-glare p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="font-micro text-xs text-ember-400 font-bold uppercase tracking-wider">[02 / SYSTEMS]</span>
              <span class="chip chip-ember !text-[9px]">KERNEL DEPTH</span>
            </div>
            <h4 class="display text-lg text-bone-50 mb-2">Low-Level Systems &amp; Security</h4>
            <p class="text-xs text-bone-400 leading-relaxed">
              Linux kernel race condition triage (CVE-2026-46242), Android Binder IPC projection audits (CVE-2026-28576), eBPF tracepoints, and hermetic QEMU test harnesses with automated GDB Python telemetry.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-bone-50/10 font-micro text-[10px] text-bone-500">
            C · Rust · Assembly · Linux 6.12
          </div>
        </div>

        <!-- Spectrum 3: Offline Edge AI & Audio -->
        <div class="card card-glare p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="font-micro text-xs text-moss-400 font-bold uppercase tracking-wider">[03 / EDGE AI]</span>
              <span class="chip !text-[9px]">OFFLINE FIRST</span>
            </div>
            <h4 class="display text-lg text-bone-50 mb-2">Offline Edge AI &amp; Audio</h4>
            <p class="text-xs text-bone-400 leading-relaxed">
              Engineered Wolvie: a chained local speech assistant (Silero VAD + faster-whisper + llama.cpp + Piper TTS) achieving ~530ms round-trip latency over WebRTC data channels on standard CPU hardware with zero cloud dependencies.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-bone-50/10 font-micro text-[10px] text-bone-500">
            llama.cpp GGUF · WebRTC · Python
          </div>
        </div>

        <!-- Spectrum 4: Quant Modeling -->
        <div class="card card-glare p-6 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span class="font-micro text-xs text-bone-300 font-bold uppercase tracking-wider">[04 / SIM]</span>
              <span class="chip !text-[9px]">EMPIRICAL</span>
            </div>
            <h4 class="display text-lg text-bone-50 mb-2">Quantitative Simulation</h4>
            <p class="text-xs text-bone-400 leading-relaxed">
              Built QuantLab: an event-driven backtesting engine modeling market impact (Almgren-Chriss), order execution friction, and statutory Indian market taxes (STT/GST) under combinatorial cross-validation.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-bone-50/10 font-micro text-[10px] text-bone-500">
            Python · Event Loops · NumPy
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         03 THE 8GB HARDWARE RIG (COMPACT & GROUNDED SPECIMEN)
         ═══════════════════════════════════════════════════════════════ -->
    <section class="mb-14 sm:mb-20" data-reveal>
      <SectionHeading index="03" eyebrow="Hardware Reality" title="The 8GB Rig: <em>Constraints Breed Discipline.</em>">
        <p slot="lede" class="lede">
          All my code, from local quantized LLMs to kernel exploit harnesses, is built and tested directly on an everyday HP EliteBook with 8 GB of RAM running EndeavourOS.
        </p>
      </SectionHeading>

      <div class="card card-glare p-7 sm:p-9 mt-8 border-l-4 border-l-ember-500">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7">
            <div class="flex items-center gap-2 mb-2 font-micro text-xs">
              <span class="w-2 h-2 rounded-full bg-moss-500"></span>
              <span class="text-bone-400 uppercase tracking-wider">Physical Daily Workstation</span>
            </div>
            <h3 class="display text-2xl sm:text-3xl text-bone-50">{profile.labRig.model}</h3>
            <p class="text-xs sm:text-sm text-bone-300 leading-relaxed mt-2 max-w-xl">
              When you don't have access to 80GB cloud GPUs or 64-core enterprise servers, you cannot afford wasteful abstractions. You are forced to understand how every single byte is allocated — writing zero-copy C, tuning quantization, and minimizing cache misses.
            </p>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 mt-5 font-micro text-xs">
              <div class="p-2.5 rounded-lg bg-ink-950 border border-bone-50/10">
                <span class="text-bone-500 text-[10px] block uppercase">CPU</span>
                <span class="text-bone-100 font-semibold block mt-0.5 truncate">i5-8350U (4C/8T)</span>
              </div>
              <div class="p-2.5 rounded-lg bg-ink-950 border border-bone-50/10">
                <span class="text-bone-500 text-[10px] block uppercase">RAM</span>
                <span class="text-bone-100 font-semibold block mt-0.5">8 GB DDR4</span>
              </div>
              <div class="p-2.5 rounded-lg bg-ink-950 border border-bone-50/10">
                <span class="text-bone-500 text-[10px] block uppercase">OS</span>
                <span class="text-bone-100 font-semibold block mt-0.5 truncate">EndeavourOS (Arch)</span>
              </div>
              <div class="p-2.5 rounded-lg bg-ink-950 border border-bone-50/10">
                <span class="text-bone-500 text-[10px] block uppercase">GPU</span>
                <span class="text-bone-100 font-semibold block mt-0.5 truncate">Intel UHD 620</span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-5 p-5 rounded-2xl bg-ink-950/80 border border-bone-50/10 space-y-3 font-micro text-xs">
            <span class="text-ember-400 uppercase tracking-widest font-semibold block text-[11px]">Strict Execution Baseline</span>
            <div class="flex items-center justify-between text-bone-300">
              <span>llama.cpp Q4_K_M GGUF</span>
              <span class="text-bone-500">Runs locally in ~4.2 GB RSS</span>
            </div>
            <div class="flex items-center justify-between text-bone-300">
              <span>QEMU Micro-VM Kernel Lab</span>
              <span class="text-bone-500">Boots in &lt;400ms with KASAN</span>
            </div>
            <div class="flex items-center justify-between text-bone-300">
              <span>Cloud Infrastructure Cost</span>
              <span class="text-moss-400 font-semibold">₹0 / month (100% Offline)</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         04 ACADEMIC TRAJECTORY & VERIFIED CREDENTIALS
         ═══════════════════════════════════════════════════════════════ -->
    <section class="mb-14 sm:mb-20" data-reveal>
      <SectionHeading index="04" eyebrow="Education & Credentials" title="Academic Standing &amp; <em>Verified Records.</em>">
        <p slot="lede" class="lede">
          Grounded institutional performance and verified industry certifications.
        </p>
      </SectionHeading>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mt-8">
        {profile.credentials.map((c) => (
          <div class="card card-glare p-6 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <span class="font-micro text-xs text-ember-400 font-bold">[{c.id}]</span>
                <span class="chip chip-brass !text-[9px]">✓ {c.status}</span>
              </div>
              <h4 class="display text-base text-bone-50 mb-1">{c.title}</h4>
              <p class="font-micro text-[10px] text-bone-500 uppercase tracking-wider mb-3">
                {c.issuer} · {c.date}
              </p>
              <p class="text-xs text-bone-400 leading-relaxed">{c.detail}</p>
            </div>
            <div class="mt-4 pt-3 border-t border-bone-50/10 font-micro text-[10px] text-bone-500">
              Verified Record
            </div>
          </div>
        ))}
      </div>
    </section>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       INTERACTIVE CAREER TRAJECTORY & TECHNICAL PROGRESSION
       ═══════════════════════════════════════════════════════════════ -->
  <ProgressionTimeline />
</BaseLayout>
