  <!-- Interactive Rig Terminal Tabs & Mobile Cyberdeck Controller Script -->
  <script is:inline>
    function setupAboutRigTerminal() {
      const tabBtns = document.querySelectorAll('.term-tab-btn');
      const panels = document.querySelectorAll('.term-panel');
      const promptUser = document.getElementById('terminal-prompt-user');

      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const cmd = btn.getAttribute('data-cmd');
          if (!cmd) return;

          tabBtns.forEach((b) => {
            b.classList.remove('active', 'text-ember-400', 'bg-bone-50/10', 'shadow-inner');
            b.classList.add('text-bone-400');
          });

          btn.classList.add('active', 'text-ember-400', 'bg-bone-50/10', 'shadow-inner');
          btn.classList.remove('text-bone-400');

          if (promptUser) {
            promptUser.textContent = `legion@elitebook-g5: ~ $ ${cmd === 'free' ? 'free -h' : cmd === 'uname' ? 'uname -a' : cmd}`;
          }

          panels.forEach((p) => {
            if (p.id === `term-panel-${cmd}`) {
              p.classList.remove('hidden');
            } else {
              p.classList.add('hidden');
            }
          });
        });
      });
    }

    function setupMobileAboutDeck() {
      const tabs = document.querySelectorAll('.m-about-tab-btn');
      const indicator = document.getElementById('m-about-active-tab-indicator');
      if (!tabs.length) return;

      const profileSec = document.getElementById('profile');
      const hardwareSec = document.getElementById('hardware');
      const credsSec = document.getElementById('creds');
      const ethosSec = document.getElementById('ethos');
      const trajSec = document.getElementById('trajectory');
      const careerPanel = document.getElementById('panel-career');
      const techPanel = document.getElementById('panel-tech');
      const tabBtnCareer = document.getElementById('tab-btn-career');
      const tabBtnTech = document.getElementById('tab-btn-tech');

      function isMobile() {
        return window.innerWidth < 768;
      }

      function applyDeckTab(tabId, shouldScroll) {
        if (!isMobile()) {
          [profileSec, hardwareSec, credsSec, ethosSec, trajSec].forEach((el) => {
            if (el) el.style.display = '';
          });
          return;
        }

        tabs.forEach((t) => {
          const match = t.getAttribute('data-about-tab') === tabId;
          if (match) {
            t.className = 'm-about-tab-btn active px-3 py-1.5 rounded-full font-micro text-[11px] font-semibold transition-all shrink-0 bg-bone-50/10 text-ember-400 border border-bone-50/20 shadow-inner cursor-pointer';
            t.setAttribute('aria-selected', 'true');
          } else {
            t.className = 'm-about-tab-btn px-3 py-1.5 rounded-full font-micro text-[11px] font-medium transition-all shrink-0 text-bone-400 hover:text-bone-50 bg-ink-900/60 border border-bone-50/10 cursor-pointer';
            t.setAttribute('aria-selected', 'false');
          }
        });

        const tabLabels = {
          philosophy: 'DECK 01 / 04 · PHILOSOPHY',
          methodology: 'DECK 02 / 04 · METHODOLOGY',
          trajectory: 'DECK 03 / 04 · TRAJECTORY',
          silicon: 'DECK 04 / 04 · SILICON SKILLS',
        };
        if (indicator && tabLabels[tabId]) {
          indicator.textContent = tabLabels[tabId];
        }

        if (tabId === 'philosophy') {
          if (profileSec) profileSec.style.display = 'block';
          if (hardwareSec) hardwareSec.style.display = 'block';
          if (credsSec) credsSec.style.display = 'none';
          if (ethosSec) ethosSec.style.display = 'none';
          if (trajSec) trajSec.style.display = 'none';
        } else if (tabId === 'methodology') {
          if (profileSec) profileSec.style.display = 'none';
          if (hardwareSec) hardwareSec.style.display = 'none';
          if (credsSec) credsSec.style.display = 'none';
          if (ethosSec) ethosSec.style.display = 'block';
          if (trajSec) trajSec.style.display = 'none';
        } else if (tabId === 'trajectory') {
          if (profileSec) profileSec.style.display = 'none';
          if (hardwareSec) hardwareSec.style.display = 'none';
          if (credsSec) credsSec.style.display = 'block';
          if (ethosSec) ethosSec.style.display = 'none';
          if (trajSec) trajSec.style.display = 'block';
          if (careerPanel) {
            careerPanel.classList.remove('hidden');
            careerPanel.style.opacity = '1';
          }
          if (techPanel) techPanel.classList.add('hidden');
          if (tabBtnCareer) tabBtnCareer.setAttribute('aria-selected', 'true');
          if (tabBtnTech) tabBtnTech.setAttribute('aria-selected', 'false');
        } else if (tabId === 'silicon') {
          if (profileSec) profileSec.style.display = 'none';
          if (hardwareSec) hardwareSec.style.display = 'none';
          if (credsSec) credsSec.style.display = 'none';
          if (ethosSec) ethosSec.style.display = 'none';
          if (trajSec) trajSec.style.display = 'block';
          if (careerPanel) careerPanel.classList.add('hidden');
          if (techPanel) {
            techPanel.classList.remove('hidden');
            techPanel.style.opacity = '1';
            const mDeck = document.getElementById('mobile-silicon-deck');
            if (mDeck) mDeck.classList.remove('hidden');
          }
          if (tabBtnCareer) tabBtnCareer.setAttribute('aria-selected', 'false');
          if (tabBtnTech) tabBtnTech.setAttribute('aria-selected', 'true');
        }

        if (shouldScroll) {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      }

      tabs.forEach((btn) => {
        btn.addEventListener('click', () => {
          const tabId = btn.getAttribute('data-about-tab');
          if (tabId) applyDeckTab(tabId, true);
        });
      });

      window.addEventListener('resize', () => {
        if (!isMobile()) {
          [profileSec, hardwareSec, credsSec, ethosSec, trajSec].forEach((el) => {
            if (el) el.style.display = '';
          });
        }
      });

      // Handle initial load or anchor hash
      const hash = window.location.hash.toLowerCase();
      let initTab = 'philosophy';
      if (hash.includes('ethos') || hash.includes('methodology')) {
        initTab = 'methodology';
      } else if (hash.includes('traj') || hash.includes('cred') || hash.includes('milestone')) {
        initTab = 'trajectory';
      } else if (hash.includes('silicon') || hash.includes('skill') || hash.includes('graph')) {
        initTab = 'silicon';
      }

      if (isMobile()) {
        applyDeckTab(initTab, false);
      }
    }

    function initAboutPage() {
      setupAboutRigTerminal();
      setupMobileAboutDeck();
    }

    document.addEventListener('astro:page-load', initAboutPage);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAboutPage);
    } else {
      initAboutPage();
    }
  </script>
</BaseLayout>

