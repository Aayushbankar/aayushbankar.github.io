---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { careerTimeline, technicalProgression } from '../data/timeline';
import { profile } from '../data/profile';

const architecturalDecisions = [
  {
    id: 'ADR-01',
    status: 'VERIFIED & IN PROD',
    badgeType: 'ember',
    title: 'Rust Zero-Copy over C++ for Kernel Log Ingestion',
    context: 'Evaluating high-throughput log ingestion architectures for the SIH 2026 detection engine.',
    decision: 'Selected Rust with Linux eBPF BPF_MAP_TYPE_RINGBUF. The borrow checker strictly guarantees thread-safe zero-copy memory slices across user/kernel boundaries without requiring runtime garbage collection pauses.',
    consequence: 'Achieved 13,247 EPS/core on standard 4-core hardware with zero memory safety panics across 1M synthetic tracepoints.',
  },
  {
    id: 'ADR-02',
    status: 'VERIFIED & IN PROD',
    badgeType: 'brass',
    title: 'Chained Local Offline Voice Stack over Cloud APIs',
    context: 'Building an interactive AI voice assistant for daily desktop automation without recurring API fees.',
    decision: 'Chained Silero VAD -> faster-whisper (CTranslate2) -> llama.cpp (Q4_K_M quantized GGUF) -> Piper TTS over local WebRTC data channels.',
    consequence: 'Total round-trip latency reduced to ~530ms running entirely on an 8GB laptop CPU with zero network dependency.',
  },
  {
    id: 'ADR-03',
    status: 'OPERATIONAL RULE',
    badgeType: 'moss',
    title: 'Everyday 8GB EndeavourOS Rig as Quality Floor',
    context: 'Avoiding reliance on expensive cloud workstations or oversized memory footprints.',
    decision: 'Enforced that all systems, micro-VMs, and models must boot and benchmark on an HP EliteBook 840 G5 with 8 GB DDR4 RAM running EndeavourOS Linux.',
    consequence: 'Forced deep understanding of SLUB memory allocators, cache-conscious data structures, and SIMD optimizations.',
  },
  {
    id: 'ADR-04',
    status: 'VERIFIED & IN PROD',
    badgeType: 'ember',
    title: 'Pratt Top-Down Parser over PEG Combinators for Sigma Rules',
    context: 'Parsing complex boolean and regex expressions across 84+ Sigma rules in real time.',
    decision: 'Implemented Pratt recursive-descent parsing with binding powers. Outperformed parser combinators in both speed and heap allocation overhead.',
    consequence: 'Reduced mean AST evaluation latency to 14.2µs per event, keeping CPU headroom clear for kernel packet polling.',
  },
];
---

<BaseLayout
  title="Engineering Trajectory & Decisions — Aayush Bankar"
  description="Chronological engineering trajectory, production deployments, research collaborations at CypherMatrix, and key architectural decision records."
>
  <div class="wrap-wide py-10 sm:py-16">
    <!-- Header -->
    <header class="mb-12 sm:mb-16 rise">
      <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
        <div class="flex items-center gap-2">
          <a href="/about" class="font-micro text-xs text-bone-500 hover:text-ember-400 transition-colors flex items-center gap-1.5">
            <span>←</span> Back to About
          </a>
          <span class="text-bone-700">/</span>
          <p class="eyebrow !mb-0">
            <span class="tick">TRJ–01</span>
            <span>Complete Engineering Roadmap</span>
          </p>
        </div>
        <span class="chip chip-brass">
          <span class="w-1.5 h-1.5 rounded-full bg-moss-500 animate-pulse"></span>
          Active Track · 2024—2026+
        </span>
      </div>

      <h1 class="display text-3xl sm:text-5xl lg:text-6xl text-bone-50 leading-[1.04]">
        The Engineering <em class="text-ember-400">Trajectory.</em>
      </h1>
      <p class="font-display italic text-lg sm:text-xl text-bone-200 mt-3 leading-snug">
        From first-principles web fundamentals to production campus infrastructure, kernel race conditions, and SIH 2026.
      </p>
      <p class="lede mt-3.5 max-w-2xl text-sm sm:text-base text-bone-400 leading-relaxed">
        A chronological record of milestones, research roles, and technical growth. Every milestone is tied to verifiable code, public repositories, or deployed production systems.
      </p>

      <!-- Quick Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mt-6 pt-6 border-t border-bone-50/10">
        <div class="p-3.5 rounded-xl bg-ink-950/80 border border-bone-50/10">
          <p class="font-display text-xl sm:text-2xl text-brass-400 font-semibold">{careerTimeline.length}</p>
          <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">Chronological Milestones</p>
        </div>
        <div class="p-3.5 rounded-xl bg-ink-950/80 border border-bone-50/10">
          <p class="font-display text-xl sm:text-2xl text-ember-400 font-semibold">500+</p>
          <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">Daily Campus Users</p>
        </div>
        <div class="p-3.5 rounded-xl bg-ink-950/80 border border-bone-50/10">
          <p class="font-display text-xl sm:text-2xl text-moss-500 font-semibold">4 Phases</p>
          <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">Technical Stack Depth</p>
        </div>
        <div class="p-3.5 rounded-xl bg-ink-950/80 border border-bone-50/10">
          <p class="font-display text-xl sm:text-2xl text-bone-200 font-semibold">{architecturalDecisions.length} Decisions</p>
          <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">Architectural Logs</p>
        </div>
      </div>
    </header>

    <!-- ═══════════════════════════════════════════════════════════════
         01 COMPLETE CAREER & EXPERIENCE TIMELINE
         ═══════════════════════════════════════════════════════════════ -->
    <section id="milestones" class="scroll-mt-24 mb-16 sm:mb-20" data-reveal>
      <div class="mb-10 pb-4 border-b border-bone-50/10 flex items-center justify-between">
        <div>
          <p class="eyebrow mb-1"><span class="tick">01</span><span>Chronological Milestones</span></p>
          <h2 class="font-display text-2xl sm:text-3xl text-bone-50">
            Career, Education &amp; Research Track
          </h2>
        </div>
        <span class="font-micro text-[11px] text-bone-500 hidden sm:inline">
          {careerTimeline.length} Empirical Milestones
        </span>
      </div>

      <div class="relative pl-6 sm:pl-10 before:absolute before:inset-0 before:left-3 sm:before:left-4 before:w-px before:bg-gradient-to-b before:from-ember-500 before:via-brass-500/50 before:to-bone-50/10 space-y-10">
        {careerTimeline.map((item, idx) => (
          <div class="relative group">
            <!-- Timeline Pin -->
            <span class="absolute -left-6 sm:-left-10 top-2 w-7 h-7 rounded-full bg-ink-950 border-2 border-ember-500/80 group-hover:border-ember-400 group-hover:scale-110 transition-all flex items-center justify-center font-micro text-[10px] text-ember-400 font-bold z-10 shadow-[0_0_12px_rgba(255,77,28,0.4)]">
              0{idx + 1}
            </span>

            <article class="card card-glare p-7 sm:p-9 hover:border-bone-50/20 transition-all">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
                <div class="flex flex-wrap items-center gap-2.5">
                  <span class="chip chip-ember !text-[10px] !py-0.5 !px-2.5">{item.year}</span>
                  <span class="font-micro text-xs text-bone-400">{item.period}</span>
                  <span class="text-bone-600">·</span>
                  <span class="font-micro text-xs font-semibold text-brass-400">{item.organization}</span>
                </div>
                <span class="chip !text-[10px] !py-0.5 !px-2 text-bone-300 font-medium">{item.role}</span>
              </div>

              <h3 class="display text-2xl text-bone-50 group-hover:text-ember-300 transition-colors">
                {item.title}
              </h3>

              <p class="text-sm sm:text-base text-bone-300 leading-relaxed mt-3 max-w-3xl">
                {item.summary}
              </p>

              <!-- Highlights Strip -->
              <div class="mt-5 pt-4 border-t border-bone-50/10 grid grid-cols-1 md:grid-cols-2 gap-2.5 text-xs text-bone-400 font-sans">
                {item.highlights.map((h) => (
                  <div class="flex items-start gap-2">
                    <span class="text-ember-400 font-bold shrink-0">›</span>
                    <span class="leading-relaxed">{h}</span>
                  </div>
                ))}
              </div>

              <div class="flex flex-wrap gap-1.5 mt-5">
                {item.tags.map((t) => (
                  <span class="chip !text-[9px] !py-0.5 !px-2 bg-ink-950/80 border-bone-50/10 text-bone-400">{t}</span>
                ))}
              </div>
            </article>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         02 TECHNICAL EVOLUTION STACK ACROSS 4 PHASES
         ═══════════════════════════════════════════════════════════════ -->
    <section id="tech-evolution" class="scroll-mt-24 mb-16 sm:mb-20" data-reveal>
      <div class="mb-10 pb-4 border-b border-bone-50/10 flex items-center justify-between">
        <div>
          <p class="eyebrow mb-1"><span class="tick">02</span><span>Skill Depth</span></p>
          <h2 class="font-display text-2xl sm:text-3xl text-bone-50">
            Technical Evolution Stack (4 Progression Phases)
          </h2>
        </div>
        <span class="font-micro text-[11px] text-bone-500 hidden sm:inline">
          First Principles to Verifiable Silicon
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {technicalProgression.map((item) => (
          <article class="card card-glare p-7 sm:p-8 flex flex-col justify-between border-t-2 border-t-brass-500">
            <div>
              <div class="flex items-center justify-between gap-3 mb-4">
                <span class="font-micro text-xs font-bold text-ember-400 tracking-widest">PHASE {item.level}</span>
                <span class="chip chip-brass !text-[9px] !py-0.5 !px-2">VERIFIED MASTERY</span>
              </div>
              <h3 class="display text-xl sm:text-2xl text-bone-50 mb-2">{item.phase}</h3>
              <div class="p-3 rounded-xl bg-ink-950 border border-bone-50/10 mb-4">
                <p class="font-micro text-xs text-brass-400 leading-relaxed">{item.skills}</p>
              </div>
              <p class="text-xs sm:text-sm text-bone-300 leading-relaxed">{item.detail}</p>
            </div>
            <div class="mt-6 pt-4 border-t border-bone-50/10 font-micro text-[10px] text-bone-500 uppercase tracking-wider flex items-center justify-between">
              <span>Deterministic Reproduction</span>
              <span class="text-moss-400 font-semibold">✓ 100% Proven</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         03 ARCHITECTURAL DECISIONS & TECHNICAL TRADE-OFFS LOG
         ═══════════════════════════════════════════════════════════════ -->
    <section id="decisions" class="scroll-mt-24 mb-16" data-reveal>
      <div class="mb-10 pb-4 border-b border-bone-50/10 flex items-center justify-between">
        <div>
          <p class="eyebrow mb-1"><span class="tick">03</span><span>Engineering Rationale</span></p>
          <h2 class="font-display text-2xl sm:text-3xl text-bone-50">
            Architectural Decision Records (ADRs)
          </h2>
        </div>
        <span class="font-micro text-[11px] text-bone-500 hidden sm:inline">
          Trade-offs, Pivots &amp; Benchmarks
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {architecturalDecisions.map((adr) => (
          <article class="card card-glare p-7 sm:p-8 flex flex-col justify-between border-l-4 border-l-ember-500">
            <div>
              <div class="flex items-center justify-between mb-3">
                <span class="font-micro text-xs font-bold text-ember-400 tracking-wider">[{adr.id}]</span>
                <span class="chip chip-ember !text-[9px]">{adr.status}</span>
              </div>

              <h3 class="display text-xl text-bone-50 mb-2">{adr.title}</h3>
              <p class="font-micro text-[11px] text-bone-500 mb-3">{adr.context}</p>

              <div class="p-3.5 rounded-xl bg-ink-950 border border-bone-50/10 mb-3">
                <span class="font-micro text-[10px] uppercase tracking-wider text-brass-400 font-semibold block mb-1">Decision:</span>
                <p class="text-xs text-bone-300 leading-relaxed">{adr.decision}</p>
              </div>

              <div class="p-3.5 rounded-xl bg-ink-950/60 border border-bone-50/5">
                <span class="font-micro text-[10px] uppercase tracking-wider text-moss-400 font-semibold block mb-1">Empirical Consequence:</span>
                <p class="text-xs text-bone-400 leading-relaxed">{adr.consequence}</p>
              </div>
            </div>

            <div class="mt-6 pt-4 border-t border-bone-50/10 font-micro text-[10px] text-bone-500 flex items-center justify-between">
              <span>Verified on Physical Silicon</span>
              <span class="text-ember-400">● Documented</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Closing Callout -->
    <div class="mt-16 p-8 rounded-2xl bg-ink-900/60 border border-bone-50/10 flex flex-col sm:flex-row items-center justify-between gap-6" data-reveal>
      <div>
        <h3 class="display text-xl text-bone-50">Want to explore the source code behind these milestones?</h3>
        <p class="text-xs sm:text-sm text-bone-400 mt-1">
          Every system and research breakdown is documented with open repositories and reproduction harnesses.
        </p>
      </div>
      <div class="flex items-center gap-3 shrink-0">
        <a href="/systems" class="btn btn-primary !text-xs">Browse Systems →</a>
        <a href="/about" class="btn btn-ghost !text-xs">About Me ↗</a>
      </div>
    </div>
  </div>
</BaseLayout>
