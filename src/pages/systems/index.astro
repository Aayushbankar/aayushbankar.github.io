---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { allSystems } from '../../data/systems';

const flagships = allSystems.slice(0, 3);
const domains = [
  'All',
  'Systems & Low-Level',
  'Edge AI & Pipelines',
  'Quantitative Finance',
  'Security Intelligence',
  'Production & Platforms',
  'Creative Tech & WebGL',
];
---

<BaseLayout
  title="Systems & Technical Spec Sheets — Aayush Bankar"
  description="Hardware-verified systems architectures, high-throughput log engines, offline edge AI pipelines, and production tools across the spectrum."
>
  <div class="wrap-wide py-10 sm:py-16">
    <!-- Header -->
    <header class="mb-14 rise">
      <p class="eyebrow mb-3">
        <span class="tick">SYS–00</span>
        <span>Systems Architecture &amp; Empirical Telemetry</span>
      </p>
      <h1 class="display text-4xl sm:text-5xl lg:text-6xl text-bone-50 leading-[1.05]">
        Systems &amp; <em class="text-ember-400">Spec Sheets.</em>
      </h1>
      <p class="lede mt-4 max-w-2xl text-base text-bone-400 leading-relaxed">
        Production architectures, high-throughput Rust/eBPF pipelines, offline edge voice stacks,
        and zero-cost campus portals. Every performance metric is measured on real hardware.
      </p>

      <div class="flex flex-wrap items-center gap-4 sm:gap-6 mt-6 pt-6 border-t border-bone-50/10 font-micro text-xs">
        <div class="flex items-center gap-2">
          <span class="font-display italic text-lg text-brass-400 font-semibold">{allSystems.length}</span>
          <span class="text-bone-500 uppercase tracking-wider">Documented Systems</span>
        </div>
        <span class="text-bone-700">/</span>
        <div class="flex items-center gap-2">
          <span class="font-display italic text-lg text-ember-400 font-semibold">03</span>
          <span class="text-bone-500 uppercase tracking-wider">Flagship Pipelines</span>
        </div>
        <span class="text-bone-700">/</span>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-moss-500"></span>
          <span class="text-bone-400 uppercase tracking-wider">100% Measured Locally</span>
        </div>
      </div>
    </header>

    <!-- Domain Filter Navigation (Progressive Enhancement) -->
    <nav class="flex flex-wrap gap-2 mb-10 pb-4 border-b border-bone-50/10" aria-label="Filter systems by domain" id="domain-filter">
      {domains.map((d, i) => (
        <button
          type="button"
          data-filter-btn={d}
          class={`filter-btn px-3.5 py-1.5 rounded-full font-micro text-xs tracking-wider transition-all duration-200 cursor-pointer ${
            i === 0
              ? 'bg-bone-50 text-ink-950 font-semibold shadow-sm active'
              : 'bg-ink-850 text-bone-400 border border-bone-50/10 hover:border-bone-50/30 hover:text-bone-50'
          }`}
        >
          {d}
        </button>
      ))}
    </nav>

    <!-- Complete Systems Catalog Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="systems-grid">
      {allSystems.map((sys) => {
        const badgeClass =
          sys.badgeType === 'ember'
            ? 'stamp'
            : sys.badgeType === 'brass'
              ? 'stamp stamp-brass'
              : sys.badgeType === 'moss'
                ? 'chip !border-moss-500/50 !text-moss-400 !bg-moss-500/10'
                : 'chip';
        return (
          <article
            id={sys.id}
            class="system-card card card-glare p-6 sm:p-7 flex flex-col justify-between group scroll-mt-24"
            data-domain={sys.domain}
            data-reveal
          >
            <div>
              <!-- Top Row: Index & Status -->
              <div class="flex items-start justify-between gap-2 mb-4">
                <span class="card-index text-3xl">{sys.index}</span>
                <span class={badgeClass}>{sys.status}</span>
              </div>

              <!-- Visual Plate Preview -->
              <a href={`/systems/${sys.id}`} class="block mb-4 rounded-xl overflow-hidden bg-ink-950 border border-bone-50/10 p-2 shadow-inner group-hover:border-bone-50/20 transition-all">
                <img
                  src={sys.plateImage}
                  alt={`${sys.name} Visual Plate`}
                  class="w-full h-36 object-contain rounded transition-transform duration-500 group-hover:scale-[1.02]"
                  loading="lazy"
                />
              </a>

              <!-- Title & Category -->
              <h2 class="display text-xl text-bone-50 group-hover:text-ember-400 transition-colors leading-tight">
                <a href={`/systems/${sys.id}`}>{sys.name}</a>
              </h2>
              <p class="font-micro text-[10px] tracking-wider uppercase text-ember-400 font-semibold mt-1">
                {sys.category}
              </p>
              <p class="text-xs text-bone-400 leading-relaxed mt-2.5 line-clamp-3">
                {sys.description}
              </p>

              <!-- Benchmarks Strip (First 2) -->
              <div class="grid grid-cols-2 gap-2 mt-4 pt-4 border-t border-bone-50/10">
                {sys.benchmarks.slice(0, 2).map((b) => (
                  <div class="p-2.5 rounded bg-ink-950 border border-bone-50/10">
                    <p class="font-display text-base text-brass-400 font-semibold">{b.value}</p>
                    <p class="font-micro text-[9px] tracking-wider uppercase text-bone-500 mt-0.5 truncate">{b.label}</p>
                  </div>
                ))}
              </div>

              <!-- Tech Chips -->
              <div class="flex flex-wrap gap-1.5 mt-3">
                {sys.tech.slice(0, 3).map((t) => (
                  <span class="chip !text-[9px] !py-0.5 !px-2">{t}</span>
                ))}
              </div>
            </div>

            <!-- Bottom Action Row -->
            <div class="mt-6 pt-4 border-t border-bone-50/10 flex items-center justify-between font-micro text-xs">
              <a href={sys.repoUrl} target="_blank" rel="noopener noreferrer" class="text-bone-500 hover:text-ember-400 transition-colors">
                GitHub ↗
              </a>
              <a href={`/systems/${sys.id}`} class="btn btn-ghost !py-1.5 !px-3 !text-[10px]">
                Full Spec Sheet →
              </a>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Related CVE & Kernel Research Callout -->
    <div class="mt-16 card card-glare p-8 border-l-4 border-ember-500 flex flex-col md:flex-row md:items-center justify-between gap-6" data-reveal>
      <div>
        <div class="flex items-center gap-2 mb-2">
          <span class="stamp !text-[9px] !py-0.5 !px-2">KERNEL AUDITS</span>
          <span class="font-micro text-xs tracking-wider uppercase text-ember-400 font-semibold">Vulnerability Triage</span>
        </div>
        <h3 class="display text-xl sm:text-2xl text-bone-50 mb-2">
          Looking for Low-Level Exploit Chains &amp; CVE Notes?
        </h3>
        <p class="text-xs sm:text-sm text-bone-300 max-w-2xl leading-relaxed">
          Examine Bad Epoll (CVE-2026-46242) and Android Contacts SQLi (CVE-2026-28576) complete with GDB hardware watchpoint logs, ROP gadget chains, and verification registers.
        </p>
      </div>
      <div class="shrink-0">
        <a href="/research" class="btn btn-primary">
          Explore Research Notes →
        </a>
      </div>
    </div>
  </div>

  <!-- Domain Filtering Script (Progressive Enhancement) -->
  <script is:inline>
    (function () {
      function initDomainFilter() {
        const filterBtns = document.querySelectorAll('[data-filter-btn]');
        const systemCards = document.querySelectorAll('.system-card');

        if (!filterBtns.length || !systemCards.length) return;

        filterBtns.forEach((btn) => {
          btn.addEventListener('click', function () {
            const selected = this.getAttribute('data-filter-btn');

            filterBtns.forEach((b) => {
              b.classList.remove('bg-bone-50', 'text-ink-950', 'font-semibold', 'shadow-sm', 'active');
              b.classList.add('bg-ink-850', 'text-bone-400', 'border', 'border-bone-50/10');
            });
            this.classList.remove('bg-ink-850', 'text-bone-400', 'border-bone-50/10');
            this.classList.add('bg-bone-50', 'text-ink-950', 'font-semibold', 'shadow-sm', 'active');

            systemCards.forEach((card) => {
              const cardDomain = card.getAttribute('data-domain');
              if (selected === 'All' || cardDomain === selected) {
                card.style.display = 'flex';
              } else {
                card.style.display = 'none';
              }
            });
          });
        });
      }

      initDomainFilter();
      document.addEventListener('astro:after-swap', initDomainFilter);
    })();
  </script>
</BaseLayout>
