---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { allSystems } from '../../data/systems';

const inspectorSystems = [
  allSystems.find((s) => s.id === 'spectre-prism')!,
  allSystems.find((s) => s.id === 'wolvie')!,
  allSystems.find((s) => s.id === 'quantlab')!,
  allSystems.find((s) => s.id === 'privata')!,
  allSystems.find((s) => s.id === 'cve-aggregator')!,
].filter(Boolean);

const domains = [
  'All',
  'Systems & Low-Level',
  'Edge AI & Pipelines',
  'Quantitative Finance',
  'Security Intelligence',
  'Production & Platforms',
];
---

<BaseLayout
  title="Systems & Technical Spec Sheets — Aayush Bankar"
  description="Hardware-verified systems architectures, high-throughput log engines, offline edge AI pipelines, and production tools across the spectrum."
>
  <div class="wrap-wide pt-10 pb-28 sm:py-16">
    <!-- Header -->
    <header class="mb-12 rise">
      <p class="eyebrow mb-3">
        <span class="tick">SYS–00</span>
        <span>Systems Architecture &amp; Empirical Telemetry</span>
      </p>
      <h1 class="display text-4xl sm:text-5xl lg:text-6xl text-bone-50 leading-[1.05]">
        Systems &amp; <em class="text-ember-400">Spec Sheets.</em>
      </h1>
      <p class="lede mt-4 max-w-2xl text-base text-bone-400 leading-relaxed">
        Production architectures, high-throughput Rust/eBPF pipelines, offline edge voice stacks,
        and zero-cost campus portals. Every performance metric is measured on real hardware.
      </p>

      <div class="flex flex-wrap items-center gap-4 sm:gap-6 mt-6 pt-6 border-t border-bone-50/10 font-micro text-xs">
        <div class="flex items-center gap-2">
          <span class="font-display italic text-lg text-brass-400 font-semibold">{allSystems.length}</span>
          <span class="text-bone-500 uppercase tracking-wider">Documented Systems</span>
        </div>
        <span class="text-bone-700">/</span>
        <div class="flex items-center gap-2">
          <span class="font-display italic text-lg text-ember-400 font-semibold">03</span>
          <span class="text-bone-500 uppercase tracking-wider">Flagship Pipelines</span>
        </div>
        <span class="text-bone-700">/</span>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-moss-500"></span>
          <span class="text-bone-400 uppercase tracking-wider">100% Measured Locally</span>
        </div>
      </div>
    </header>

    <!-- ═══════════════════════════════════════════════════════════════
         INTERACTIVE ARCHITECTURAL TELEMETRY INSPECTOR
         ═══════════════════════════════════════════════════════════════ -->
    <section id="telemetry" class="scroll-mt-24 mb-16 card card-glare p-6 sm:p-8 bg-ink-900/80 border border-bone-50/15" data-reveal>
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-6 border-b border-bone-50/10">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="w-2 h-2 rounded-full bg-ember-500 animate-pulse"></span>
            <span class="font-micro text-xs text-ember-400 uppercase tracking-widest font-semibold">Live Telemetry Inspector</span>
          </div>
          <h2 class="font-display text-2xl sm:text-3xl text-bone-50">
            Interactive Architecture &amp; <em class="text-ember-400">Benchmark Console</em>
          </h2>
          <p class="text-xs sm:text-sm text-bone-400 mt-1 max-w-2xl">
            Select an architecture to inspect its pipeline stages, local hardware benchmarks, and verification commands.
          </p>
        </div>

        <!-- System Selection Switcher Pills (Horizontal Swipeable Ribbon on Mobile) -->
        <div class="flex items-center gap-1.5 p-1 rounded-2xl bg-ink-950 border border-bone-50/10 font-micro text-xs shrink-0 overflow-x-auto no-scrollbar max-w-full" role="tablist">
          {inspectorSystems.map((sys, idx) => (
            <button
              type="button"
              class={`inspector-tab-btn px-3 py-1.5 rounded-xl font-semibold transition-all cursor-pointer whitespace-nowrap shrink-0 ${idx === 0 ? 'bg-bone-50/10 text-ember-400 shadow-inner' : 'text-bone-400 hover:text-bone-100'}`}
              data-target={`inspector-panel-${sys.id}`}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
            >
              <span class="text-bone-500 mr-1">{sys.index}</span> {sys.name}
            </button>
          ))}
        </div>
      </div>

      <!-- Inspector Panels -->
      <div class="mt-6">
        {inspectorSystems.map((sys, idx) => (
          <div
            id={`inspector-panel-${sys.id}`}
            class={`inspector-panel ${idx === 0 ? '' : 'hidden'} transition-opacity duration-300`}
            role="tabpanel"
          >
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
              <!-- Left: Visual Plate & Specs -->
              <div class="lg:col-span-5 flex flex-col justify-between h-full space-y-4">
                <div class="rounded-2xl overflow-hidden bg-ink-950 border border-bone-50/15 p-3 shadow-inner">
                  <div class="flex items-center justify-between mb-2">
                    <span class="font-micro text-xs text-ember-400 font-bold">{sys.index} · {sys.category}</span>
                    <span class="stamp !text-[9px] !py-0.5 !px-2">{sys.status}</span>
                  </div>
                  <img
                    src={sys.plateImage}
                    alt={`${sys.name} Blueprint`}
                    class="w-full h-44 sm:h-52 object-contain rounded transition-transform duration-500 hover:scale-[1.02]"
                    loading="lazy"
                  />
                </div>

                <div>
                  <h3 class="display text-2xl text-bone-50">{sys.name}</h3>
                  <p class="font-display italic text-sm text-bone-300 mt-0.5">{sys.tagline}</p>
                  <p class="text-xs text-bone-400 leading-relaxed mt-2.5">{sys.description}</p>
                </div>

                <div class="pt-3 border-t border-bone-50/10 flex items-center justify-between font-micro text-xs">
                  <a href={sys.repoUrl} target="_blank" rel="noopener noreferrer" class="text-bone-400 hover:text-ember-400 transition-colors">
                    GitHub Repo ↗
                  </a>
                  <a href={`/systems/${sys.id}`} class="btn btn-primary !py-1.5 !px-3.5 !text-xs">
                    Examine Full Spec Sheet →
                  </a>
                </div>
              </div>

              <!-- Right: Benchmarks & Execution Pipeline -->
              <div class="lg:col-span-7 space-y-5">
                <!-- Benchmarks Matrix -->
                <div class="p-4 rounded-2xl bg-ink-950 border border-bone-50/10">
                  <p class="font-micro text-xs text-brass-400 uppercase tracking-wider font-semibold mb-3">
                    Empirical Benchmarks (8GB HP EliteBook Test Rig)
                  </p>
                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                    {sys.benchmarks.map((b) => (
                      <div class="p-3 rounded-xl bg-ink-900 border border-bone-50/10">
                        <p class="font-display text-lg sm:text-xl text-ember-400 font-semibold">{b.value}</p>
                        <p class="font-micro text-[10px] text-bone-300 font-semibold uppercase tracking-wider mt-0.5">{b.label}</p>
                        <p class="text-[11px] text-bone-500 mt-1 leading-snug">{b.detail}</p>
                      </div>
                    ))}
                  </div>
                </div>

                <!-- Pipeline Stages or Architectural Planes -->
                {sys.pipeline && sys.pipeline.length > 0 ? (
                  <div class="p-4 rounded-2xl bg-ink-950 border border-bone-50/10">
                    <p class="font-micro text-xs text-bone-300 uppercase tracking-wider font-semibold mb-3">
                      End-to-End Pipeline Latency Trace
                    </p>
                    <div class="space-y-2">
                      {sys.pipeline.map((p, pIdx) => (
                        <div class="flex items-center justify-between p-2.5 rounded-lg bg-ink-900/60 border border-bone-50/5 text-xs">
                          <div class="flex items-center gap-3">
                            <span class="w-5 h-5 rounded-full bg-bone-50/10 flex items-center justify-center font-micro text-[10px] text-bone-300">{pIdx + 1}</span>
                            <span class="font-micro text-bone-200 font-semibold">{p.stage}</span>
                            <span class="text-bone-500 text-[11px]">({p.component})</span>
                          </div>
                          <span class="font-mono text-moss-400 font-semibold">{p.latency}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                ) : sys.planes && sys.planes.length > 0 ? (
                  <div class="p-4 rounded-2xl bg-ink-950 border border-bone-50/10">
                    <p class="font-micro text-xs text-bone-300 uppercase tracking-wider font-semibold mb-3">
                      5-Plane Subsystem Architecture
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                      {sys.planes.map((plane) => (
                        <div class="p-2.5 rounded-lg bg-ink-900/60 border border-bone-50/5 text-xs">
                          <span class="font-micro text-ember-400 font-bold block">{plane.id} // {plane.name}</span>
                          <span class="text-bone-400 text-[11px] mt-0.5 block">{plane.detail}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                ) : null}

                <!-- Terminal Verification Command Box -->
                <div class="p-4 rounded-2xl bg-ink-950 border border-bone-50/10 font-mono text-xs">
                  <div class="flex items-center justify-between mb-2">
                    <span class="font-micro text-[11px] text-bone-500 uppercase tracking-wider">Hermetic Reproduction Command</span>
                    <button
                      type="button"
                      class="copy-cmd-btn text-[11px] text-ember-400 hover:text-ember-300 flex items-center gap-1 cursor-pointer"
                      data-cmd={sys.verification}
                    >
                      <span class="copy-text">Copy Command</span>
                    </button>
                  </div>
                  <div class="p-2.5 rounded-lg bg-ink-900 border border-bone-50/10 text-bone-200 overflow-x-auto flex items-center gap-2">
                    <span class="text-ember-500 font-bold">$</span>
                    <code>{sys.verification}</code>
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         02 DOMAIN FILTERING & CLASSIFICATION
         ═══════════════════════════════════════════════════════════════ -->
    <section id="domains" class="scroll-mt-24 mb-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
        <div>
          <p class="eyebrow mb-1">
            <span class="tick">CAT–01</span>
            <span>Catalog &amp; Spec Sheets</span>
          </p>
          <h3 class="font-display text-2xl sm:text-3xl text-bone-50">
            All {allSystems.length} Documented Architectures
          </h3>
        </div>
      </div>

      <!-- Domain Filter Navigation (Touch-Friendly Horizontal Ribbon on Mobile) -->
      <nav class="flex items-center gap-1.5 pb-3 overflow-x-auto no-scrollbar -mx-2 px-2 border-b border-bone-50/10" aria-label="Filter systems by domain" id="domain-filter">
        {domains.map((d, i) => {
          const count = d === 'All' ? allSystems.length : allSystems.filter(s => s.domain === d).length;
          return (
            <button
              type="button"
              data-filter-btn={d}
              class={`filter-btn px-3.5 py-1.5 rounded-full font-micro text-xs tracking-wider transition-all duration-200 cursor-pointer whitespace-nowrap shrink-0 flex items-center gap-1.5 ${
                i === 0
                  ? 'bg-bone-50 text-ink-950 font-semibold shadow-sm active'
                  : 'bg-ink-850 text-bone-400 border border-bone-50/10 hover:border-bone-50/30 hover:text-bone-50'
              }`}
            >
              <span>{d}</span>
              <span class={`text-[10px] ${i === 0 ? 'text-ink-700' : 'text-bone-500'}`}>({count})</span>
            </button>
          );
        })}
      </nav>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         03 COMPLETE SYSTEMS CATALOG GRID
         ═══════════════════════════════════════════════════════════════ -->
    <section id="catalog" class="scroll-mt-24 mb-16">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="systems-grid">
      {allSystems.map((sys) => {
        const badgeClass =
          sys.badgeType === 'ember'
            ? 'stamp'
            : sys.badgeType === 'brass'
              ? 'stamp stamp-brass'
              : sys.badgeType === 'moss'
                ? 'chip !border-moss-500/50 !text-moss-400 !bg-moss-500/10'
                : 'chip';
        return (
          <article
            id={sys.id}
            class="system-card card card-glare p-5 sm:p-7 flex flex-col justify-between group scroll-mt-24"
            data-domain={sys.domain}
            data-reveal
          >
            <div>
              <!-- Top Row: Index & Status -->
              <div class="flex items-start justify-between gap-2 mb-3.5">
                <span class="card-index text-2xl sm:text-3xl font-mono text-bone-400">{sys.index}</span>
                <span class={badgeClass}>{sys.status}</span>
              </div>

              <!-- Visual Plate Preview -->
              <a href={`/systems/${sys.id}`} class="block mb-4 rounded-xl overflow-hidden bg-ink-950 border border-bone-50/10 p-2 shadow-inner group-hover:border-bone-50/20 transition-all">
                <img
                  src={sys.plateImage}
                  alt={`${sys.name} Visual Plate`}
                  class="w-full h-36 object-contain rounded transition-transform duration-500 group-hover:scale-[1.02]"
                  loading="lazy"
                />
              </a>

              <!-- Title & Category -->
              <h2 class="display text-xl text-bone-50 group-hover:text-ember-400 transition-colors leading-tight">
                <a href={`/systems/${sys.id}`}>{sys.name}</a>
              </h2>
              <p class="font-micro text-[10px] tracking-wider uppercase text-ember-400 font-semibold mt-1">
                {sys.category}
              </p>
              <p class="text-xs text-bone-400 leading-relaxed mt-2.5 line-clamp-3">
                {sys.description}
              </p>

              <!-- Dedicated Silicon Tooling & Architecture Chips -->
              <div class="mt-3.5">
                <span class="font-micro text-[9px] uppercase tracking-wider text-bone-500 block mb-1 font-semibold">
                  Silicon Stack &amp; Tooling:
                </span>
                <div class="flex flex-wrap gap-1">
                  {sys.tech.map((t) => (
                    <span class="chip chip-brass !text-[9.5px] !py-0.5 !px-2 font-mono font-medium">
                      #{t}
                    </span>
                  ))}
                </div>
              </div>

              <!-- Empirical Hardware Benchmarks Strip -->
              <div class="grid grid-cols-2 gap-2 mt-4 pt-3.5 border-t border-bone-50/10">
                {sys.benchmarks.slice(0, 2).map((b) => (
                  <div class="p-2.5 rounded-xl bg-ink-950 border border-bone-50/10">
                    <p class="font-display text-base text-brass-400 font-bold">{b.value}</p>
                    <p class="font-micro text-[9px] tracking-wider uppercase text-bone-400 font-semibold mt-0.5 truncate">{b.label}</p>
                    <p class="text-[10px] text-bone-500 mt-0.5 line-clamp-1">{b.detail}</p>
                  </div>
                ))}
              </div>
            </div>

            <!-- Bottom Action Row -->
            <div class="mt-6 pt-3.5 border-t border-bone-50/10 flex items-center justify-between gap-3 font-micro text-xs">
              <a href={sys.repoUrl} target="_blank" rel="noopener noreferrer" class="text-bone-400 hover:text-ember-400 transition-colors py-2 px-1">
                GitHub ↗
              </a>
              <a href={`/systems/${sys.id}`} class="btn btn-primary !py-2 !px-3.5 !text-[11px] font-semibold shadow-md">
                Full Spec Sheet →
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </section>

    <!-- ═══════════════════════════════════════════════════════════════
         04 HARDWARE VERIFICATION & EMPIRICAL BENCHMARKS
         ═══════════════════════════════════════════════════════════════ -->
    <section id="benchmarks" class="scroll-mt-24 mt-16 mb-12" data-reveal>
      <div class="mb-8">
        <p class="eyebrow mb-1">
          <span class="tick">BENCH–01</span>
          <span>Empirical Telemetry Matrix</span>
        </p>
        <h3 class="font-display text-2xl sm:text-3xl text-bone-50">
          Hardware Verification Matrix (8 GB HP EliteBook Test Rig)
        </h3>
        <p class="text-xs sm:text-sm text-bone-400 mt-2 max-w-2xl leading-relaxed">
          Zero simulated vanity numbers. Every benchmark below was executed directly on standard consumer silicon (Intel Core i5-8350U @ 1.70GHz, 8 GB DDR4 RAM, EndeavourOS Linux 6.12).
        </p>
      </div>

      <!-- SPECTRE-PRISM 5-Plane Live Pipeline Simulator -->
      <div class="card card-glare p-5 sm:p-7 bg-ink-950/80 border border-bone-50/15 mb-8" data-reveal>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-bone-50/10">
          <div>
            <div class="flex items-center gap-2 mb-1">
              <span class="w-2 h-2 rounded-full bg-ember-500 animate-pulse"></span>
              <span class="font-micro text-xs text-ember-400 uppercase tracking-widest font-semibold">Interactive Architecture Simulator</span>
            </div>
            <h4 class="font-display text-lg sm:text-xl text-bone-100">SPECTRE-PRISM: 5-Plane Pipeline &amp; Core Saturation Rig</h4>
          </div>
          <button
            type="button"
            id="sim-spike-btn"
            class="btn btn-ghost !py-1 !px-3 !text-xs !border-ember-500/40 text-ember-400 cursor-pointer self-start sm:self-auto"
          >
            Simulate 1M Event Spike ⚡
          </button>
        </div>

        <!-- 5 Planes Toggles (Touch Ribbon on Mobile) -->
        <div class="flex sm:grid sm:grid-cols-5 gap-2.5 my-5 overflow-x-auto no-scrollbar -mx-1 px-1 sm:mx-0 sm:px-0">
          <button type="button" class="sim-plane-btn active p-2.5 rounded-xl bg-ink-900 border border-ember-500/40 text-left transition-all cursor-pointer min-w-[130px] sm:min-w-0 shrink-0 sm:shrink" data-plane="0" data-cost="22">
            <span class="font-micro text-[10px] text-ember-400 font-bold block">P0: INGEST</span>
            <span class="text-xs text-bone-200 font-semibold block mt-0.5">eBPF XDP Ringbuf</span>
            <span class="font-micro text-[9px] text-bone-500 block mt-1">Zero-copy kernel poll</span>
          </button>
          <button type="button" class="sim-plane-btn active p-2.5 rounded-xl bg-ink-900 border border-ember-500/40 text-left transition-all cursor-pointer min-w-[130px] sm:min-w-0 shrink-0 sm:shrink" data-plane="1" data-cost="18">
            <span class="font-micro text-[10px] text-ember-400 font-bold block">P1: PARSE</span>
            <span class="text-xs text-bone-200 font-semibold block mt-0.5">SIMD AVX2 Parser</span>
            <span class="font-micro text-[9px] text-bone-500 block mt-1">Vectorized byte lexing</span>
          </button>
          <button type="button" class="sim-plane-btn active p-2.5 rounded-xl bg-ink-900 border border-ember-500/40 text-left transition-all cursor-pointer min-w-[130px] sm:min-w-0 shrink-0 sm:shrink" data-plane="2" data-cost="14">
            <span class="font-micro text-[10px] text-ember-400 font-bold block">P2: FILTER</span>
            <span class="text-xs text-bone-200 font-semibold block mt-0.5">Bloom &amp; Bitset</span>
            <span class="font-micro text-[9px] text-bone-500 block mt-1">Sigma rule pre-match</span>
          </button>
          <button type="button" class="sim-plane-btn active p-2.5 rounded-xl bg-ink-900 border border-ember-500/40 text-left transition-all cursor-pointer min-w-[130px] sm:min-w-0 shrink-0 sm:shrink" data-plane="3" data-cost="12">
            <span class="font-micro text-[10px] text-ember-400 font-bold block">P3: ROUTE</span>
            <span class="text-xs text-bone-200 font-semibold block mt-0.5">Lock-Free Channel</span>
            <span class="font-micro text-[9px] text-bone-500 block mt-1">Crossbeam mpsc pipe</span>
          </button>
          <button type="button" class="sim-plane-btn active p-2.5 rounded-xl bg-ink-900 border border-ember-500/40 text-left transition-all cursor-pointer min-w-[130px] sm:min-w-0 shrink-0 sm:shrink" data-plane="4" data-cost="8">
            <span class="font-micro text-[10px] text-ember-400 font-bold block">P4: COMMIT</span>
            <span class="text-xs text-bone-200 font-semibold block mt-0.5">Sequential WAL</span>
            <span class="font-micro text-[9px] text-bone-500 block mt-1">Zero fsync stall queue</span>
          </button>
        </div>

        <!-- Live Reactive Metric Readouts -->
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-4 border-t border-bone-50/10">
          <div class="p-3 rounded-lg bg-ink-900 border border-bone-50/10">
            <span class="font-micro text-[10px] uppercase text-bone-500 block">Throughput</span>
            <span class="font-display text-xl sm:text-2xl text-ember-400 font-bold block mt-0.5" id="sim-throughput">13,247 EPS</span>
            <span class="font-micro text-[9px] text-bone-500 block mt-0.5">Per CPU Core</span>
          </div>
          <div class="p-3 rounded-lg bg-ink-900 border border-bone-50/10">
            <span class="font-micro text-[10px] uppercase text-bone-500 block">End-to-End Latency</span>
            <span class="font-display text-xl sm:text-2xl text-brass-400 font-bold block mt-0.5" id="sim-latency">74.2 µs</span>
            <span class="font-micro text-[9px] text-bone-500 block mt-0.5">Mean per event</span>
          </div>
          <div class="p-3 rounded-lg bg-ink-900 border border-bone-50/10">
            <span class="font-micro text-[10px] uppercase text-bone-500 block">RAM Utilization</span>
            <span class="font-display text-xl sm:text-2xl text-bone-100 font-bold block mt-0.5" id="sim-ram">142 MB</span>
            <span class="font-micro text-[9px] text-bone-500 block mt-0.5">HP EliteBook 8GB rig</span>
          </div>
          <div class="p-3 rounded-lg bg-ink-900 border border-bone-50/10">
            <span class="font-micro text-[10px] uppercase text-bone-500 block">Core 0 Saturation</span>
            <span class="font-display text-xl sm:text-2xl text-moss-500 font-bold block mt-0.5" id="sim-cpu">28% CPU</span>
            <span class="font-micro text-[9px] text-bone-500 block mt-0.5">72% idle headroom</span>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
        <div class="card card-glare p-5 bg-ink-950/80 border border-bone-50/10">
          <div class="flex items-center justify-between mb-2">
            <span class="font-micro text-[11px] text-ember-400 font-bold">SPECTRE-PRISM</span>
            <span class="chip chip-ember !text-[9px]">SIH SCREENING</span>
          </div>
          <p class="font-display text-2xl sm:text-3xl text-bone-50 font-semibold">13,247</p>
          <p class="font-micro text-[10px] text-bone-400 uppercase tracking-wider mt-0.5">Events / Sec / Core</p>
          <p class="text-[11px] text-bone-500 mt-2">Zero-copy Linux eBPF ringbuf streaming with zero packet loss across 1M synthetic events.</p>
        </div>

        <div class="card card-glare p-5 bg-ink-950/80 border border-bone-50/10">
          <div class="flex items-center justify-between mb-2">
            <span class="font-micro text-[11px] text-brass-400 font-bold">Wolvie Assistant</span>
            <span class="chip chip-brass !text-[9px]">100% OFFLINE</span>
          </div>
          <p class="font-display text-2xl sm:text-3xl text-brass-400 font-semibold">530 ms</p>
