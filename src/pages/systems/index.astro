  <!-- Interactive Telemetry Console & Domain Filtering Script -->
  <script is:inline>
    function setupSystemsPage() {
      // 1. Inspector Tabs
      const tabBtns = document.querySelectorAll('.inspector-tab-btn');
      const panels = document.querySelectorAll('.inspector-panel');

      tabBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          const targetId = btn.getAttribute('data-target');
          if (!targetId) return;

          tabBtns.forEach((b) => {
            b.classList.remove('bg-bone-50/10', 'text-ember-400', 'shadow-inner');
            b.classList.add('text-bone-400');
            b.setAttribute('aria-selected', 'false');
          });

          btn.classList.add('bg-bone-50/10', 'text-ember-400', 'shadow-inner');
          btn.classList.remove('text-bone-400');
          btn.setAttribute('aria-selected', 'true');

          panels.forEach((p) => {
            if (p.id === targetId) {
              p.classList.remove('hidden');
              p.style.opacity = '1';
            } else {
              p.classList.add('hidden');
            }
          });
        });
      });

      // 2. Copy Command Buttons
      document.querySelectorAll('.copy-cmd-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const cmd = btn.getAttribute('data-cmd');
          if (!cmd) return;
          try {
            await navigator.clipboard.writeText(cmd);
            const label = btn.querySelector('.copy-text');
            if (label) {
              const original = label.textContent;
              label.textContent = 'Copied!';
              setTimeout(() => {
                label.textContent = original;
              }, 2000);
            }
          } catch (e) {
            console.error('Failed to copy', e);
          }
        });
      });

      // 3. Domain Filtering
      const filterBtns = document.querySelectorAll('[data-filter-btn]');
      const systemCards = document.querySelectorAll('.system-card');

      if (filterBtns.length && systemCards.length) {
        filterBtns.forEach((btn) => {
          btn.addEventListener('click', function () {
            const selected = this.getAttribute('data-filter-btn');

            filterBtns.forEach((b) => {
              b.classList.remove('bg-bone-50', 'text-ink-950', 'font-semibold', 'shadow-sm', 'active');
              b.classList.add('bg-ink-850', 'text-bone-400', 'border', 'border-bone-50/10');
            });
            this.classList.remove('bg-ink-850', 'text-bone-400', 'border-bone-50/10');
            this.classList.add('bg-bone-50', 'text-ink-950', 'font-semibold', 'shadow-sm', 'active');

            systemCards.forEach((card) => {
              const cardDomain = card.getAttribute('data-domain');
              if (selected === 'All' || cardDomain === selected) {
                card.style.display = 'flex';
              } else {
                card.style.display = 'none';
              }
            });
          });
        });
      }

      // 4. 5-Plane Live Architecture Simulator
      const planeBtns = document.querySelectorAll('.sim-plane-btn');
      const tpEl = document.getElementById('sim-throughput');
      const latEl = document.getElementById('sim-latency');
      const ramEl = document.getElementById('sim-ram');
      const cpuEl = document.getElementById('sim-cpu');
      const spikeBtn = document.getElementById('sim-spike-btn');

      function updateSimulation() {
        const activeCount = Array.from(planeBtns).filter((b) => b.classList.contains('active')).length;
        if (activeCount === 0) {
          if (tpEl) tpEl.textContent = '0 EPS';
          if (latEl) latEl.textContent = '0.0 µs';
          if (ramEl) ramEl.textContent = '12 MB';
          if (cpuEl) cpuEl.textContent = '1% CPU';
          return;
        }
        const eps = Math.round(activeCount * 2649.4);
        const lat = (activeCount * 14.84).toFixed(1);
        const ram = 28 + activeCount * 22.8;
        const cpu = Math.round(activeCount * 5.6);

        if (tpEl) tpEl.textContent = `${eps.toLocaleString()} EPS`;
        if (latEl) latEl.textContent = `${lat} µs`;
        if (ramEl) ramEl.textContent = `${Math.round(ram)} MB`;
        if (cpuEl) cpuEl.textContent = `${cpu}% CPU`;
      }

      planeBtns.forEach((btn) => {
        btn.addEventListener('click', () => {
          btn.classList.toggle('active');
          if (btn.classList.contains('active')) {
            btn.classList.add('border-ember-500/40');
            btn.classList.remove('opacity-40', 'border-bone-50/10');
          } else {
            btn.classList.remove('border-ember-500/40');
            btn.classList.add('opacity-40', 'border-bone-50/10');
          }
          updateSimulation();
        });
      });

      if (spikeBtn) {
        spikeBtn.addEventListener('click', () => {
          planeBtns.forEach((b) => {
            b.classList.add('active', 'border-ember-500/40');
            b.classList.remove('opacity-40', 'border-bone-50/10');
          });
          if (tpEl) tpEl.textContent = '24,180 EPS ⚡';
          if (latEl) latEl.textContent = '91.4 µs';
          if (ramEl) ramEl.textContent = '184 MB';
          if (cpuEl) cpuEl.textContent = '76% CPU';
          setTimeout(updateSimulation, 2200);
        });
      }
    }

    document.addEventListener('astro:page-load', setupSystemsPage);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupSystemsPage);
    } else {
      setupSystemsPage();
    }
  </script>
</BaseLayout>
