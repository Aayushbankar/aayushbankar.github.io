---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import { profile } from '../data/profile';
---

<BaseLayout
  title="Audited Asset & Skill Ledger — Aayush Bankar"
  description="Ground-truth inventory of verified credentials, research claims, kernel competencies, and laboratory infrastructure."
>
  <div class="wrap-wide py-10 sm:py-16">
    <header class="mb-14 rise">
      <p class="eyebrow mb-3">
        <span class="tick">LDG–00</span>
        <span>Audited Asset Inventory · Ground Truth</span>
      </p>
      <h1 class="display text-4xl sm:text-5xl lg:text-6xl text-bone-50 leading-[1.05]">
        Audited Asset &amp; <em class="text-ember-400">Skill Ledger.</em>
      </h1>
      <p class="lede mt-4 max-w-2xl text-base text-bone-400 leading-relaxed">
        A ground-truth inventory of validated credentials, systems competencies, and laboratory hardware.
        Every certification, experiment, and hardware configuration is empirically verified.
      </p>
    </header>

    <!-- Verified Credentials -->
    <section class="mb-14" data-reveal>
      <div class="flex items-center gap-3 mb-6 pb-3 border-b border-bone-50/10">
        <span class="font-display italic text-2xl text-bone-50/40">01</span>
        <h2 class="font-display text-xl sm:text-2xl text-bone-50">Verified Credentials &amp; Certifications</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        {profile.credentials.map((c) => (
          <div class="card card-glare p-6 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs mb-3">
                <span class="chip chip-brass !text-[9px] !py-0.5 !px-2">{c.status}</span>
                <span class="font-micro text-bone-500 text-[10px]">{c.id}</span>
              </div>
              <h3 class="font-display text-base text-bone-50 leading-snug mb-1">{c.title}</h3>
              <p class="font-micro text-xs text-ember-400 uppercase tracking-wider mb-3">{c.issuer}</p>
              <p class="text-xs text-bone-400 leading-relaxed mb-4">{c.detail}</p>
            </div>
            <div class="pt-3 border-t border-bone-50/10 font-micro text-[10px] text-bone-500 uppercase tracking-wider">
              {c.date} · Verified
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Competencies Matrix -->
    <section class="mb-14" data-reveal>
      <div class="flex items-center gap-3 mb-6 pb-3 border-b border-bone-50/10">
        <span class="font-display italic text-2xl text-bone-50/40">02</span>
        <h2 class="font-display text-xl sm:text-2xl text-bone-50">Technical Competency Matrix</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {profile.competencies.map((group) => (
          <div class="card p-6">
            <h3 class="font-micro text-xs tracking-wider uppercase text-ember-400 font-semibold mb-4">
              {group.category}
            </h3>
            <div class="flex flex-wrap gap-2">
              {group.skills.map((skill) => (
                <span class="chip text-xs">
                  {skill}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Academic & Lab Hardware Rig -->
    <section class="grid grid-cols-1 md:grid-cols-2 gap-6" data-reveal>
      <div class="card p-6 sm:p-7">
        <p class="eyebrow mb-3"><span class="tick">EDU</span><span>Academic Trajectory</span></p>
        <h3 class="display text-xl text-bone-50 mb-1">{profile.education.institution}</h3>
        <p class="font-micro text-xs text-brass-400 uppercase tracking-wider mb-4">{profile.education.degree}</p>

        <div class="p-4 rounded-lg bg-ink-950 border border-bone-50/10 space-y-2 font-micro text-xs text-bone-300">
          <div>&bull; Cumulative Performance Index: <span class="text-brass-400 font-semibold">{profile.education.cpi}</span></div>
          <div>&bull; {profile.education.role}</div>
          <div>&bull; {profile.education.nextStep}</div>
        </div>
      </div>

      <div class="card p-6 sm:p-7">
        <p class="eyebrow mb-3"><span class="tick">LAB</span><span>Local Laboratory Hardware</span></p>
        <h3 class="display text-xl text-bone-50 mb-1">{profile.labRig.model}</h3>
        <p class="font-micro text-xs text-ember-400 uppercase tracking-wider mb-4">Local Execution Baseline</p>

        <div class="p-4 rounded-lg bg-ink-950 border border-bone-50/10 space-y-2 font-micro text-xs text-bone-300">
          <div>&bull; CPU: {profile.labRig.cpu}</div>
          <div>&bull; RAM: {profile.labRig.ram}</div>
          <div>&bull; OS: {profile.labRig.os}</div>
          <div>&bull; Virtualization: {profile.labRig.virtualization}</div>
          <div>&bull; Inference: {profile.labRig.edgeAi}</div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
