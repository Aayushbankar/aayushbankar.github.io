---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('research');
const sortedPosts = posts.sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

const categories = [
  'All',
  'Kernel & Exploitation',
  'Android Internals',
  'Verifiable Systems',
  'AI Engineering',
];

// Interactive Testbench Reproduction Tracks
const reproTracks = [
  {
    id: 'bad-epoll',
    index: '01',
    cveId: 'CVE-2026-46242',
    name: 'Bad Epoll Linux Kernel UAF',
    target: 'Linux 6.12.67-arch1-1 (x86_64 SMP, RETPOLINE=y)',
    hardware: 'HP EliteBook 840 G5 · 8 GB RAM · QEMU Micro-VM',
    summary: 'Race condition in eventpoll.c epoll_ctl vs close(). Cross-cache slab reclaim in kmalloc-192, KASLR leak via /proc/self/fdinfo pos, ROP commit_creds privilege escalation.',
    cmd: 'gcc -O2 -fno-stack-protector -no-pie -o repro_bad_epoll exploit.c -lpthread && ./repro_bad_epoll',
    articleSlug: 'cve-2026-46242-bad-epoll',
    terminalLines: [
      '[+] Target Platform: Linux 6.12.67-arch1-1 x86_64 SMP',
      '[*] Security mitigations: CONFIG_SLAB_FREELIST_HARDENED=y, RETPOLINE=y',
      '[*] Compiling hermetic harness: gcc -O2 -fno-stack-protector -no-pie -o repro exploit.c -lpthread',
      '[+] Spraying kmalloc-192 slab cache with synthetic msg_msg headers (12,288 objects)...',
      '[*] Spawning 16 worker threads racing epoll_ctl(EPOLL_CTL_DEL) vs close()...',
      '[+] Race collision detected on iteration #4,182! UAF slot: 0xffff88810482b1c0',
      '[+] Reclaiming freed epitem slab via synthetic payload: OK',
      '[+] Probing /proc/self/fdinfo for kernel text address...',
      '[+] Leaked kernel .text base: 0xffffffff82600000 (KASLR defeated)',
      '[*] Constructing ROP stack pivot gadget: push rsi; pop rsp; ret',
      '[*] Payload: commit_creds(prepare_kernel_cred(0))',
      '[+] Shellcode returned 0. Elevating process credentials...',
      '[SUCCESS] Shell uid=0(root) gid=0(root) groups=0(root)',
      '[VERIFIED] Hermetic root exploit confirmed in local QEMU micro-VM in 84ms.',
    ],
  },
  {
    id: 'android-sqli',
    index: '02',
    cveId: 'CVE-2026-28576',
    name: 'Android ContactsProvider2 SQL Projection Injection',
    target: 'Android 11–15 DP (ARM64 GKI 6.1, Binder IPC)',
    hardware: 'HP EliteBook 840 G5 · adb emulator-5554 (Android 14)',
    summary: 'Arbitrary projection injection in ContactsProvider2.java bypassing targetSdk compatibility checks to establish zero-permission boolean oracle over Binder IPC.',
    cmd: 'adb shell am instrument -w -e class com.repro.ContactsOracleTest com.repro.test/androidx.test.runner.AndroidJUnitRunner',
    articleSlug: 'cve-2026-28576-android-contacts-sqli',
    terminalLines: [
      '[+] Target: Android 14 GKI 6.1 (arm64-v8a, targetSdkVersion=34)',
      '[*] Attacking process: com.thirdparty.unprivileged (ZERO PERMISSIONS GRANTED)',
      '[*] Query URI: content://com.android.contacts/contacts',
      '[+] Crafting projection bypass payload avoiding strict column projection regex...',
      '[*] Injected payload: (SELECT CASE WHEN (SELECT substr(data1,1,1) FROM data WHERE mimetype_id=5)=\'A\' THEN 1 ELSE 0 END)',
      '[+] Transmitting query across Binder IPC boundary...',
      '[*] Measuring Binder transaction IPC reply latency differential...',
      '[+] Timing delta detected: True = 142ms vs False = 12ms',
      '[+] Boolean Oracle verified: Bit 0 = 0, Bit 1 = 1, Char = \'A\'',
      '[+] Exfiltrated contact phone number in 28 Binder roundtrips without READ_CONTACTS permission!',
      '[SUCCESS] Vulnerability reproduced across 5 major Android OS releases.',
      '[DEFENSE] YARA rule and Suricata IPC rule published to verified disclosure ledger.',
    ],
  },
  {
    id: 'spectre-prism',
    index: '03',
    cveId: 'SIH 2026',
    name: 'SPECTRE-PRISM Ingestion & Pratt Parser',
    target: 'Rust 1.84 + Linux eBPF BPF_MAP_TYPE_RINGBUF',
    hardware: 'HP EliteBook 840 G5 (i5-8350U 4C/8T, 8 GB RAM)',
    summary: '5-plane event ingestion daemon ingesting kernel tracepoints via zero-copy ring buffers and evaluating Sigma detection rules with a custom Pratt parser.',
    cmd: 'cargo bench --bench simd_ingest -- --verbose',
    articleSlug: 'spectre-prism-log-engine',
    terminalLines: [
      '[+] Hardware Test Bench: HP EliteBook 840 G5 (i5-8350U @ 1.70GHz, 8 GB RAM)',
      '[*] Initializing 4 MB BPF_MAP_TYPE_RINGBUF zero-copy stream...',
      '[*] Loading eBPF program: tracepoint/syscalls/sys_enter_execve',
      '[+] Attaching probe to tracepoint fd... OK',
      '[*] Generating synthetic event stream: 1,000,000 tracepoint events...',
      '[+] Completed 1,000,000 events in 75.48s',
      '[+] Single-Core Throughput: 13,247 EPS / core (0 packet drops recorded)',
      '[*] Pratt Parser evaluating 84 Sigma detection rules concurrently...',
      '[+] Mean rule evaluation latency: 14.2µs (p99 = 840µs)',
      '[*] Appending audit ledger to RFC 6962 BLAKE3 Merkle Tree...',
      '[SUCCESS] Root tree hash 9a8c7b41e... signed with Ed25519 quorum key.',
    ],
  },
  {
    id: 'quantlab',
    index: '04',
    cveId: 'QUANT-SIM',
    name: 'QuantLab Indian Market Friction Model',
    target: 'Python 3.12 + NumPy Event Loop',
    hardware: 'HP EliteBook 840 G5 · 8 GB RAM · EndeavourOS',
    summary: 'Discrete-event backtesting engine modeling market impact (Almgren-Chriss), order execution friction, and statutory SEBI Indian taxes (STT 0.1%, GST 18%, Stamp Duty).',
    cmd: 'python run_simulation.py --strict --friction --universe NIFTY50',
    articleSlug: '',
    terminalLines: [
      '[+] Ingesting NIFTY 50 1-minute historical tick feed (2024–2026)...',
      '[*] Running baseline strategy without friction: Raw Sharpe = 1.42',
      '[*] Injecting Almgren-Chriss nonlinear market impact (gamma=0.314)...',
      '[*] Deducting SEBI statutory friction (STT 0.10%, GST 18%, Exchange fees 0.00345%)...',
      '[+] Slippage and friction impact: -42.8% on net P&L',
      '[*] Running Combinatorial Symmetric Cross-Validation (CSCV) with 16 sub-partitions...',
      '[+] Deflated Sharpe Ratio (DSR): 0.73',
      '[+] Out-of-sample performance decay: 12.4% (well within acceptable <15% threshold)',
      '[SUCCESS] Strategy verified resistant to overfitting under institutional friction.',
    ],
  },
];

// Group posts by year
const postsByYear = sortedPosts.reduce(
  (acc, post) => {
    const year = post.data.publishDate.getFullYear().toString();
    if (!acc[year]) acc[year] = [];
    acc[year].push(post);
    return acc;
  },
  {} as Record<string, typeof sortedPosts>
);

const years = Object.keys(postsByYear).sort((a, b) => Number(b) - Number(a));
---

<BaseLayout
  title="Field Notes & Breakdowns — Aayush Bankar"
  description="Working technical field notes, kernel vulnerability teardowns, and verifiable systems breakdowns with reproducible proof."
>
  <div class="wrap-wide py-10 sm:py-16">
    <!-- Header -->
    <header class="mb-12 rise">
      <p class="eyebrow mb-3">
        <span class="tick">FN–00</span>
        <span>Working Field Notes · Notes with Proof</span>
      </p>
      <h1 class="display text-4xl sm:text-5xl lg:text-6xl text-bone-50 leading-[1.05]">
        Field Notes &amp; <em class="text-ember-400">Teardowns.</em>
      </h1>
      <p class="lede mt-4 max-w-2xl text-base text-bone-400 leading-relaxed">
        Working technical notes and vulnerability teardowns written as I verify —
        <strong>not published academic papers</strong>, but empirical engineering logs.
        Every note links to code repositories, GDB trace logs, and verification ledgers.
      </p>

      <!-- Proof Counts Strip (Kogler style) -->
      <div class="flex flex-wrap items-center gap-3 sm:gap-6 mt-6 pt-6 border-t border-bone-50/10 font-micro text-xs">
        <div class="flex items-center gap-2">
          <span class="font-display italic text-lg text-brass-400 font-semibold">{sortedPosts.length}</span>
          <span class="text-bone-500 uppercase tracking-wider">Field Notes</span>
        </div>
        <span class="text-bone-700 hidden sm:inline">/</span>
        <div class="flex items-center gap-2">
          <span class="font-display italic text-lg text-ember-400 font-semibold">2</span>
          <span class="text-bone-500 uppercase tracking-wider">Active CVE Tracks</span>
        </div>
        <span class="text-bone-700 hidden sm:inline">/</span>
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-moss-500"></span>
          <span class="text-bone-400 uppercase tracking-wider">100% Locally Reproducible</span>
        </div>
      </div>
    </header>

    <!-- ═══════════════════════════════════════════════════════════════
         INTERACTIVE EXPLOIT REPRODUCTION & VERIFICATION TERMINAL
         ═══════════════════════════════════════════════════════════════ -->
    <section id="testbench" class="scroll-mt-24 mb-16 card card-glare p-6 sm:p-8 bg-ink-900/80 border border-bone-50/15" data-reveal>
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-6 border-b border-bone-50/10">
        <div>
          <div class="flex items-center gap-2 mb-1.5">
            <span class="w-2 h-2 rounded-full bg-ember-500 animate-pulse"></span>
            <span class="font-micro text-xs text-ember-400 uppercase tracking-widest font-semibold">Hermetic Testbench Terminal</span>
          </div>
          <h2 class="font-display text-2xl sm:text-3xl text-bone-50">
            Interactive Reproduction &amp; <em class="text-ember-400">Execution Simulator</em>
          </h2>
          <p class="text-xs sm:text-sm text-bone-400 mt-1 max-w-2xl">
            Select a research track to run the simulated hermetic reproduction harness and examine step-by-step terminal telemetry.
          </p>
        </div>

        <!-- Track Switcher Pills -->
        <div class="flex flex-wrap gap-1.5 p-1 rounded-2xl bg-ink-950 border border-bone-50/10 font-micro text-xs shrink-0" role="tablist">
          {reproTracks.map((track, idx) => (
            <button
              type="button"
              class={`repro-tab-btn px-3 py-1.5 rounded-xl font-semibold transition-all cursor-pointer ${idx === 0 ? 'bg-bone-50/10 text-ember-400 shadow-inner' : 'text-bone-400 hover:text-bone-100'}`}
              data-target={`repro-panel-${track.id}`}
              role="tab"
              aria-selected={idx === 0 ? 'true' : 'false'}
            >
              <span class="text-bone-500 mr-1">{track.index}</span> {track.cveId}
            </button>
          ))}
        </div>
      </div>

      <!-- Reproduction Panels -->
      <div class="mt-6">
        {reproTracks.map((track, idx) => (
          <div
            id={`repro-panel-${track.id}`}
            class={`repro-panel ${idx === 0 ? '' : 'hidden'} transition-opacity duration-300`}
            role="tabpanel"
          >
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
              <!-- Left: Target Spec & Verified Methodology -->
              <div class="lg:col-span-5 space-y-4">
                <div class="p-5 rounded-2xl bg-ink-950 border border-bone-50/10 space-y-3">
                  <div class="flex items-center justify-between">
                    <span class="stamp !text-[9px] !py-0.5 !px-2">{track.cveId}</span>
                    <span class="chip chip-brass !text-[9px]">100% LOCALLY VERIFIED</span>
                  </div>
                  <h3 class="display text-xl text-bone-50">{track.name}</h3>
                  <p class="font-micro text-xs text-ember-400 font-semibold">{track.target}</p>
                  <p class="text-xs text-bone-400 leading-relaxed">{track.summary}</p>
                  
                  <div class="pt-2 border-t border-bone-50/10 font-micro text-[11px] text-bone-500">
                    <span class="block text-bone-400">Tested Rig:</span>
                    <span>{track.hardware}</span>
                  </div>
                </div>

                <!-- Reproduction Command Box -->
                <div class="p-4 rounded-2xl bg-ink-950 border border-bone-50/10 font-mono text-xs">
                  <div class="flex items-center justify-between mb-2">
                    <span class="font-micro text-[11px] text-bone-500 uppercase tracking-wider">Reproduction Harness Command</span>
                    <button
                      type="button"
                      class="copy-repro-btn text-[11px] text-ember-400 hover:text-ember-300 flex items-center gap-1 cursor-pointer"
                      data-cmd={track.cmd}
                    >
                      <span class="copy-text">Copy Command</span>
                    </button>
                  </div>
                  <div class="p-2.5 rounded-lg bg-ink-900 border border-bone-50/10 text-bone-200 overflow-x-auto">
                    <code>$ {track.cmd}</code>
                  </div>
                </div>

                {track.articleSlug && (
                  <a href={`/research/${track.articleSlug}`} class="btn btn-ghost w-full text-center !py-2 !text-xs block">
                    Read Complete Field Note &amp; Teardown →
                  </a>
                )}
              </div>

              <!-- Right: Interactive Terminal Window -->
              <div class="lg:col-span-7">
                <div class="rounded-2xl overflow-hidden bg-ink-950 border border-bone-50/15 shadow-2xl font-mono text-xs">
                  <!-- Terminal Header Bar -->
                  <div class="bg-ink-900/90 px-4 py-2.5 border-b border-bone-50/10 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                      <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
                      <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
                      <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
                      <span class="ml-2 font-micro text-[11px] text-bone-400">repro@elitebook: ~/harness/{track.id}</span>
                    </div>

                    <button
                      type="button"
                      class="run-repro-btn chip chip-ember !text-[10px] !py-0.5 !px-2.5 cursor-pointer hover:scale-105 transition-transform flex items-center gap-1"
                      data-terminal-id={`terminal-out-${track.id}`}
                    >
                      <span>▶</span>
                      <span>Run Simulation</span>
                    </button>
                  </div>

                  <!-- Terminal Body Output -->
                  <div id={`terminal-out-${track.id}`} class="p-4 sm:p-5 h-72 sm:h-80 overflow-y-auto space-y-1.5 text-[11.5px] leading-relaxed bg-black/60">
                    <div class="text-bone-500 font-micro pb-2 border-b border-bone-50/10 flex items-center justify-between">
                      <span>[SESSION READY] Press "Run Simulation" or review empirical log trace below</span>
                      <span class="text-emerald-400 font-semibold">● ACTIVE</span>
                    </div>
                    {track.terminalLines.map((line) => {
                      const isSuccess = line.startsWith('[SUCCESS]') || line.startsWith('[VERIFIED]');
                      const isWarn = line.startsWith('[*]');
                      const isStep = line.startsWith('[+]');
                      return (
                        <p class={`${isSuccess ? 'text-emerald-400 font-semibold' : isWarn ? 'text-brass-300' : isStep ? 'text-ember-300' : 'text-bone-300'}`}>
                          {line}
                        </p>
                      );
                    })}
                  </div>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════════════════
         02 VULNERABILITY DISCLOSURES & FIELD NOTES INDEX
         ═══════════════════════════════════════════════════════════════ -->
    <section id="disclosures" class="scroll-mt-24 mb-16">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 mb-6">
        <div>
          <p class="eyebrow mb-1">
            <span class="tick">CAT–01</span>
            <span>Field Notes &amp; Ledger Index</span>
          </p>
          <h3 class="font-display text-2xl sm:text-3xl text-bone-50">
            All {sortedPosts.length} Documented Field Notes
          </h3>
        </div>
      </div>

    <!-- Interactive Category Filter (Works with and without JS) -->
    <nav class="flex flex-wrap gap-2 mb-10 pb-4 border-b border-bone-50/10" aria-label="Filter field notes by category" id="category-filter">
      {categories.map((c, i) => (
        <button
          type="button"
          data-filter-btn={c}
          class={`filter-btn px-3.5 py-1.5 rounded-full font-micro text-xs tracking-wider transition-all duration-200 cursor-pointer ${
            i === 0
              ? 'bg-bone-50 text-ink-950 font-semibold shadow-sm active'
              : 'bg-ink-850 text-bone-400 border border-bone-50/10 hover:border-bone-50/30 hover:text-bone-50'
          }`}
        >
          {c}
        </button>
      ))}
    </nav>

    <!-- Year-Grouped Timeline Entries (Lukas Maar style) -->
    <div class="space-y-14" id="posts-container">
      {years.map((year) => (
        <section class="space-y-6">
          <div class="flex items-center gap-4">
            <h2 class="font-display italic text-3xl sm:text-4xl text-bone-50/40 select-none">
              {year}
            </h2>
            <div class="h-px flex-1 bg-gradient-to-r from-bone-50/15 to-transparent"></div>
          </div>

          <div class="space-y-4">
            {postsByYear[year].map((post) => (
              <article
                class="post-card card card-glare p-6 sm:p-8 transition-all group"
                data-category={post.data.category}
              >
                <!-- Card Header: Meta Badges + Date -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4 text-xs">
                  <div class="flex flex-wrap items-center gap-2">
                    <span class="chip chip-brass text-[10px]">
                      {post.data.category}
                    </span>
                    {post.data.cveId && (
                      <span class="stamp !text-[9px] !py-0.5 !px-2">
                        {post.data.cveId}
                      </span>
                    )}
                    {post.data.featured && (
                      <span class="chip chip-ember text-[10px]">FEATURED</span>
                    )}
                  </div>
                  <time class="font-micro text-bone-500 text-[11px] tracking-wider" datetime={post.data.publishDate.toISOString()}>
                    {post.data.publishDate.toISOString().split('T')[0]}
                  </time>
                </div>

                <!-- Title -->
                <h3 class="display text-xl sm:text-2xl text-bone-50 group-hover:text-ember-400 transition-colors leading-snug mb-3">
                  <a href={`/research/${post.id}`}>
                    {post.data.title}
                  </a>
                </h3>

                <!-- 3-Line Honest Abstract -->
                <p class="text-sm text-bone-400 leading-relaxed max-w-3xl mb-6 line-clamp-3">
                  {post.data.description}
                </p>

                <!-- Footer: Tags & Artifact Links (Maar Style) -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-4 border-t border-bone-50/10 font-micro text-xs">
                  <div class="flex flex-wrap gap-2 text-[10px] text-bone-500">
                    {post.data.tags.map((tag: string) => (
                      <span class="px-2 py-0.5 rounded bg-ink-800/80 border border-bone-50/5">#{tag}</span>
                    ))}
                  </div>

                  <div class="flex items-center gap-4 shrink-0">
                    {post.data.verifiableLedgerUrl && (
                      <a
                        href={post.data.verifiableLedgerUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-brass-400 hover:text-bone-50 font-semibold transition-colors flex items-center gap-1"
                      >
                        [Ledger ↗]
                      </a>
                    )}
                    <a
                      href={`/research/${post.id}`}
                      class="text-ember-400 group-hover:text-ember-300 font-semibold transition-colors flex items-center gap-1"
                    >
                      Read Note &rarr;
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

    <!-- ═══════════════════════════════════════════════════════════════
         03 SPECTRE-PRISM 5-PLANE LOG ENGINE ARCHITECTURE
         ═══════════════════════════════════════════════════════════════ -->
    <section id="engine" class="scroll-mt-24 mb-16" data-reveal>
      <div class="mb-8">
        <p class="eyebrow mb-1">
          <span class="tick">ENG–01</span>
          <span>5-Plane High-Throughput Log Architecture</span>
        </p>
        <h3 class="font-display text-2xl sm:text-3xl text-bone-50">
          SPECTRE-PRISM: <em class="text-ember-400">SIH 2026 Detection Engine.</em>
        </h3>
        <p class="text-xs sm:text-sm text-bone-400 mt-2 max-w-2xl leading-relaxed">
          Designed for the Smart India Hackathon (SIH 2026) national screening. Ingests Linux kernel syscall tracepoints via zero-copy ring buffers, parses multi-line events with a custom Pratt parser, and maintains an RFC 6962 BLAKE3 Merkle tree audit trail.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-3.5 mb-8">
        <div class="card card-glare p-5 bg-ink-950/80 border border-bone-50/10 flex flex-col justify-between">
          <div>
            <span class="font-micro text-[10px] text-ember-400 font-bold uppercase tracking-wider block mb-1">Plane 01</span>
            <h4 class="font-display text-base text-bone-50 mb-1.5">Kernel Ingestion</h4>
            <p class="text-[11px] text-bone-400 leading-snug">eBPF <code class="text-ember-300">BPF_MAP_TYPE_RINGBUF</code> zero-copy tracepoint polling for <code class="text-bone-200">sys_enter_execve</code>.</p>
          </div>
          <div class="mt-3 pt-2.5 border-t border-bone-50/10 font-mono text-[10px] text-emerald-400 font-semibold">
            13,247 EPS / core
          </div>
        </div>

        <div class="card card-glare p-5 bg-ink-950/80 border border-bone-50/10 flex flex-col justify-between">
          <div>
            <span class="font-micro text-[10px] text-brass-400 font-bold uppercase tracking-wider block mb-1">Plane 02</span>
            <h4 class="font-display text-base text-bone-50 mb-1.5">SIMD Tokenizer</h4>
            <p class="text-[11px] text-bone-400 leading-snug">Zero-allocation byte-slice lexer with vectorized ASCII whitespace and quote delimiter skipping.</p>
          </div>
          <div class="mt-3 pt-2.5 border-t border-bone-50/10 font-mono text-[10px] text-brass-400 font-semibold">
            0 Heap Allocations
          </div>
        </div>

        <div class="card card-glare p-5 bg-ink-950/80 border border-bone-50/10 flex flex-col justify-between">
          <div>
            <span class="font-micro text-[10px] text-ember-400 font-bold uppercase tracking-wider block mb-1">Plane 03</span>
            <h4 class="font-display text-base text-bone-50 mb-1.5">Pratt Parser</h4>
            <p class="text-[11px] text-bone-400 leading-snug">Top-Down Operator Precedence AST evaluator matching 84 Sigma rule conditions concurrently.</p>
          </div>
          <div class="mt-3 pt-2.5 border-t border-bone-50/10 font-mono text-[10px] text-emerald-400 font-semibold">
            14.2 µs Mean Eval
          </div>
        </div>

        <div class="card card-glare p-5 bg-ink-950/80 border border-bone-50/10 flex flex-col justify-between">
          <div>
            <span class="font-micro text-[10px] text-moss-400 font-bold uppercase tracking-wider block mb-1">Plane 04</span>
            <h4 class="font-display text-base text-bone-50 mb-1.5">Merkle Audit</h4>
            <p class="text-[11px] text-bone-400 leading-snug">RFC 6962 BLAKE3 leaf node aggregation into tamper-evident log chunks signed via Ed25519.</p>
          </div>
          <div class="mt-3 pt-2.5 border-t border-bone-50/10 font-mono text-[10px] text-moss-400 font-semibold">
            Cryptographic Proof
          </div>
        </div>

        <div class="card card-glare p-5 bg-ink-950/80 border border-bone-50/10 flex flex-col justify-between">
          <div>
