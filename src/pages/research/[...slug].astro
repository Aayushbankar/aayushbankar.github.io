---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('research');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'research'>;
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={`${post.data.title} — Field Note by Aayush Bankar`}
  description={post.data.description}
>
  <div class="wrap-wide pt-10 pb-28 sm:py-16">
    <div class="max-w-4xl mx-auto">
      <!-- Back Link -->
      <a
        href="/research"
        class="font-micro text-xs tracking-[0.16em] uppercase text-bone-500 hover:text-ember-400 inline-flex items-center gap-1.5 transition-colors mb-8"
      >
        &larr; Back to Field Notes
      </a>

      <!-- Article Header -->
      <header id="overview" class="scroll-mt-24 mb-10 rise">
        <div class="flex flex-wrap items-center gap-2.5 mb-4">
          <span class="chip chip-brass text-[10px]">
            {post.data.category}
          </span>
          {post.data.cveId && (
            <span class="stamp !text-[9px] !py-0.5 !px-2">
              {post.data.cveId}
            </span>
          )}
          <span class="text-bone-600 font-micro text-xs">&bull;</span>
          <time class="font-micro text-bone-500 text-xs tracking-wider" datetime={post.data.publishDate.toISOString()}>
            {post.data.publishDate.toISOString().split('T')[0]}
          </time>
        </div>

        <h1 class="display text-3xl sm:text-4xl lg:text-5xl text-bone-50 leading-[1.08] mb-5">
          {post.data.title}
        </h1>

        <!-- Abstract / Description -->
        <div class="p-4 sm:p-5 rounded-xl bg-ink-900 border border-bone-50/10 border-l-4 border-l-ember-500">
          <p class="text-sm sm:text-base text-bone-300 leading-relaxed font-sans">
            {post.data.description}
          </p>
        </div>

        <!-- Verification Ledger Banner -->
        {post.data.verifiableLedgerUrl && (
          <div class="mt-5 p-4 rounded-xl bg-ink-900/80 border border-brass-500/30 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs font-micro">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-brass-400"></span>
              <span class="text-brass-400 font-semibold uppercase tracking-wider">VERIFICATION LEDGER ACTIVE</span>
            </div>
            <a
              href={post.data.verifiableLedgerUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn-ghost !py-1.5 !px-3 !text-[10px]"
            >
              Inspect Source Artifacts ↗
            </a>
          </div>
        )}
      </header>

      <!-- Paper Content (Rendered Markdown) -->
      <article id="analysis" class="scroll-mt-24 paper-body border-t border-bone-50/10 pt-10">
        <Content />
      </article>

      <!-- Post Footer -->
      <footer id="defense" class="scroll-mt-24 mt-16 pt-8 border-t border-bone-50/10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs font-micro text-bone-500">
        <div>
          AUTHOR: <span class="text-bone-50 font-semibold">{post.data.author}</span> · Student Builder &amp; Research Collaborator @ CypherMatrix
        </div>
        <div class="flex items-center gap-4">
          <a href="/research" class="text-ember-400 hover:text-bone-50 transition-colors">
            &larr; ALL FIELD NOTES
          </a>
          <span>·</span>
          <a href="#top" class="hover:text-bone-50 transition-colors">
            TOP &uarr;
          </a>
        </div>
      </footer>
    </div>
  </div>
</BaseLayout>
