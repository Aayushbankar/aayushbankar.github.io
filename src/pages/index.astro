---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('research');
const latestPosts = posts
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const flagships = [
  {
    num: '01',
    title: 'BAD EPOLL',
    cve: 'CVE-2026-46242',
    tag: 'KERNEL EXPLOIT POC',
    desc: 'Linux kernel epoll subsystem race condition and use-after-free. Cross-cache slab reclamation via msg_msg into kmalloc-192, and two-stage ROP pivot under CONFIG_RETPOLINE.',
    tech: ['C', 'Linux 6.12', 'SLUB', 'ROP', 'GDB/KASAN'],
    repo: 'https://github.com/Aayushbankar/bad_epoll_ab_tier2',
    accent: '#ef4444',
  },
  {
    num: '02',
    title: 'ANDROID SQLI',
    cve: 'CVE-2026-28576',
    tag: 'ANDROID FRAMEWORK AUDIT',
    desc: 'Arbitrary projection injection across Android UID sandboxes in ContactsProvider. Validated across Android 11 through Android 15 DP with complete empirical ledger.',
    tech: ['Java', 'Binder IPC', 'ContentProvider', 'SQLite', 'SELinux'],
    repo: 'https://github.com/Aayushbankar/cve-2026-28576',
    accent: '#f59e0b',
  },
  {
    num: '03',
    title: 'SPECTRE-PRISM',
    cve: 'SIH 2026 SCREENING',
    tag: 'SOVEREIGN ARCHITECTURE',
    desc: '5-plane sovereign log processing and verification engine. Zero-copy SIMD ingestion sustained at 13K events/s/core with RFC 6962 BLAKE3 Merkle transparency proofs.',
    tech: ['5-Plane Spec', 'SIMD', 'RFC 6962', 'BLAKE3', 'OCSF'],
    repo: 'https://github.com/Aayushbankar/spectre-prism',
    accent: '#00e5ff',
  },
  {
    num: '04',
    title: 'WOLVIE',
    cve: 'REAL-TIME LOCAL AUDIO',
    tag: 'APPLIED AI PIPELINE',
    desc: 'End-to-end local voice companion pipeline with WebRTC streaming call UI. Silero VAD + faster-whisper + llama.cpp + Piper TTS on consumer edge hardware with zero cloud calls.',
    tech: ['Python', 'WebRTC', 'Faster-Whisper', 'llama.cpp', 'Piper TTS'],
    repo: 'https://github.com/Aayushbankar/wolvie',
    accent: '#a855f7',
  },
];
---

<BaseLayout>
  <!-- Hero Terminal Section -->
  <section class="border border-[#1e293b] rounded-lg bg-[#040914] overflow-hidden mb-12 shadow-2xl">
    <!-- Window Bar -->
    <div class="bg-[#07111e] px-4 py-3 border-b border-[#1e293b] flex items-center justify-between text-xs">
      <div class="flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-[#ef4444] opacity-80 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-[#f59e0b] opacity-80 inline-block"></span>
        <span class="w-3 h-3 rounded-full bg-[#10b981] opacity-80 inline-block"></span>
        <span class="text-[#64748b] ml-2 hidden sm:inline">aayush@research-node: ~/sec/operations</span>
      </div>
      <div class="text-[#38bdf8] text-[11px] font-bold">
        STATUS: ACTIVE RESEARCH
      </div>
    </div>

    <!-- Terminal Inner Content -->
    <div class="p-6 sm:p-8 space-y-6">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="text-[#38bdf8] text-xs font-bold tracking-widest mb-1">&gt; WHOAMI --SYSTEM-TARGET</div>
          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-[#f8fafc]">
            AAYUSH <span class="text-[#00e5ff]">BANKAR</span>
          </h1>
          <p class="text-sm sm:text-base text-[#94a3b8] mt-2 font-mono max-w-2xl leading-relaxed">
            Systems Security Researcher &amp; AI-Augmented Engineer. Linux kernel &amp; Android vulnerability research, exploit primitive synthesis, and sovereign log architectures.
          </p>
        </div>

        <div class="flex flex-col gap-2 p-3 rounded bg-[#020611] border border-[#1e293b] text-xs font-mono min-w-[200px]">
          <div class="text-[#64748b] text-[10px] tracking-widest">AFFILIATION</div>
          <div class="text-[#00e5ff] font-bold">Cybersecurity Analyst</div>
          <div class="text-[#94a3b8]">@ CypherMatrix</div>
          <div class="pt-2 border-t border-[#1e293b] text-[#10b981] text-[11px]">
            &bull; SIH 2026 Screening Round
          </div>
        </div>
      </div>

      <!-- Quick Ticker -->
      <div class="p-3.5 rounded bg-[#07111e]/70 border border-[#1e293b] text-xs text-[#cbd5e1] flex items-center gap-3">
        <span class="w-2 h-2 rounded-full bg-[#10b981] animate-ping"></span>
        <span class="text-[#38bdf8] font-bold">CURRENT FOCUS:</span>
        <span class="text-[#94a3b8] truncate">
          CVE-2026-46242 Kernel Epoll UAF · CVE-2026-28576 Android SQLi · SPECTRE-PRISM 13K EPS Telemetry
        </span>
      </div>
    </div>
  </section>

  <!-- Section: Flagship Research Systems -->
  <section class="mb-14">
    <div class="flex items-center justify-between mb-6 border-b border-[#1e293b] pb-3">
      <div class="flex items-center gap-3">
        <span class="text-[#00e5ff] font-bold text-lg">&#9608;&#9617;</span>
        <h2 class="text-lg sm:text-xl font-bold tracking-wider text-[#f8fafc]">01 // FIELD RESEARCH &amp; FLAGSHIPS</h2>
      </div>
      <a href="/systems" class="text-xs text-[#38bdf8] hover:text-[#00e5ff] transition-colors">
        EXPLORE ALL SYSTEMS &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {flagships.map((f) => (
        <div class="p-6 rounded-lg bg-[#040914] border border-[#1e293b] hover:border-[#38bdf8]/60 transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between text-xs mb-3">
              <span class="px-2 py-0.5 rounded font-bold" style={{ backgroundColor: `${f.accent}20`, color: f.accent }}>
                {f.num}
              </span>
              <span class="text-[11px] text-[#64748b] tracking-wider">{f.tag}</span>
            </div>

            <h3 class="text-xl font-bold text-[#f8fafc] group-hover:text-[#00e5ff] transition-colors mb-1">
              {f.title}
            </h3>
            <div class="text-xs font-mono font-bold mb-3" style={{ color: f.accent }}>
              {f.cve}
            </div>

            <p class="text-xs text-[#94a3b8] leading-relaxed mb-6">
              {f.desc}
            </p>
          </div>

          <div>
            <div class="flex flex-wrap gap-1.5 mb-4">
              {f.tech.map((t) => (
                <span class="text-[10px] px-2 py-0.5 rounded bg-[#07111e] border border-[#1e293b] text-[#cbd5e1]">
                  {t}
                </span>
              ))}
            </div>

            <a
              href={f.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-xs text-[#38bdf8] hover:text-[#00e5ff] font-bold transition-colors"
            >
              INSPECT ARTIFACTS ↗
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Section: Latest Research Publications -->
  <section class="mb-14">
    <div class="flex items-center justify-between mb-6 border-b border-[#1e293b] pb-3">
      <div class="flex items-center gap-3">
        <span class="text-[#00e5ff] font-bold text-lg">&#9608;&#9617;</span>
        <h2 class="text-lg sm:text-xl font-bold tracking-wider text-[#f8fafc]">02 // RECENT RESEARCH PAPERS</h2>
      </div>
      <a href="/research" class="text-xs text-[#38bdf8] hover:text-[#00e5ff] transition-colors">
        ALL PUBLICATIONS &rarr;
      </a>
    </div>

    <div class="space-y-4">
      {latestPosts.map((post) => (
        <a
          href={`/research/${post.id}`}
          class="block p-5 rounded-lg bg-[#040914] border border-[#1e293b] hover:border-[#00e5ff]/60 hover:bg-[#07111e]/50 transition-all group"
        >
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-2 text-xs">
            <span class="px-2 py-0.5 rounded bg-[#0284c7]/15 text-[#38bdf8] w-fit font-bold">
              {post.data.category}
            </span>
            <time class="text-[#64748b]">
              {post.data.publishDate.toISOString().split('T')[0]}
            </time>
          </div>

          <h3 class="text-base sm:text-lg font-bold text-[#f8fafc] group-hover:text-[#00e5ff] transition-colors mb-2">
            {post.data.title}
          </h3>

          <p class="text-xs text-[#94a3b8] leading-relaxed line-clamp-2">
            {post.data.description}
          </p>

          <div class="flex flex-wrap gap-2 mt-4 text-[10px] text-[#64748b]">
            {post.data.tags.map((tag) => (
              <span>#{tag}</span>
            ))}
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Section: Verified Telemetry & Credentials -->
  <section class="p-6 rounded-lg bg-[#040914] border border-[#1e293b]">
    <div class="flex items-center gap-3 mb-6 border-b border-[#1e293b] pb-3">
      <span class="text-[#00e5ff] font-bold text-lg">&#9608;&#9617;</span>
      <h2 class="text-lg font-bold tracking-wider text-[#f8fafc]">03 // VERIFIED CREDENTIALS &amp; TELEMETRY</h2>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-6">
      <div class="p-4 rounded bg-[#020611] border border-[#1e293b]">
        <div class="text-[10px] text-[#64748b] tracking-widest">REPOSITORIES</div>
        <div class="text-2xl font-bold text-[#f8fafc] mt-1">38</div>
      </div>
      <div class="p-4 rounded bg-[#020611] border border-[#1e293b]">
        <div class="text-[10px] text-[#64748b] tracking-widest">CONTRIBUTIONS</div>
        <div class="text-2xl font-bold text-[#38bdf8] mt-1">366+</div>
      </div>
      <div class="p-4 rounded bg-[#020611] border border-[#1e293b]">
        <div class="text-[10px] text-[#64748b] tracking-widest">CVE TRACKS</div>
        <div class="text-2xl font-bold text-[#ef4444] mt-1">2</div>
      </div>
      <div class="p-4 rounded bg-[#020611] border border-[#1e293b]">
        <div class="text-[10px] text-[#64748b] tracking-widest">SIH STATUS</div>
        <div class="text-base font-bold text-[#f59e0b] mt-1">SCREENING</div>
      </div>
    </div>

    <div class="p-4 rounded bg-[#020611] border border-[#1e293b] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
      <div>
        <span class="text-[#10b981] font-bold">VERIFIED CERTIFICATIONS:</span>
        <span class="text-[#94a3b8] ml-2">Certified AppSec Practitioner v2 (CAP) &bull; Certified Network Security Practitioner (CNSP) &bull; IBM SkillsBuild (48/50)</span>
      </div>
      <a href="/ledger" class="px-3 py-1.5 rounded bg-[#07111e] border border-[#1e293b] text-[#00e5ff] hover:bg-[#00e5ff]/10 whitespace-nowrap">
        VIEW FULL LEDGER &rarr;
      </a>
    </div>
  </section>
</BaseLayout>
