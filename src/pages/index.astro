  <!-- Interactive Telemetry Console Script -->
  <script is:inline>
    function setupHomeConsole() {
      // 1. Exploit Tabs
      const tabs = document.querySelectorAll('.exploit-tab-btn');
      const panels = document.querySelectorAll('.exploit-panel');

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const target = tab.getAttribute('data-target');
          if (!target) return;

          tabs.forEach((t) => {
            t.classList.remove('active', 'text-ember-400', 'bg-bone-50/10', 'shadow-inner');
            t.classList.add('text-bone-400');
          });

          tab.classList.add('active', 'text-ember-400', 'bg-bone-50/10', 'shadow-inner');
          tab.classList.remove('text-bone-400');

          panels.forEach((p) => {
            if (p.id === target) {
              p.classList.remove('hidden');
            } else {
              p.classList.add('hidden');
            }
          });
        });
      });

      // 2. Interactive Hex Lines
      const hexLines = document.querySelectorAll('.hex-line');
      const fieldEl = document.getElementById('hex-inspect-field');
      const descEl = document.getElementById('hex-inspect-desc');

      hexLines.forEach((line) => {
        line.addEventListener('click', () => {
          hexLines.forEach((l) => l.classList.remove('bg-ember-500/10'));
          line.classList.add('bg-ember-500/10');
          const field = line.getAttribute('data-field');
          const desc = line.getAttribute('data-desc');
          if (fieldEl && field) fieldEl.textContent = field;
          if (descEl && desc) descEl.textContent = desc;
        });
      });
    }

    document.addEventListener('astro:page-load', setupHomeConsole);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupHomeConsole);
    } else {
      setupHomeConsole();
    }
  </script>
