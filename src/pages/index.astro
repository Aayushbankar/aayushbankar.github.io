---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import MonogramSeal from '../components/ui/MonogramSeal.astro';
import { getCollection } from 'astro:content';

import { profile } from '../data/profile';
import { findings } from '../data/findings';
import { allSystems } from '../data/systems';
import { collab } from '../data/collab';

const posts = await getCollection('research');
const latestPosts = posts
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);

const counts = [
  { k: String(allSystems.length), v: 'Systems shipped', href: '/systems' },
  { k: '02', v: 'Flagship CVE tracks', href: '#breakthroughs' },
  { k: '04', v: 'Field notes with proof', href: '/research' },
  { k: '100%', v: 'Locally reproducible', href: '/about' },
];

const badEpoll = findings[0];
const androidSqli = findings[1];
const flagships = allSystems.slice(0, 3);
const otherSystems = allSystems.slice(3);

const rail = [
  ['breakthroughs', '01', 'Bugs'],
  ['systems', '02', 'Systems'],
  ['notes', '03', 'Notes'],
  ['connect', '04', 'Connect'],
];

const heroName = ['AAYUSH', 'BANKAR'];
---

<BaseLayout
  title="Aayush Bankar — AI-Augmented Systems Builder · Empirical Security Researcher"
  description="18-year-old diploma student directing modern AI agent workflows to architect, scaffold, and empirically verify complex technical systems."
>

  <!-- ═══════════════════════════════════════════════════════════════
       HERO — Curated Editorial Dossier Visual Composition (Slide 00)
       ═══════════════════════════════════════════════════════════════ -->
  <header class="w-full min-h-0 lg:min-h-screen flex flex-col justify-center pt-5 pb-14 lg:pt-8 lg:pb-12 relative border-b border-bone-50/5" data-hero>
    <div class="wrap-wide">
      <!-- Status Bar -->
      <div class="flex flex-wrap items-center justify-between gap-3 mb-5 lg:mb-6 rise">
        <p class="eyebrow !mb-0 flex-1 min-w-56">
          <span class="tick">DS–01</span>
          <span>Curated Dossier · Gandhinagar, Gujarat · {profile.timezoneLabel}</span>
        </p>
        <div class="flex items-center gap-2">
          <span class="chip chip-brass">
            <span class="w-1.5 h-1.5 rounded-full bg-moss-500 animate-pulse"></span>
            Open to Scoped Research
          </span>
        </div>
      </div>

      <!-- Split Hero Grid -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-center">
        <!-- Left: Handcrafted Monogram Seal Visual Anchor -->
        <div class="lg:col-span-4 flex flex-col items-center justify-center text-center rise rise-1">
          <MonogramSeal class="w-32 h-32 sm:w-44 sm:h-44 lg:w-68 lg:h-68" />
          <div class="mt-4 space-y-1">
            <p class="font-micro text-[11px] tracking-[0.16em] uppercase text-bone-300 font-semibold">
              AI-Augmented Systems Builder · Empirical Security Researcher
            </p>
            <p class="font-micro text-[10px] tracking-[0.14em] uppercase text-bone-500">
              Gandhinagar, Gujarat · 23.2156° N, 72.6369° E
            </p>
          </div>
        </div>

        <!-- Right: Confident Editorial Typography with Kinetic Mask -->
        <div class="lg:col-span-8 flex flex-col justify-center rise rise-2">
          <h1 class="name-hero text-[clamp(2.3rem,6.5vw,7.2rem)] leading-[0.92]" aria-label="Aayush Bankar">
            {heroName.map((word, wi) => (
              <span class="line-mask block pb-0.5 sm:pb-1" aria-hidden="true">
                {word.split('').map((ch) => (
                  <span class={`hero-char ${wi === 1 ? 'text-stroke' : ''}`}>
                    {ch}
                  </span>
                ))}
              </span>
            ))}
          </h1>

          <p class="font-display italic text-[clamp(1.3rem,2.4vw,1.9rem)] text-bone-50 mt-4 leading-tight hero-fade">
            Directing AI agent workflows to architect systems, <em class="text-ember-400">proving every layer with code.</em>
          </p>

          <p class="lede mt-3 !max-w-2xl text-[14px] sm:text-base hero-fade">
            18-year-old diploma student from Gandhinagar, Gujarat, directing modern AI agent workflows to architect, scaffold,
            and empirically verify complex technical systems — grounded in OS fundamentals, QEMU/GDB testbenches, edge AI pipelines,
            and high-craft UI. Scaffolding at AI speed, verified down to silicon truth.
          </p>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-3 mt-6 hero-fade">
            <a href="/systems" class="btn btn-primary">Explore All {allSystems.length} Systems →</a>
            <a href="/research" class="btn btn-ghost">Vulnerability Field Notes (4) →</a>
            <a href="/research/ai-augmented-systems-engineering" class="btn btn-ghost !border-brass-500/40 !text-brass-300 hover:!text-bone-50">
              <span class="w-1.5 h-1.5 rounded-full bg-brass-400 animate-pulse"></span>
              Engineering Philosophy ↗
            </a>
            <a href="/about" class="btn btn-ghost">About &amp; How I Work ↗</a>
          </div>

          <!-- Credential Badges -->
          <div class="flex flex-wrap gap-2 mt-5 hero-fade">
            <span class="chip chip-brass">AI-Augmented Systems Builder</span>
            <span class="chip">Empirical Security Researcher</span>
            <span class="chip">Full-Stack &amp; Web</span>
            <span class="chip">Edge AI &amp; Audio</span>
            <span class="chip chip-ember">SIH 2026 · National Screening</span>
          </div>

          <!-- Mobile Cyberdeck Telemetry Bar (Exclusive Mobile Experience) -->
          <div class="lg:hidden mt-6 p-3.5 rounded-2xl bg-ink-900/90 border border-bone-50/15 shadow-xl font-micro text-[10px] space-y-2 hero-fade">
            <div class="flex items-center justify-between text-bone-400 pb-1.5 border-b border-bone-50/10">
              <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-moss-500 animate-pulse"></span>
                <span class="text-bone-200 font-bold uppercase tracking-wider">RIG GROUND TRUTH TELEMETRY</span>
              </div>
              <span class="chip chip-ember !text-[8.5px] !py-0.2 !px-1.5">SIH 2026 CANDIDATE</span>
            </div>
            <div class="grid grid-cols-2 gap-2 text-[9.5px]">
              <div class="p-2 rounded-xl bg-ink-950/80 border border-bone-50/5">
                <span class="text-bone-500 block uppercase tracking-wider">WORKSTATION</span>
                <span class="text-bone-200 font-semibold block mt-0.5 truncate">HP EliteBook 840 G5</span>
              </div>
              <div class="p-2 rounded-xl bg-ink-950/80 border border-bone-50/5">
                <span class="text-bone-500 block uppercase tracking-wider">OS &amp; MEMORY</span>
                <span class="text-bone-200 font-semibold block mt-0.5 truncate">EndeavourOS · 8GB DDR4</span>
              </div>
              <div class="p-2 rounded-xl bg-ink-950/80 border border-bone-50/5">
                <span class="text-bone-500 block uppercase tracking-wider">ACADEMICS</span>
                <span class="text-brass-400 font-semibold block mt-0.5">CPI 8.60 · Govt Poly</span>
              </div>
              <div class="p-2 rounded-xl bg-ink-950/80 border border-bone-50/5">
                <span class="text-bone-500 block uppercase tracking-wider">COLLAB STATUS</span>
                <span class="text-moss-400 font-semibold block mt-0.5">CypherMatrix R&amp;D</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 4-Box Proof Count Strip -->
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-px mt-8 rounded-2xl overflow-hidden border border-bone-50/10 bg-bone-50/10 rise rise-3">
        {counts.map((c) => (
          <a href={c.href} class="bg-ink-950 hover:bg-ink-800 transition-colors p-4 sm:p-6 group">
            <p class="font-display italic text-3xl sm:text-4xl text-bone-50 group-hover:text-ember-400 transition-colors" data-count>{c.k}</p>
            <p class="font-micro text-[10px] tracking-[0.18em] uppercase text-bone-500 mt-1.5">{c.v} ↗</p>
          </a>
        ))}
      </div>
    </div>
  </header>

  <!-- Focus Ticker -->
  <div class="w-full card overflow-hidden py-3 my-2 border-x-0 rounded-none" aria-label="Current research focus" data-reveal>
    <div class="ticker-track gap-10 font-micro text-[11px] tracking-[0.16em] uppercase text-bone-500">
      <span class="flex gap-10 pr-10">
        <span><span class="text-ember-400">●</span> CVE-2026-46242 · ARM64 GKI Verification (0/102k Hits)</span>
        <span><span class="text-ember-400">●</span> SPECTRE-PRISM · SIH National Screening (13.2k EPS)</span>
        <span><span class="text-brass-400">●</span> Wolvie · Sub-Second Offline Voice Pipeline (530ms)</span>
        <span><span class="text-moss-400">●</span> Campus Web Portal · 500+ Daily Active Users</span>
        <span><span class="text-brass-400">●</span> QuantLab · Indian Market Friction Simulation</span>
      </span>
      <span class="flex gap-10 pr-10" aria-hidden="true">
        <span><span class="text-ember-400">●</span> CVE-2026-46242 · ARM64 GKI Verification (0/102k Hits)</span>
        <span><span class="text-ember-400">●</span> SPECTRE-PRISM · SIH National Screening (13.2k EPS)</span>
        <span><span class="text-brass-400">●</span> Wolvie · Sub-Second Offline Voice Pipeline (530ms)</span>
        <span><span class="text-moss-400">●</span> Campus Web Portal · 500+ Daily Active Users</span>
        <span><span class="text-brass-400">●</span> QuantLab · Indian Market Friction Simulation</span>
      </span>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════
       01 NOTABLE BREAKTHROUGHS — Evidence-First Spotlight (Slide 01)
       ═══════════════════════════════════════════════════════════════ -->
  <section id="breakthroughs" class="w-full min-h-screen flex flex-col justify-center py-16 sm:py-24 relative border-b border-bone-50/5 scroll-mt-24">
    <div class="wrap-wide">
      <SectionHeading index="01" eyebrow="Vulnerability Research" title="Two bugs, <em>fully proven.</em>">
        <p slot="lede" class="lede">
          Curated empirical evidence tracks. Each finding features hardware test logs, mitigation bypass analysis, and open source reproduction harnesses.
        </p>
        <a slot="action" href="/research" class="link-sweep font-micro text-xs tracking-[0.16em] uppercase mt-4 inline-block">
          All 4 Field Notes ↗
        </a>
      </SectionHeading>

      <!-- 2-Column High-Impact Exhibition Cards -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8 mt-8">
        <!-- BAD EPOLL -->
        <article class="card card-glare p-6 sm:p-7 flex flex-col justify-between" data-reveal>
          <div>
            <div class="flex items-center justify-between gap-4 mb-3">
              <span class="card-index text-2xl sm:text-3xl">{badEpoll.index}</span>
              <div class="flex items-center gap-2">
                <span class="stamp">{badEpoll.stamp}</span>
                <span class="chip chip-brass hidden sm:inline-flex">Linux 6.12 &amp; Android GKI</span>
              </div>
            </div>

            <!-- Visual Exhibition Plate -->
            <div class="mb-4 rounded-xl overflow-hidden bg-ink-950 border border-bone-50/15 p-2 shadow-inner group">
              <img
                src="/figures/card-bad-epoll.svg"
                alt="CVE-2026-46242 Bad Epoll Kernel Exploit Architecture"
                class="w-full h-auto max-h-[170px] object-contain transition-transform duration-500 group-hover:scale-[1.01]"
                loading="lazy"
              />
            </div>

            <h3 class="display text-xl sm:text-2xl text-bone-50">{badEpoll.title}</h3>
            <p class="font-display italic text-xs sm:text-sm text-bone-300 mt-1">{badEpoll.tagline}</p>
            <p class="text-xs text-bone-400 leading-relaxed mt-2.5 line-clamp-3">{badEpoll.abstract}</p>

            <!-- Key Findings Metric Strip -->
            <div class="grid grid-cols-3 gap-2 mt-4 p-2.5 rounded-lg bg-ink-950 border border-bone-50/10 text-center">
              <div>
                <p class="font-display text-base sm:text-lg text-brass-400">Tier 1 Root</p>
                <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">x86_64 Verified</p>
              </div>
              <div>
                <p class="font-display text-base sm:text-lg text-ember-400">0 / 102k</p>
                <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">ARM64 GKI Hits</p>
              </div>
              <div>
                <p class="font-display text-base sm:text-lg text-bone-200">42 Claims</p>
                <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">Audited Ledger</p>
              </div>
            </div>
          </div>

          <div class="mt-5 pt-3.5 border-t border-bone-50/10 flex items-center justify-between font-micro text-xs">
            <a href={badEpoll.repoUrl} target="_blank" rel="noopener noreferrer" class="text-bone-500 hover:text-ember-400 transition-colors">
              GitHub Repo ↗
            </a>
            <a href={`/research/${badEpoll.articleSlug}`} class="btn btn-primary !py-1 !px-3 !text-[10px]">
              Examine Exploit Note →
            </a>
          </div>
        </article>

        <!-- ANDROID SQLI -->
        <article class="card card-glare p-6 sm:p-7 flex flex-col justify-between" data-reveal>
          <div>
            <div class="flex items-center justify-between gap-4 mb-3">
              <span class="card-index text-2xl sm:text-3xl">{androidSqli.index}</span>
              <div class="flex items-center gap-2">
                <span class="stamp">{androidSqli.stamp}</span>
                <span class="chip chip-brass hidden sm:inline-flex">Android 11–15 DP</span>
              </div>
            </div>

            <!-- Visual Exhibition Plate -->
            <div class="mb-4 rounded-xl overflow-hidden bg-ink-950 border border-bone-50/15 p-2 shadow-inner group">
              <img
                src="/figures/card-android-sqli.svg"
                alt="CVE-2026-28576 Android Contacts Injection Architecture"
                class="w-full h-auto max-h-[170px] object-contain transition-transform duration-500 group-hover:scale-[1.01]"
                loading="lazy"
              />
            </div>

            <h3 class="display text-xl sm:text-2xl text-bone-50">{androidSqli.title}</h3>
            <p class="font-display italic text-xs sm:text-sm text-bone-300 mt-1">{androidSqli.tagline}</p>
            <p class="text-xs text-bone-400 leading-relaxed mt-2.5 line-clamp-3">{androidSqli.abstract}</p>

            <!-- Key Findings Metric Strip -->
            <div class="grid grid-cols-3 gap-2 mt-4 p-2.5 rounded-lg bg-ink-950 border border-bone-50/10 text-center">
              <div>
                <p class="font-display text-base sm:text-lg text-brass-400">Zero Perms</p>
                <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">Binder IPC Oracle</p>
              </div>
              <div>
                <p class="font-display text-base sm:text-lg text-ember-400">5 Versions</p>
                <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">Android 11→15</p>
              </div>
              <div>
                <p class="font-display text-base sm:text-lg text-bone-200">2 Defenses</p>
                <p class="font-micro text-[9px] uppercase tracking-wider text-bone-500 mt-0.5">YARA + Suricata</p>
              </div>
            </div>
          </div>

          <div class="mt-5 pt-3.5 border-t border-bone-50/10 flex items-center justify-between font-micro text-xs">
            <a href={androidSqli.repoUrl} target="_blank" rel="noopener noreferrer" class="text-bone-500 hover:text-ember-400 transition-colors">
              GitHub Repo ↗
            </a>
            <a href={`/research/${androidSqli.articleSlug}`} class="btn btn-primary !py-1 !px-3 !text-[10px]">
              Examine Injection Note →
            </a>
          </div>
        </article>
      </div>

      <!-- Interactive Kernel Exploit & Syscall Telemetry Console -->
      <div class="mt-8 card card-glare p-5 sm:p-7 bg-ink-950/80 border border-bone-50/15" data-reveal>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-bone-50/10">
          <div class="flex items-center gap-2.5">
            <span class="w-2 h-2 rounded-full bg-ember-500 animate-pulse"></span>
            <span class="font-micro text-xs text-ember-400 uppercase tracking-widest font-semibold">Live Vulnerability Telemetry Console</span>
          </div>
          <div class="flex flex-wrap gap-1 p-1 rounded-xl bg-ink-900 border border-bone-50/10 font-micro text-xs" role="tablist">
            <button type="button" class="exploit-tab-btn active px-3 py-1.5 rounded-lg font-semibold cursor-pointer text-ember-400 bg-bone-50/10 shadow-inner" data-target="exploit-panel-badepoll">CVE-2026-46242 Hex Dump</button>
            <button type="button" class="exploit-tab-btn px-3 py-1.5 rounded-lg font-semibold cursor-pointer text-bone-400 hover:text-bone-100" data-target="exploit-panel-android">CVE-2026-28576 Binder Trace</button>
            <button type="button" class="exploit-tab-btn px-3 py-1.5 rounded-lg font-semibold cursor-pointer text-bone-400 hover:text-bone-100" data-target="exploit-panel-gki">ARM64 GKI Branch Audit</button>
          </div>
        </div>

        <!-- Panel 1: CVE-2026-46242 Hex Dump & Memory State -->
        <div id="exploit-panel-badepoll" class="exploit-panel mt-5">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
            <div class="lg:col-span-7 bg-ink-900/90 rounded-xl p-4 border border-bone-50/10 font-micro text-xs overflow-x-auto">
              <div class="flex items-center justify-between mb-3 pb-2 border-b border-bone-50/10 text-bone-500">
                <span>VIRT_ADDR: 0xffff8881023a4000 (SLUB: kmalloc-512)</span>
                <span class="text-ember-400">STATE: UAF_DIRTY</span>
              </div>
              <div class="space-y-1 leading-relaxed text-bone-300">
                <div class="flex gap-3 hover:bg-bone-50/5 p-1 rounded cursor-pointer hex-line" data-offset="0x0000" data-field="struct epitem -> rcu_head" data-desc="Freed struct epitem RCU list pointers awaiting reclaim cycle.">
                  <span class="text-bone-600 select-none">0x0000:</span>
                  <span class="text-ember-400">41 41 41 41 41 41 41 41</span>
                  <span>00 00 00 00 00 00 00 00</span>
                  <span class="text-bone-600 select-none">|AAAAAAAA........|</span>
                </div>
                <div class="flex gap-3 hover:bg-bone-50/5 p-1 rounded cursor-pointer hex-line bg-ember-500/10" data-offset="0x0010" data-field="sock -> sk_data_ready callback" data-desc="CORRUPT POINTER: Dereferenced upon incoming packet epoll wake, yielding control flow hijacking.">
                  <span class="text-bone-600 select-none">0x0010:</span>
                  <span class="text-ember-300 font-bold">ef be ad de 00 80 ff ff</span>
                  <span>01 00 00 00 00 00 00 00</span>
                  <span class="text-bone-600 select-none">|................|</span>
                </div>
                <div class="flex gap-3 hover:bg-bone-50/5 p-1 rounded cursor-pointer hex-line" data-offset="0x0020" data-field="epitem -> ffd.file descriptor" data-desc="Dangling struct file pointer pointing to closed socket handle.">
                  <span class="text-bone-600 select-none">0x0020:</span>
                  <span>20 40 3a 02 81 88 ff ff</span>
                  <span>03 00 00 00 00 00 00 00</span>
                  <span class="text-bone-600 select-none">| @:.............|</span>
                </div>
                <div class="flex gap-3 hover:bg-bone-50/5 p-1 rounded cursor-pointer hex-line" data-offset="0x0030" data-field="struct wait_queue_entry -> flags" data-desc="Custom WQ_FLAG_EXCLUSIVE bitmask triggering concurrent wake race.">
                  <span class="text-bone-600 select-none">0x0030:</span>
                  <span>08 00 00 00 00 00 00 00</span>
                  <span>70 41 3a 02 81 88 ff ff</span>
                  <span class="text-bone-600 select-none">|........pA:.....|</span>
                </div>
              </div>
            </div>
            <div class="lg:col-span-5 flex flex-col justify-between p-4 rounded-xl bg-ink-900 border border-bone-50/10">
              <div>
                <p class="font-micro text-[11px] uppercase tracking-wider text-bone-500 font-semibold mb-1">Interactive SLUB Inspector</p>
                <p class="font-display text-base text-bone-100" id="hex-inspect-field">sock -> sk_data_ready callback</p>
                <p class="text-xs text-bone-400 mt-2 leading-relaxed" id="hex-inspect-desc">
                  CORRUPT POINTER: Dereferenced upon incoming packet epoll wake, yielding control flow hijacking. Verified on x86_64 Linux 6.12.9 kernel test rig.
                </p>
              </div>
              <div class="mt-4 pt-3 border-t border-bone-50/10 flex items-center justify-between font-micro text-[11px]">
                <span class="text-brass-400">Click lines to inspect offsets</span>
                <a href={`/research/${badEpoll.articleSlug}`} class="text-ember-400 hover:underline">Full Exploit Note →</a>
              </div>
            </div>
          </div>
        </div>

        <!-- Panel 2: CVE-2026-28576 Binder Trace -->
        <div id="exploit-panel-android" class="exploit-panel hidden mt-5">
          <div class="p-4 rounded-xl bg-ink-900 border border-bone-50/10 font-micro text-xs space-y-3">
            <div class="flex items-center justify-between pb-2 border-b border-bone-50/10 text-bone-400">
              <span>BINDER IPC ORACLE (content://com.android.contacts/data)</span>
              <span class="text-moss-500">ZERO PERMISSIONS REQUIRED</span>
            </div>
            <div class="space-y-2 text-bone-300">
              <p><span class="text-ember-400">[STEP 01]</span> Unprivileged app sends Cursor query to ContactsProvider with projection parameter: <code class="text-bone-100">['(SELECT password FROM users WHERE uid=1000)']</code></p>
              <p><span class="text-ember-400">[STEP 02]</span> SQLiteQueryBuilder in Android 11 through 15 fails to sanitize subquery projection clause.</p>
              <p><span class="text-ember-400">[STEP 03]</span> Blind boolean side-channel leaks sensitive hashes without declaring <code class="text-brass-400">READ_CONTACTS</code> manifest permission.</p>
            </div>
            <div class="pt-3 border-t border-bone-50/10 flex justify-between items-center text-[11px]">
              <span class="text-bone-500">Defenses: Strict projection whitelist + YARA/Suricata rules provided.</span>
              <a href={`/research/${androidSqli.articleSlug}`} class="text-ember-400 hover:underline">Full Disclosure Paper →</a>
            </div>
          </div>
        </div>

        <!-- Panel 3: ARM64 GKI Audit -->
        <div id="exploit-panel-gki" class="exploit-panel hidden mt-5">
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 font-micro text-xs">
            <div class="p-3.5 rounded-xl bg-ink-900 border border-bone-50/10">
              <p class="text-ember-400 font-display text-2xl font-bold">0 / 102,400</p>
              <p class="text-bone-400 uppercase tracking-wider mt-1 font-semibold">ARM64 GKI Hits</p>
              <p class="text-bone-500 mt-1 text-[11px]">Across 102k synthetic tracepoint fuzz passes, Android GKI mitigation prevented UAF exploitation.</p>
            </div>
            <div class="p-3.5 rounded-xl bg-ink-900 border border-bone-50/10">
              <p class="text-brass-400 font-display text-2xl font-bold">x86_64 Root</p>
              <p class="text-bone-400 uppercase tracking-wider mt-1 font-semibold">Tier 1 Verification</p>
              <p class="text-bone-500 mt-1 text-[11px]">Reproduced hermetically under QEMU 6.12.9 with deterministic SLUB heap spray payload.</p>
            </div>
            <div class="p-3.5 rounded-xl bg-ink-900 border border-bone-50/10">
